*msetdselbtnon
	bno=stat
	if bno=0 {
		mode=canmode
		canmode=0
		listseln=motolistseln
	}
	if bno=1 {
		mode=returnmode
	}

return

*listselbtnon
	seselbno=0
	bno=stat
	if bno=0 {
		mode=canmode
		if canmode=1020:mode1020=0
		if canmode=1010:mode1010=0
		canmode=0
		listseln=motolistseln
	}
	if bno=1 {
		mode=returnmode
		if (returnmode=105) and (listreturnid=0):fr=listseln:motofr=fr:gosub *danload
		if (returnmode=110) and (listreturnid=0):warpfrima=listseln
		if (returnmode=110) and (listreturnid=1):maploopsetima=listseln
		if (returnmode=110) and (listreturnid=2):warpmukiima=listseln
		if (returnmode=110) and (listreturnid=3):bgmsetima=listseln
		if (returnmode=110) and (listreturnid=4):eveautoonoffset=listseln
		if (returnmode=150) and (listreturnid=0) {
			evemode=2
			beforeix=ix
			beforeiy=iy
			beforefr=fr
			fr=listseln
			motofr=fr
			gosub *danload
		}
		if (returnmode=150) and (listreturnid=1) {
			evemode=2
			beforeix=xput
			beforeiy=yput
			beforefr=fr
			fr=listseln
			motofr=fr
			gosub *danload
		}
		if returnmode=1010 {
			if mode1010=1 {
				if listreturnid=0:eveundertop=listseln
				if listreturnid=1:evechrmuki=listseln
				if listreturnid=2:evechridou=listseln
				if listreturnid=3:evechrashi=listseln
				if listreturnid=4:evechrmukuka=listseln
			}
			if mode1010=2 {
				evehassei(5)=listseln
			}
			if mode1010=3 {
				evesymbol=listseln
			}
			mode1010=0
		}
		if returnmode=1020 or returnmode=1022 or returnmode=1023 or returnmode=1025 {
			mode1020=0
			eveinpset(listreturnid)=listseln
			;アイテムの場合は特殊
			if returnmode=1022 {
				eveinpset(listreturnid)=0
				eveinpset(listreturnid)=itemsortid(listseln)
			}
			;敵の場合は特殊
			if returnmode=1025 {
				eveinpset(listreturnid)=0
				eveinpset(listreturnid)=monsortid(listseln)
			}
			;なし＋アイテムの場合は特殊
			if returnmode=1023 {
				eveinpset(listreturnid)=0
				if listseln>0:eveinpset(listreturnid)=itemsortid(listseln-1)+1
			}
			n1=int(eld(listreturnid,5))
			n2=eved(eveno,seleveline,int(eld(listreturnid,3)))
			n3=int(eld(listreturnid,4))
			nn=bbins(eveinpset(listreturnid),n1,n2,n3)
			eved(eveno,seleveline,int(eld(listreturnid,3)))=nn
			mode=1020
		}
		;出現する敵の設定
		if returnmode=1040 {
			nn=0
			if listseln>0:nn=monsortid(listseln-1)+1
			nn=bbins(nn,8,msetd(fr,msetdselno/4),(msetdselno\4)*8)
			msetd(fr,msetdselno/4)=nn
			;eveinpset(listreturnid)=monsortid(listseln)
			listseln=msetdselno
			
			;msetdselno=listseln
			;listseln=bbget(msetd(fr,msetdselno/4),(msetdselno\4)*8,8)
		}
		;アイテムモードで
		if returnmode=2100 {
			;特技を覚えるで特技を選択した場合は特殊
			if itemd(itemsel,3)=54 and mode2100=11 {
				listseln=spsortid(listseln)
			}
		}
		if returnmode=4100 {
			nnnnr=mode4100
			;同時出現モンスターの場合は特殊なセット
			if nnnnr=15 or nnnnr=16 or nnnnr=17 or nnnnr=19 {
				if listseln>0:listseln=monsortid(listseln-1)+1
			}
			;行動の場合は特殊なセット
			if nnnnr>49 and nnnnr<62 {
				if listseln>3:listseln=spsortid(listseln-4)+4
			}
		}
	}
return

