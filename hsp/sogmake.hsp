*monnmset

	
	for n,0,monmax,1
		nnn=monsortid(n)
		notesel monnmedit
		noteadd monnm(nnn,0),n,1
		notesel monnmedite
		noteadd monnm(nnn,1),n,1
	next

	evecomstr(5)=monnmedit
	evecomstr(56)="なし\n"+monnmedit

return

*monidset
		
	;for n,0,monmax,1
		;IDが０の場合はセットする
	;	if mond(n,59)=0 {
	;		for idnnn,1,monmax+1
	;			if monidonoff(idnnn)=0:mond(n,59)=idnnn:monidonoff(idnnn)=1:idnnn=monmax+10
	;		next
	;	}
	;	if mond(n,59)!0:monidonoff(idnnn)=1
	;	;並び順が０の場合はセットする
	;	if mond(n,58)=0:mond(n,58)=mond(n,59)*100
	;next
		
	dim monsortset,65536
	dim monsortid,monmax
	dim monsortid2,monmax;ID→並び順
	for n,0,monmax,1
		;IDが０の場合はセットする
		if mond(n,59)=0 {
			for idnnn,1,monmax+1
				if monidonoff(idnnn)=0:mond(n,59)=idnnn:monidonoff(idnnn)=1:idnnn=monmax+10
			next
		}
		if mond(n,59)!0:monidonoff(mond(n,59))=1
		;並び順が０の場合はセットする
		if mond(n,58)=0:mond(n,58)=mond(n,59)*100
		monsortset(mond(n,58))=mond(n,59)
	next
		
	monsortcnt=0
	for n,0,65536
		if monsortset(n)!0 {
			;並び順にIDをセットする
			monsortid(monsortcnt)=monsortset(n)-1
			;IDに並び順をセットする
			monsortid2(monsortset(n)-1)=monsortcnt
			monsortcnt++
		}
	next

		
	gosub *monnmset
	
return

*mongpdwb
	mongpdwupbcnt++
	monep(0)--
	if monep(0)<0:monep(0)=mgpnomax-1;mgpmax(monep(1))
	mond(monsel,0)=monep(0)
	gosub *mongpload
	if siz=-1 and mongpdwupbcnt<mgpnomax+1:goto *mongpdwb
	mongpdwupbcnt=0
return

*mongpupb
	mongpdwupbcnt++
	monep(0)++
	if monep(0)>mgpnomax-1:monep(0)=0
	mond(monsel,0)=monep(0)
	gosub *mongpload
	if siz=-1 and mongpdwupbcnt<mgpnomax+1:goto *mongpupb
	mongpdwupbcnt=0

return

*chrnmset

	chrnmedit=chrnm(0)
	for n,1,16,1
		chrnmedit=chrnmedit+"\n"+chrnm(n)
	next

	chrnmptedit=chrnm(0)+"(加)"
	for n,1,16,1
		chrnmptedit=chrnmptedit+"\n"+chrnm(n)+"(加)"
	next
	for n,0,16,1
		chrnmptedit=chrnmptedit+"\n"+chrnm(n)+"(外)"
	next

return

*returnb00
	mode=100
return

*returnb01
	
	l=0
	for n,0,evelimax,1
		if eved(eveno,n,0)=0:l=n:_break
	next

	if l!0 {
		eveloc(eveno)=bbins(fr,8,eveloc(eveno),0)
		eveloc(eveno)=bbins(ix,8,eveloc(eveno),8)
		eveloc(eveno)=bbins(iy,8,eveloc(eveno),16)
		eveloc(eveno)=bbins(l,8,eveloc(eveno),24)

		evepropaty(eveno,1)=bbins(eveundertop,2,evepropaty(eveno,1),28)
		evepropaty(eveno,2)=bbins(evehassei(0),1,evepropaty(eveno,2),0)
		evepropaty(eveno,2)=bbins(evehassei(1),1,evepropaty(eveno,2),1)
		evepropaty(eveno,2)=bbins(evehassei(2),1,evepropaty(eveno,2),2)
		evepropaty(eveno,2)=bbins(evehassei(3),1,evepropaty(eveno,2),3)
		evepropaty(eveno,2)=bbins(evehassei(4),1,evepropaty(eveno,2),12)
		evepropaty(eveno,2)=bbins(evehassei(5),8,evepropaty(eveno,2),4)
		evepropaty(eveno,2)=bbins(evechrno,9,evepropaty(eveno,2),13)
		evepropaty(eveno,2)=bbins(evechrmuki,4,evepropaty(eveno,2),22)
		evepropaty(eveno,2)=bbins(evechridou,4,evepropaty(eveno,2),26)
		evepropaty(eveno,2)=bbins(evechrashi,1,evepropaty(eveno,2),30)
		evepropaty(eveno,2)=bbins(evechrmukuka,1,evepropaty(eveno,2),31)
		evepropaty(eveno,3)=bbins(evehassei(6),1,evepropaty(eveno,3),0)
		evepropaty(eveno,3)=bbins(evehassei(7),1,evepropaty(eveno,3),1)
		evepropaty(eveno,3)=bbins(evehassei(8),1,evepropaty(eveno,3),2)
		evepropaty(eveno,3)=bbins(evehassei(9),1,evepropaty(eveno,3),3)
		evepropaty(eveno,3)=bbins(evesymbol,5,evepropaty(eveno,3),4)
		mapd(fr+1-dmindanf,ix-dmindanx,iy-dmindany,2)=5
		eveloctoid(fr-dmindanf,ix-dmindanx,iy-dmindany)=eveno+1
	} else {
		eveloc(eveno)=0
		evepropaty(eveno,0)=0
		evepropaty(eveno,1)=0
		evepropaty(eveno,2)=0
		evepropaty(eveno,3)=0
