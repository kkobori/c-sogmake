*btnev01_1

	bno=stat-1

	;seselbno=0
	;if bno=23 and mode=1010:seselbno=1
	
	mode=1020
	
	if bno>1 and bbget(eved(eveno,seleveline,0),0,5)>1 {
		if bbget(eved(eveno,seleveline,0),0,5)!bno {
			dialog "挿入しますか？",2
			nnn=stat
			if nnn=6 {
				nnnn=0
				ttttt=eved(eveno,evelimax-1,0)
				if bbget(ttttt,0,5)>1:nnnn=1
				if nnnn=1 {
					dialog "最終行のデータが消えます",3
					nnn=stat
					if nnn=6:nnnn=0
				}
				if nnnn=0 {
					for n,evelimax-1,seleveline,-1
						for nnnnn,0,6
							eved(eveno,n,nnnnn)=eved(eveno,n-1,nnnnn)
						next						
					next

				} else {
					mode=1010
				}
			} else {
				dialog "上書きしますか？",3
				nnn=stat
				if nnn=6 {
					gosub *mesdelete
				}
				if nnn=7 {
					mode=1010
				}
			}
		}
	}	

	if bno>1 and mode=1020 {
		if bbget(eved(eveno,seleveline,0),0,5)!bno {
			for n,0,6,1
				eved(eveno,seleveline,n)=0
			next
		}
		motoevedno=eved(eveno,seleveline,0)
		eved(eveno,seleveline,0)=bbins(bno,5,eved(eveno,seleveline,0),0)
	}

	if bno!0 and mode=1020 {
		for n,0,seleveline
			if bbget(eved(eveno,n,0),0,5)=0 {
				for nn,0,6,1
					eved(eveno,n,nn)=0
				next
				eved(eveno,n,0)=bbins(1,5,eved(eveno,n,0),0)
				eved(eveno,n,0)=bbins(1,3,eved(eveno,n,0),5)
			}
		next
	}

	if bno=1 and mode=1020 {
		dialog "この行を消去します",3
		nnn=stat
		if nnn=6 {
			gosub *mesdelete
			if seleveline<(evelimax-1) {
				for n,seleveline,evelimax-1,1
					for nn,0,6,1
						eved(eveno,n,nn)=eved(eveno,n+1,nn)
					next
				next
				for nn,0,6,1
					eved(eveno,evelimax-1,nn)=0		
				next
			} else {
				eved(eveno,seleveline,0)=bbins(bno,5,eved(eveno,seleveline,0),0)
			}
			mode=1010
		}
		if nnn=7:nn=1:mode=1010	
	}

	if bno=0 and mode=1020 {
		nn=0
		if seleveline<evelimax-1 {
			dialog "この行以降を消去します",3
			nnn=stat
			if nnn=7 {
				mode=1010
			}
			if nnn=6 {
				sub=seleveline
				for nnnnnn,seleveline,evelimax,1
					seleveline=nnnnnn
					gosub *mesdelete
					for n1,0,6,1
						eved(eveno,nnnnnn,n1)=0	
					next
				next
				seleveline=sub
				mode=1010
			}
		}
	}

	
	if mode=1020 {
		;objprm seleveline-eveline,evnm(bbget(eved(eveno,seleveline,0),0,5))
		eldstartline=0
		for n,0,4,1
			evsmuki(n)=1-evsmuki(n)
		next
	}
	
return

