*mode_100_main

;repeat

	gosub *putg
					
	if (mode=100) {

		if gameormake=1 :gosub *danmake
	

		;前へ進む
		if (btnpushon(0)=1 or btn(0)=1) and cmx!-1 {
			dpfr=2		;高低
			dpy=0		;奥行
			dpx=2	;左右
			gosub *nsweget
				if ins=-1 and iwe=0:iy++
				if ins=1 and iwe=0:iy--
				if ins=0 and iwe=-1:ix--
				if ins=0 and iwe=1:ix++
				gosub *mappidset
			;}
		}
		;後ろへ進む
		if (btnpushon(2)=1 or btn(2)=1) and cmx!-1 {
			dpfr=2		;高低
			dpy=0		;奥行
			dpx=2	;左右
			gosub *nsweget
			if ins=-1 and iwe=0:iy--
			if ins=1 and iwe=0:iy++
			if ins=0 and iwe=-1:ix++
			if ins=0 and iwe=1:ix--
			gosub *mappidset
		}
		;右を向く
		if (btnpushon(1)=1 or btn(1)=1) and cmx!-1 and ins=-1 and iwe=0:btnpushon(1)=0:btn(1)=0:ins=0:iwe=1:gosub *mappidset
		if (btnpushon(1)=1 or btn(1)=1) and cmx!-1 and ins=1 and iwe=0:btnpushon(1)=0:btn(1)=0:ins=0:iwe=-1:gosub *mappidset
		if (btnpushon(1)=1 or btn(1)=1) and cmx!-1 and ins=0 and iwe=-1:btnpushon(1)=0:btn(1)=0:ins=-1:iwe=0:gosub *mappidset
		if (btnpushon(1)=1 or btn(1)=1) and cmx!-1 and ins=0 and iwe=1:btnpushon(1)=0:btn(1)=0:ins=1:iwe=0:gosub *mappidset
		;左を向く
		if (btnpushon(3)=1 or btn(3)=1) and cmx!-1 and ins=-1 and iwe=0:btnpushon(3)=0:btn(3)=0:ins=0:iwe=-1:gosub *mappidset
		if (btnpushon(3)=1 or btn(3)=1) and cmx!-1 and ins=1 and iwe=0:btnpushon(3)=0:btn(3)=0:ins=0:iwe=1:gosub *mappidset
		if (btnpushon(3)=1 or btn(3)=1) and cmx!-1 and ins=0 and iwe=-1:btnpushon(3)=0:btn(3)=0:ins=1:iwe=0:gosub *mappidset
		if (btnpushon(3)=1 or btn(3)=1) and cmx!-1 and ins=0 and iwe=1:btnpushon(3)=0:btn(3)=0:ins=-1:iwe=0:gosub *mappidset
		;上へ上る
		if (btnpushon(5)=1 or btn(5)=1) and cmx!-1 {
			dpfr=2		;高低
			dpy=0		;奥行
			dpx=2	;左右
			gosub *nsweget
			fr--
			gosub *mappidset
		}
		;下へ下る
		if (btnpushon(4)=1 or btn(4)=1) and cmx!-1 {
			dpfr=2		;高低
			dpy=0		;奥行
			dpx=2	;左右
			gosub *nsweget
			fr++
			gosub *mappidset
		}
					
	}

		
return

