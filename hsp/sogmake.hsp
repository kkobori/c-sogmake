		bgmsetima=mapdata(3)
		hajichipima=mapdata(2)*(mapdata(2)<256)
		warpfrima=mapdata(5)
		warpixima=mapdata(6)
		warpiyima=mapdata(7)
		eveautoonoffset=mapdata(8)
		eveautoonno=mapdata(9)
		warpmukiima=mapdata(10)
		
		;mapmaxx=mapdata(0)
		;mapmaxy=mapdata(1)
		dim smapset,((mapmaxx+4)/4*(mapmaxy+1))+20
		dim mapset,(255+4)/4+4,(255+1)+16
		dim mapmonset,(255+16)+4,(255+1)+16,2;x,y,陸か海か
		;dim mapset,(mapmaxx+4)/4+4,(mapmaxy+1)+16

		bload folder+"mapdat/mapdat"+str(fr)+".dat",smapset

		for y,0,mapmaxy+1
			for x,0,(mapmaxx+4)/4
				mapset(x,y)=smapset(x+y*((mapmaxx+4)/4)+20)
			next
		next

		
		
		
		
		if canmode!1020 {
	
			exist folder+"mapdat/evedat"+str(fr)+".dat"
			filesize=strsize/4
	
			dim sdata,filesize
			dim eved,evemax,evelimax,6
			dim eveloc,evemax

			if strsize!-1 {
				bload folder+"mapdat/evedat"+str(fr)+".dat",sdata
	
				evdmax=sdata(0)
				even=0
				eli=0
				evenhead=2
				gyouhead=0
				yousoon=0
				for n,1,filesize,1
					if evenhead=2 {
						eveloc(even)=sdata(n)
						n++
						evepropaty(even,0)=sdata(n)
						n++
						evepropaty(even,1)=sdata(n)
						n++
						evepropaty(even,2)=sdata(n)
						evelin=bbget(eveloc(even),24,8)
						evenhead=0
						gyouhead=1
						if evelin=0 {
							evenhead=2
							gyouhead=0
							yousoon=0
							even++
						}
					}
					if gyouhead=2 {
						eved(even,eli,0)=sdata(n)
						evedlin=bbget(sdata(n),5,3)
						if evedlin>1 {
							yousoon=1
							gyouhead=0
						}
						if evedlin=1 {
							gyouhead=1
							eli++
							if evelin=eli {
								eli=0
								evenhead=1
								gyouhead=0
								even++
							}
						}
					}
					if yousoon>1 {
						eved(even,eli,yousoon-1)=sdata(n)
						if evedlin<yousoon+1 {
							yousoon=0
							gyouhead=1
							eli++
							if evelin=eli {
								eli=0
								evenhead=1
								even++
							}
						} else {
							yousoon++
						}
					}
		
					if evenhead=1:evenhead=2
					if gyouhead=1:gyouhead=2
					if yousoon=1:yousoon=2
		
				next

			}

		}

		
