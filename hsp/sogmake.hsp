*mongput

	if mode!1010 {
		color 0,0,0
		boxf 480-256,0,480,256
	}
		
	monpbaipxy=4
	if mode=1010:monpbaipxy=2
		
	;全体を表示
	for py,0,mongpymax
		for px,0,mongpxmax
				
			;1bitデータの場合
			if mgpbitmode=0 {
				color 255,255,255
				if mgpexy(px,py)=0:color 0,0,0
			}
			;2bitデータの場合
			if mgpbitmode=1 {
				color 0,0,0
				if mgpexy(px,py)=1:color 255,255,255
				if mgpexy(px,py)=2:color 224,224,224
				if mgpexy(px,py)=3:color 0,0,0
			}
			putxx=224+px*monpbaipxy+(64-mongpxmax)/2*monpbaipxy
			putyy=py*monpbaipxy+(monpud=0)*(64-mongpymax)*monpbaipxy+(monpud=1)*(64-mongpymax)*(1+(monpbaipxy=4))
		
			if mode=1010 {
				putxx=putxx-224
				putyy=putyy+336
			}

			boxf putxx,putyy,putxx+(monpbaipxy-1),putyy+(monpbaipxy-1)

		next
	next

/*
	for y,0,imgy/2
		for x,0,imgx/2
			pos x*8+220,y*8
			gcopy 3,0,0,8,8
		next
	next
*/
