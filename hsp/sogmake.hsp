*spnmset
	
	;for n,0,itemmax,1
	;	nnn=itemsortid(n)
	;	notesel itemnmedit
	;	noteadd itemnm(nnn,0),n,1
	;	notesel itemnmedite
	;	noteadd itemnm(nnn,1),n,1
	;next
		
		
	for n,0,spmax,1
		nnn=spsortid(n)
		notesel spnmedit
		noteadd spnm(nnn,0),n,1
		notesel spnmedite
		noteadd spnm(nnn,1),n,1
	next

	evecomstr(4)=spnmedit

return

*spidset
	dim spsortset,65536
	dim spsortid,spmax
	dim spsortid2,spmax;ID→並び順
		
	for n,0,spmax,1
		;IDが０の場合はセットする
		if spd(n,78)=0 {
			for idnnn,1,spmax+1
				if spidonoff(idnnn)=0:spd(n,78)=idnnn:spidonoff(idnnn)=1:idnnn=spmax+10
			next
		}
		if spd(n,78)!0:spidonoff(spd(n,78))=1
		;並び順が０の場合はセットする
		if spd(n,77)=0:spd(n,77)=spd(n,78)*100
		spsortset(spd(n,77))=spd(n,78)
	next
		
	spsortcnt=0
	for n,0,65536
		if spsortset(n)!0 {
			;並び順にIDをセットする
			spsortid(spsortcnt)=spsortset(n)-1
			;IDに並び順をセットする
			spsortid2(spsortset(n)-1)=spsortcnt
			spsortcnt++
		}
	next
	
	gosub *spnmset
		

		
	;for n,0,spmax,1
	;	;IDが０の場合はセットする
	;	if spd(n,78)=0 {
	;		for idnnn,1,spmax+1
	;			if spidonoff(idnnn)=0:spd(n,78)=idnnn:spidonoff(idnnn)=1:idnnn=spmax+10
	;		next
	;	}
	;	if spd(n,78)!0:spidonoff(idnnn)=1
	;	;並び順が０の場合はセットする
	;	if spd(n,77)=0:spd(n,77)=spd(n,78)*100
	;next
		
	;gosub *spnmset
	
return

