	moux=mousex
	mouy=mousey
	motomx=mx
	motomy=my

	mx=-1
	my=-1
	tmx=-1
	tmy=-1

	mx=mousex
	my=mousey
	getkey mouleft,1
*/

wend

*mongpputeditmain

;mgpbitmode=1		;0=1ビット 1=2ビット 2=3ビット 3=4ビット
;mgpnomax=64		;モングラ最大数
;mgpelx=0			;モングラエディット時のエディットドット表示左上X
;mgpely=0			;モングラエディット時のエディットドット表示左上Y
;dim mgped,4096+1
;dim mgpexy,64,64
;setco=1				;モングラエディット時の打つ色
;mongpsizecomstr="16x16\n24x24\n32x32\n48x48\n64x64"
;mongpdbitcomstr="1bit\n2bit\n3bit\4bit"
;monpud=0			;モングラ表示位置 0=下　1=上
;mongpmaxset 0=16 1=24 2=32 3=48 4=64
			
	pxmax=400/mgpebai
	pymax=450/mgpebai

	pxmin=mgpelx
	pymin=mgpely
				
	mgpbitmode=1
				
	if pxmax>mongpxmax:pxmax=mongpxmax
	if pymax>mongpymax:pymax=mongpymax
	
	color 196,196,196
	boxf

	color 0,0,0
	pos 300,726
	mes "No."+str(mgpseln)

	;編集ドットの表示
	for py,0,pymax
		for px,0,pxmax
			putx1=px*mgpebai
			puty1=py*mgpebai
			putx2=px*mgpebai+mgpebai-2
			puty2=py*mgpebai+mgpebai-2
			rmxyon=0
			if mx>putx1 and my>puty1 and mx<putx2 and my<puty2:rmxyon=1:mgpediton=1
			if px+mgpxmaipura<mongpxmax and py+mgpymaipura<mongpymax {
				if rmxyon=1:mgpexy(px+mgpxmaipura,py+mgpymaipura)=setco
				;1bitデータの場合
				if mgpbitmode=0 {
					color 255,255,255
					if mgpexy(px+mgpxmaipura,py+mgpymaipura)=0:color 0,0,0
				}
				;2bitデータの場合
				if mgpbitmode=1 {
					color 160,160,160
					if mgpexy(px+mgpxmaipura,py+mgpymaipura)=1:color 255,255,255
					if mgpexy(px+mgpxmaipura,py+mgpymaipura)=2:color 224,224,224
					if mgpexy(px+mgpxmaipura,py+mgpymaipura)=3:color 0,0,0
				}
				boxf putx1,puty1,putx2,puty2
			}
				
		next
	next

	;全体を表示
	for py,0,mongpymax
		for px,0,mongpxmax
				
			;1bitデータの場合
			if mgpbitmode=0 {
				color 255,255,255
				if mgpexy(px,py)=0:color 0,0,0
			}
			;2bitデータの場合
			if mgpbitmode=1 {
				color 160,160,160
				if mgpexy(px,py)=1:color 255,255,255
				if mgpexy(px,py)=2:color 224,224,224
				if mgpexy(px,py)=3:color 0,0,0
			}
			putxx=280+px*3+(64-mongpxmax)/2*3
			putyy=520+py*3+(monpud=0)*((64-mongpymax)*3)+(monpud=1)*((64-mongpymax)*6/4)
				
			boxf putxx,putyy,putxx+2,putyy+2

		next
	next
				
	;シフト　左
	if rmx>280 and rmy>530+50 and rmx<280+50 and rmy<520+64*3-50 {
		
		dim shiftsuby,mongpymax
		
		for py,0,mongpymax
			shiftsuby(py)=mgpexy(0,py)
		next

		for px,0,mongpxmax-1
			for py,0,mongpymax
				mgpexy(px,py)=mgpexy(px+1,py)
			next
		next
		
		for py,0,mongpymax
			mgpexy(mongpxmax-1,py)=shiftsuby(py)
		next
	}
	;シフト　右
	if rmx>280+192-50 and rmy>530+50 and rmx<280+192 and rmy<520+64*3-50 {
		
		dim shiftsuby,mongpymax
		
		for py,0,mongpymax
			shiftsuby(py)=mgpexy(mongpxmax-1,py)
		next

		for px,mongpxmax-1,0,-1
			for py,0,mongpymax
				mgpexy(px,py)=mgpexy(px-1,py)
			next
		next
		
		for py,0,mongpymax
			mgpexy(0,py)=shiftsuby(py)
		next
	}
	;シフト　上
	if rmx>280+50 and rmy>530 and rmx<280+192-50 and rmy<530+50 {
		
		dim shiftsubx,mongpxmax
		
		for px,0,mongpxmax
			shiftsubx(px)=mgpexy(px,0)
		next

		for py,0,mongpymax-1
			for px,0,mongpxmax
				mgpexy(px,py)=mgpexy(px,py+1)
			next
		next
		
		for px,0,mongpxmax
			mgpexy(px,mongpymax-1)=shiftsubx(px)
		next
	}
	;シフト　下
	if rmx>280+50 and rmy>520+64*3-50 and rmx<280+192-50 and rmy<520+64*3 {
		
		dim shiftsubx,mongpxmax
		
		for px,0,mongpxmax
			shiftsubx(px)=mgpexy(px,mongpymax-1)
		next

		for py,mongpymax-1,0,-1
			for px,0,mongpxmax
				mgpexy(px,py)=mgpexy(px,py-1)
			next
		next
		
		for px,0,mongpxmax
			mgpexy(px,0)=shiftsubx(px)
		next
	}
				
	;倍率のバ-を表示
	if mx>40-30 and my>580-25 and mx<238 and my<600+25 {
		mgpebai=(mx-32)/4
		mgpebai=mgpebai+6
		if mgpebai<6:mgpebai=6
		if mgpebai>30:mgpebai=30
	}
	color 64,64,64
	boxf 40,580,148,600
	color 224,224,224
	boxf 40+(mgpebai-6)*4-30,580-25,40+(mgpebai-6)*4+30,600+25
				
				
	;表示位置X　バーを表示
	barbai=400/mongpxmax
	cyousei=80
	barxsize=200
	if mx>0 and my>480-20 and mx<438 and my<510+20 {
		mgpxmaipura=(((mx+barxsize-cyousei)-barxsize/2)/barbai)-((barxsize/2)/barbai)
		if mgpxmaipura<0:mgpxmaipura=0
		if mgpxmaipura>mongpxmax:mgpxmaipura=mongpxmax
	}
	color 64,64,64
	boxf 10+cyousei/2,480,410,510
	color 224,224,224
	boxf 10+mgpxmaipura*barbai-barxsize/2+cyousei,480,10+mgpxmaipura*barbai+barxsize/2+cyousei,510

	;表示位置Y　バーを表示
	barbai=400/mongpymax
	cyousei=80
	barysize=200
	if my>0 and mx>430-20 and my<438 and mx<480+20 {
		mgpymaipura=(((my+barysize-cyousei)-barysize/2)/barbai)-((barysize/2)/barbai)
		if mgpymaipura<0:mgpymaipura=0
		if mgpymaipura>mongpymax:mgpymaipura=mongpymax
	}
	color 64,64,64
	;boxf 10+cyousei/2,480,410,510
	boxf 430,10+cyousei/2,460,410
	color 224,224,224
	boxf 430,10+mgpymaipura*barbai-barysize/2+cyousei,460,10+mgpymaipura*barbai+barysize/2+cyousei

				
	;選んでいる色を枠でかこう
	color 255,255,255
	boxf 20+setco*50-5,660-5,20+setco*50+40+5,700+5
	color 192,192,192
	boxf 20+setco*50-3,660-3,20+setco*50+40+3,700+3

	;選ぶ色を表示
	nnn=powf(2,mgpbitmode+1)
	for selcoput,0,nnn
				
		if rmx>20+selcoput*50 and rmy>660 and rmx<20+selcoput*50+40 and rmy<700 {
			setco=selcoput
		}
				
		;1bitデータの場合
		if mgpbitmode=0 {
			color 0,0,0
			if selcoput=1:color 255,255,255
		}
		;2bitデータの場合
		if mgpbitmode=1 {
			color 160,160,160
			if selcoput=1:color 255,255,255
			if selcoput=2:color 224,224,224
			if selcoput=3:color 0,0,0
		}
		boxf 20+selcoput*50,660,20+selcoput*50+40,700
		
	next

	;Xサイズボタン
	for mongpsizesel,0,5
				
		if rmx>10+mongpsizesel*40-10 and rmy>720-10 and rmx<10+mongpsizesel*40+40-10 and rmy<760-10 {
			mongpxmax=mongpmaxset(mongpsizesel);*16+16
			;mongpymax=mongpsizesel*16+16
			if mgpxmaipura>mongpxmax:mgpxmaipura=0;mongpxmax-mongpxmax
			;if mgpymaipura>mongpymax:mgpymaipura=0;mongpymax-mongpymax
			mgpediton=1
		}
				
		;if mongpsizesel=mongpxmax/16-1 {
		if mongpmaxset(mongpsizesel)=mongpxmax {
			color 255,255,255
			boxf 10+mongpsizesel*40-10,720-10,10+mongpsizesel*40+40-10,760-10
			color 0,0,0
			boxf 10+mongpsizesel*40+2-10,720+2-10,10+mongpsizesel*40+40-2-10,760-2-10
		}
				
		color 255,255,255
		pos 10+mongpsizesel*40,720
		mes mongpmaxset(mongpsizesel)
				
	next


	;Yサイズボタン
	for mongpsizesel,0,5
				
		if rmx>10+mongpsizesel*40-10 and rmy>760-10 and rmx<10+mongpsizesel*40+40-10 and rmy<800-10 {
			;mongpxmax=mongpsizesel*16+16
			;mongpymax=mongpsizesel*16+16
			mongpymax=mongpmaxset(mongpsizesel);*16+16
			;if mgpxmaipura>mongpxmax:mgpxmaipura=0;mongpxmax-mongpxmax
			if mgpymaipura>mongpymax:mgpymaipura=0;mongpymax-mongpymax
			mgpediton=1
		}
				
		;if mongpsizesel=mongpymax/16-1 {
		if mongpmaxset(mongpsizesel)=mongpymax {
			color 255,255,255
			boxf 10+mongpsizesel*40-10,760-10,10+mongpsizesel*40+40-10,800-10
			color 0,0,0
			boxf 10+mongpsizesel*40+2-10,760+2-10,10+mongpsizesel*40+40-2-10,800-2-10
		}
				
		color 255,255,255
		pos 10+mongpsizesel*40,760
		mes mongpmaxset(mongpsizesel)
				
	next
				
	;上か下か
	;monpud
	color 64,64,64
	boxf 235,660,275,700
	pos 245,670
				
	color 255,255,255
	if monpud=0:mes "下"
	if monpud=1:mes "中"
	if monpud=2:mes "上"
	
	if rmx>235 and rmy>660 and rmx<275 and rmy<700 {
		nextmonpud=0
		if monpud=0:nextmonpud=1
		if monpud=1:nextmonpud=2
		if monpud=2:nextmonpud=0
		monpud=nextmonpud
		mgpediton=1
	}
				
return

*btnmongputedit
				
	objsize 80,30,30
				
	pos 210,760
	button gosub "SAVE",*mongpsave
	pos 300,760
	button gosub "LOAD",*mongpload
	pos 390,760
	button gosub "TITLE",*titleb
				
	pos 210,720
	button gosub "←",*mongpsell
	pos 390,720
	button gosub "→",*mongpselr

	pos 190,560
	button gosub "copy",*mongpcopy
	pos 190,600
	button gosub "put",*mongpput


return
				
*mongpcopy
	
	mongpcopyon=1
;mgpbitmode=1		;0=1ビット 1=2ビット 2=3ビット 3=4ビット
;mgpnomax=64		;モングラ最大数
;mgpelx=0			;モングラエディット時のエディットドット表示左上X
;mgpely=0			;モングラエディット時のエディットドット表示左上Y
;dim mgped,4096+1
;dim mgpexy,64,64
;setco=1				;モングラエディット時の打つ色
;mongpsizecomstr="16x16\n24x24\n32x32\n48x48\n64x64"
;mongpdbitcomstr="1bit\n2bit\n3bit\4bit"
;monpud=0			;モングラ表示位置 0=下　1=上

	dim copymgpexy,64,64
	copymonpud=monpud
	copymgpbitmode=mgpbitmode
	copymongpxmax=mongpxmax
	copymongpymax=mongpymax

	for cpy,0,mongpymax
		for cpx,0,mongpxmax
			copymgpexy(cpx,cpy)=mgpexy(cpx,cpy)
		next
	next

return		
				
*mongpput
				
	if mongpcopyon=1 {
		monpud=copymonpud
		mgpbitmode=copymgpbitmode
		mongpxmax=copymongpxmax
		mongpymax=copymongpymax

		for cpy,0,mongpymax
			for cpx,0,mongpxmax
				mgpexy(cpx,cpy)=copymgpexy(cpx,cpy)
			next
		next

		mgpediton=1
	}
				
return

*mongpsave
				
	if mgpediton=1 {
				
		if mgpbitmode=0:datann=mongpxmax*mongpymax/32
		if mgpbitmode=1:datann=mongpxmax*mongpymax/16
		if mgpbitmode=2:datann=mongpxmax*mongpymax/8
		if mgpbitmode=3:datann=mongpxmax*mongpymax/4
				
		dim sdata,datann+1
				
		sdata(0)=bbins(mgpbitmode,3,sdata(0),0)
		sdata(0)=bbins(mongpxmax,8,sdata(0),3)
		sdata(0)=bbins(mongpymax,8,sdata(0),11)
		sdata(0)=bbins(monpud,2,sdata(0),19)
		
		
		sdatacnt=1
		sdatabitcnt=0
		
		for py,0,mongpymax
			for px,0,mongpxmax
		
				sdata(sdatacnt)=bbins(mgpexy(px,py),mgpbitmode+1,sdata(sdatacnt),sdatabitcnt)
		
				sdatabitcnt=sdatabitcnt+mgpbitmode+1
				if sdatabitcnt+mgpbitmode+1>32:sdatacnt++:sdatabitcnt=0
		
			next
		next
		
		setfolder=folder+"mgp/"
		bsave setfolder+"mgsog"+str(mgpseln)+".mgd",sdata
		
		mgpediton=0
		
	}
				
	

return

*mongpload
				
	dim mgpexy,64,64
	mongpxmax=32
	mongpymax=32
	monpud=0
				
	if mode=7000:mgploadseln=mgpseln
	if (mode/1000)=4:mgploadseln=mond(monsel,0)
	if mode=1010:mgploadseln=evechrno-1
			
	setfolder=folder+"mgp/"
	exist setfolder+"mgsog"+str(mgploadseln)+".mgd"

	siz=strsize
				
	dim sdata,siz/4
				
	if siz!-1 {
		
		bload setfolder+"mgsog"+str(mgploadseln)+".mgd",sdata
		
		mgpbitmode=bbget(sdata(0),0,3)
		mongpxmax=bbget(sdata(0),3,8)
		mongpymax=bbget(sdata(0),11,8)
		monpud=bbget(sdata(0),19,2)
		
		if mgpbitmode=0:datann=mongpxmax*mongpymax/32
		if mgpbitmode=1:datann=mongpxmax*mongpymax/16
		if mgpbitmode=2:datann=mongpxmax*mongpymax/8
		if mgpbitmode=3:datann=mongpxmax*mongpymax/4

		sdatacnt=1
		sdatabitcnt=0
		
		for py,0,mongpymax
			for px,0,mongpxmax
		
				mgpexy(px,py)=bbget(sdata(sdatacnt),sdatabitcnt,mgpbitmode+1)
		
				sdatabitcnt=sdatabitcnt+mgpbitmode+1
				if sdatabitcnt+mgpbitmode+1>32:sdatacnt++:sdatabitcnt=0
		
			next
		next

		mgpediton=0

	}
				
	if mode=1010 and evechrno=0:siz=1

				
return
		
*mongploadstart

	dim chrgpxsize,mgpnomax
	dim chrgpysize,mgpnomax
	dim chrpudpos,mgpnomax
	
	for mgploadseln,0,mgpnomax
			
		setfolder=folder+"mgp/"
		exist setfolder+"mgsog"+str(mgploadseln)+".mgd"

		siz=strsize
				
		dim sdata,siz/4
				
		if siz!-1 {
		
			bload setfolder+"mgsog"+str(mgploadseln)+".mgd",sdata
		
			mgpbitmode=bbget(sdata(0),0,3)
			mongpxmax=bbget(sdata(0),3,8)
			mongpymax=bbget(sdata(0),11,8)
			monpud=bbget(sdata(0),19,2)
			
			chrgpxsize(mgploadseln)=mongpxmax
			chrgpysize(mgploadseln)=mongpymax
			chrpudpos(mgploadseln)=monpud
		
			if mgpbitmode=0:datann=mongpxmax*mongpymax/32
			if mgpbitmode=1:datann=mongpxmax*mongpymax/16
			if mgpbitmode=2:datann=mongpxmax*mongpymax/8
			if mgpbitmode=3:datann=mongpxmax*mongpymax/4

			sdatacnt=1
			sdatabitcnt=0
		
			for py,0,mongpymax
				for px,0,mongpxmax
			
					bbd=bbget(sdata(sdatacnt),sdatabitcnt,mgpbitmode+1)
					;黒
					colornoa=255
					colornor=0;monrgb(btlmon(nn),co,0)*36
					colornog=0;monrgb(btlmon(nn),co,1)*36
					colornob=0;monrgb(btlmon(nn),co,2)*36
					;monbtlgpura((monpx+1)+(monpy+1)*256)=int("$"+strf("%02x",colornoa)+strf("%02x",colornob)+strf("%02x",colornog)+strf("%02x",colornor))
					;1bitデータの場合
					if mgpbitmode=0 {
						;白
						if bbd=1 {
							colornor=255;monrgb(btlmon(nn),co,0)*36
							colornog=255;monrgb(btlmon(nn),co,1)*36
							colornob=255;monrgb(btlmon(nn),co,2)*36
						}
					}
					;2bitデータの場合
					if mgpbitmode=1 {
						;透明
						if bbd=0 {
							colornoa=0
						}
						;白
						if bbd=1 {
							;color 255,255,255
							colornor=255;monrgb(btlmon(nn),co,0)*36
							colornog=255;monrgb(btlmon(nn),co,1)*36
							colornob=255;monrgb(btlmon(nn),co,2)*36
						}
						;グレー
						if bbd=2 {
							;color 224,224,224
							colornor=224;monrgb(btlmon(nn),co,0)*36
							colornog=224;monrgb(btlmon(nn),co,1)*36
							colornob=224;monrgb(btlmon(nn),co,2)*36
						}
					}
							
			
					co=int("$"+strf("%02x",colornoa)+strf("%02x",colornob)+strf("%02x",colornog)+strf("%02x",colornor))
			
					chrgpbfpx=px+((mgploadseln\32)*64)+((64-mongpxmax)/2)
					chrgpbfpy=py+((mgploadseln/32)*64)
					if monpud=0:chrgpbfpy=chrgpbfpy+(64-mongpymax)
					if monpud=1:chrgpbfpy=chrgpbfpy+((64-mongpymax)/2)
					chrgpbf(chrgpbfpx+chrgpbfpy*2048)=co
			
					sdatabitcnt=sdatabitcnt+mgpbitmode+1
					if sdatabitcnt+mgpbitmode+1>32:sdatacnt++:sdatabitcnt=0
		
				next
			next

			mgpediton=0

		}
		
	next
		
	buffer 2,2048,2048,screen_offscreen
	gsel 0
	celbitmap 2,chrgpbf,0
return
				
*mongpsell
				
	gosub *mongpsave
	mgpseln--
	if mgpseln<0:mgpseln=mgpnomax-1
	gosub *mongpload

return

*mongpselr

	gosub *mongpsave
	mgpseln++
	if mgpseln>mgpnomax-1:mgpseln=0
	gosub *mongpload

return

*btnchredit

objsize 80,30,30

;pos 10,600
;button gosub "EVENTSET",*eventset
;;chkbox "イベントモード",evemode


pos 390,680
button gosub "SAVE",*esavechrd
pos 390,720
button gosub "LOAD",*eloadchrd
pos 390,760
button gosub "TITLE",*titleb

pos 300,590
button gosub "ALL COPY",*chrdallc
pos 390,590
button gosub "STR COPY",*chrdstrc
pos 300,630
button gosub "ALL PUT",*chrdallp
pos 390,630
button gosub "STR PUT",*chrdstrp
			

objsize 55,30,30
pos 230,480
button gosub "←",*chrjobsell
pos 420,480
button gosub "→",*chrjobselr
pos 230,550
button gosub "←",*chrparasell
pos 420,550
button gosub "→",*chrparaselr


sdim chreditstatnm,10,7
chreditstatnm(0)="力"
chreditstatnm(1)="早"
chreditstatnm(2)="器"
chreditstatnm(3)="魔"
chreditstatnm(4)="HP"
chreditstatnm(5)="MP"
chreditstatnm(6)="EX"
;chreditstatnmstr="力\n早\n器\n魔\nHP\nMP\nEX"

return
			
*chrjobsell
			
	job--
	if job<0:job=31
			
return

*chrjobselr
			
	job++
	if job>31:job=0
			
return
			
*chrparasell
			
	stno--
	if stno<0:stno=9

return
			
*chrparaselr

	stno++
	if stno>9:stno=0

return

*chrdallc
				
	for nnnn,0,5
		for nnnnnn,0,10
			chrdcopya(nnnn,nnnnnn)=chrd(job,nnnn,nnnnnn)
		next
	next
				
return

*chrdallp
				
	for nnnn,0,5
		for nnnnnn,0,10
			chrd(job,nnnn,nnnnnn)=chrdcopya(nnnn,nnnnnn)
		next
	next
	
return

*chrdstrc
				
	for nnnn,0,5
		chrdcopys(nnnn)=chrd(job,nnnn,stno)
	next
	
return

*chrdstrp

	for nnnn,0,5
		chrd(job,nnnn,stno)=chrdcopys(nnnn)
	next

return

*putchrdateditscreen

	maxlvex1=0
	maxlvex2=0

	for lvset,0,100,1

		lv=lvset+chrdediterlvpage*100

		if lv>0 {
	
			px=(lvset/25)*120+8
			py=(lvset\25)*16
			if stno<9:gosub *stup
			if stno=9:gosub *lvupex
			pos px,py
			mes lv
			pos px+32,py
			if stno<9:mes stn
			if stno=9:mes exn
	
			if stno=9 {
				if chrd(job,3,9)=lv:maxlvex1=exn
				if chrd(job,3,9)=lv+1:maxlvex2=exn
			}

		}

	next
	
	if (stno=9) and (maxlvex1!0) and (maxlvex2!0) {
		pos 144,760
		maxlvex3=maxlvex1-maxlvex2
		mes "maxLV時 "+str(maxlvex3)
	}
	
	
	

return

*seplay
	;mmstop 2
	notesel bgmnmset
	noteget bgmselset,setcbno
	exist "gdata/se/"+bgmselset+".wav"
	if strsize!-1 {
		mmload "gdata/se/"+bgmselset+".wav",seplayno,0
		gosub *bgmsevolset
		mmplay seplayno
		seplayno++
		if seplayno>seplaynomax:seplayno=seplaynomin
	}
return
/*
*takaramapset

	dim takaramapon,272,272
	;dim takaradata,256,6;0=宝出現率 1=mapno. 2=x位置 3=y位置 4=グラフィック 5=アイテムレベル

	;takaradata(1,0)=10
	;takaradata(1,1)=1
	;takaradata(1,2)=33
	;takaradata(1,3)=36
	;takaradata(1,4)=94
	;takaradata(1,5)=7
	;takaramapon(33,36)=999

	for takaraonn,0,takaramaxput
		if (takaradata(takaraonn,1)=fr) and (takaradata(takaraonn,2)!0) and (takaradata(takaraonn,3)!0) {
			takaramapon(takaradata(takaraonn,2),takaradata(takaraonn,3))=takaraonn
