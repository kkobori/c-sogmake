*eventset

;evepropaty(eveno,以下)
;10,16,4|9 変数No.,値,変数(dt=(oo,))の要素数　キャラＮｏ変更　または　出現オフ
;10,9 スイッチによるキャラＮｏ変更　または　出現オフ
;2 乗れる　乗れない　くぐる
;1,1,1,1,8,1 発生方法　[乗る　横から触れる　Ａボタン　自動　アイテム-もっている・使う]
;9 キャラＮｏ　あるいは透明
;4 キャラの向き [前後左右回転]
;4 移動　[する1-8(速度)　しない0]
;1 足踏み　[する　しない]
;1 こちらを向く　向かない
	
	mode=1010

	;イベントNo.を決定する
	evdmaxup=0
	ok=0
	if evdmax!0 {
		for n,0,evdmax,1
			f=bbget(eveloc(n),0,8)
			x=bbget(eveloc(n),8,8)
			y=bbget(eveloc(n),16,8)
			l=bbget(eveloc(n),24,8)
			;if evesetx=x-8 and evesety=y-8 and fr=f and l!0:ok=1:eveno=n:_break
			if ix=x and iy=y and fr=f and (l!0):ok=1:eveno=n:_break
			if x=0 and y=0 and f=0 and l=0 and ok=0:ok=1:eveno=n
		next
		if ok=0:eveno=n:evdmaxup=1
	} else {
		eveno=0
		evdmaxup=1
	}

	eveundertop=bbget(evepropaty(eveno,1),28,2);乗れるか
	evehassei(0)=bbget(evepropaty(eveno,2),0,1);発生方法＝乗る
	evehassei(1)=bbget(evepropaty(eveno,2),1,1);発生方法＝触れる
	evehassei(2)=bbget(evepropaty(eveno,2),2,1);発生方法＝ボタン
	evehassei(3)=bbget(evepropaty(eveno,2),3,1);発生方法＝自動
	evehassei(4)=bbget(evepropaty(eveno,2),12,1);ボタン表示をオンのままにする
	evehassei(5)=bbget(evepropaty(eveno,2),4,8);ボタンで発生の場合の表示テキストNo.
	evechrno=bbget(evepropaty(eveno,2),13,9);表示キャラNo.
	evechrmuki=bbget(evepropaty(eveno,2),22,4);表示キャラ向き
	evechridou=bbget(evepropaty(eveno,2),26,4);表示キャラ移動速度
	evechrashi=bbget(evepropaty(eveno,2),30,1);表示キャラ足踏み
	evechrmukuka=bbget(evepropaty(eveno,2),31,1);表示キャラ向くかどうか
	evehassei(6)=bbget(evepropaty(eveno,3),0,1);発生可能向き＝北
	evehassei(7)=bbget(evepropaty(eveno,3),1,1);発生可能向き＝南
	evehassei(8)=bbget(evepropaty(eveno,3),2,1);発生可能向き＝東
	evehassei(9)=bbget(evepropaty(eveno,3),3,1);発生可能向き＝西
	evesymbol=bbget(evepropaty(eveno,3),4,5);地図に表示されるシンボルマーク

/*	invar=p0;挿入する数値
	keta=p1;bitで見てセットする数値の桁
	motovar=p2;変換前数値
	ichi=p3;bitで見て挿入インデックス
*/

	
return

