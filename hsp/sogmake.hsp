*eventput
	

	evdmaxup=0
	ok=0
	if evdmax!0 {
		for n,0,evdmax,1
			f=bbget(eveloc(n),0,8)
			x=bbget(eveloc(n),8,8)
			y=bbget(eveloc(n),16,8)
			l=bbget(eveloc(n),24,8)
			if evesetx=x and evesety=y and fr=f and l!0:ok=1:eveno=n:_break
			if x=0 and y=0 and f=0 and l=0 and ok=0:ok=1:eveno=n
		next
		if ok=0:eveno=n:evdmaxup=1
	} else {
		eveno=0
		evdmaxup=1
	}
	

	l=0
	for n,0,evelimax,1
		if evedcopy(n,0)=0:l=n:_break
	next

	if l!0 {
		for nn,0,evelimax,1
			for nnn,0,6,1
				eved(eveno,nn,nnn)=evedcopy(nn,nnn)
			next
			eee=bbget(eved(eveno,nn,0),0,5)
			
			if eee=2 {
				dim mmm,6
				mmm(0)=bbget(eved(eveno,nn,0),9,16)
				mmm(1)=bbget(eved(eveno,nn,1),0,16)
				mmm(2)=bbget(eved(eveno,nn,1),16,16)
				mmm(3)=bbget(eved(eveno,nn,2),0,16)
				mmm(4)=bbget(eved(eveno,nn,2),16,16)
				mmm(5)=bbget(eved(eveno,nn,3),0,16)
				for nnnn,0,6,1
					if mmm(nnnn)!0 {
						;datasuu=messet(mmm(nnnn),0)
						dim submesset,8;datasuu
						for nnn,0,8;datasuu+1
							submesset(nnn)=messet(mmm(nnnn),nnn)
						next
	
						for ppp,1,65536,1
							if messet(ppp,0)=0:setput=ppp:_break
						next
	
						for nnn,0,8;datasuu+1
							messet(setput,nnn)=submesset(nnn)
						next
	;invar=p0;挿入する数値
	;keta=p1;bitで見てセットする数値の桁
	;motovar=p2;変換前数値
	;ichi=p3;bitで見て挿入インデックス
	
						if nnnn=0:eved(eveno,nn,0)=bbins(setput,16,eved(eveno,nn,0),9)
						if nnnn=1:eved(eveno,nn,1)=bbins(setput,16,eved(eveno,nn,1),0)
						if nnnn=2:eved(eveno,nn,1)=bbins(setput,16,eved(eveno,nn,1),16)
						if nnnn=3:eved(eveno,nn,2)=bbins(setput,16,eved(eveno,nn,2),0)
						if nnnn=4:eved(eveno,nn,2)=bbins(setput,16,eved(eveno,nn,2),16)
						if nnnn=5:eved(eveno,nn,3)=bbins(setput,16,eved(eveno,nn,3),0)
					}
				next
			}
			
		next
		eveloc(eveno)=bbins(fr,8,eveloc(eveno),0)
		eveloc(eveno)=bbins(evesetx+8,8,eveloc(eveno),8)
		eveloc(eveno)=bbins(evesety+8,8,eveloc(eveno),16)
		eveloc(eveno)=bbins(l,8,eveloc(eveno),24)
	}
	
	
	for n,evemax-1,0,-1
		if eved(n,0,0)!0:evdmax=n+1:n=-1:_break
	next

	
return

*monsetup
	
	for n,0,8,1
		monset(fr,n)=monsete(n)
	next
	
return

*monseteup
	
	for n,0,8,1
		objprm 4+n,monset(fr,n)
	next
	
return

