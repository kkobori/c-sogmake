					pos x*4+imgxon,y*4+imgyon-4
					gzoom 4,4,5,18,2,1,1
				}
				if y=0 {
					pos x*4+imgxon,y*4+imgyon-4
					gzoom 4,4,5,18,2,1,1
				}
			}
			if co=0 {
				if motoco!0 {
					gzoom 4,4,5,18,2,1,1
				}
				if mongpmotoy(x)!0 {
					gzoom 4,4,5,18,2,1,1
				}

			}
			mongpmotoy(x)=co
		next
	next
*/
