*monrgbdw
	bno=stat

	setco=bno/6
	setrgb=(bno\6)/2

	setnn=monrgb(monsel,setco,setrgb)

	setnn--
	if setnn<0:setnn=7

	monrgb(monsel,setco,setrgb)=setnn
	
return

*monrgbup
	bno=stat

	setco=bno/6
	setrgb=(bno\6)/2

	setnn=monrgb(monsel,setco,setrgb)

	setnn++
	if setnn>7:setnn=0

	monrgb(monsel,setco,setrgb)=setnn

return

