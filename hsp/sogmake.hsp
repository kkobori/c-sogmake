*esavec
	
	dim sdata,16*3*7
	
	for n1,0,16,1
		for n2,0,7,1
			sdata(n1*21+n2*3+0)=chrd(n1,0,n2)
			sdata(n1*21+n2*3+2)=chrd(n1,4,n2)
			n3=0
			n3=bbins(chrd(n1,1,n2),16,n3,0)
			n3=bbins(chrd(n1,2,n2),8,n3,16)
			n3=bbins(chrd(n1,3,n2),8,n3,24)
			sdata(n1*21+n2*3+1)=n3
		next
	next
	
	bsave folder+"chrupd.dat",sdata
	
return

*eloadc
		
	dim sdata,16*3*7

	exist folder+"chrupd.dat"	

	if strsize!-1 {

	bload folder+"chrupd.dat",sdata
	
	for n1,0,16,1
		for n2,0,7,1
			chrd(n1,0,n2)=sdata(n1*21+n2*3+0)
			chrd(n1,4,n2)=sdata(n1*21+n2*3+2)
			n3=sdata(n1*21+n2*3+1)
			chrd(n1,1,n2)=bbget(n3,0,16)
			chrd(n1,2,n2)=bbget(n3,16,8)
			chrd(n1,3,n2)=bbget(n3,24,8)
		next
	next
/*	
	for n1,3,16
		for n2,0,7,1
			for n3,0,5
				chrd(n1,n3,n2)=chrd(0,n3,n2)
			next
		next
	next
*/
	if mode=500 {
		for n,0,5,1
			objprm n+2,chrd(job,n,stno)
		next
	}

	}

return

