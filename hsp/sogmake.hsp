        ;la   lb       lc                ld              le                                    |f      |g      |h                      |i                         |j                           |k

	exist folder+"itemdat.dat"	
	filesize=strsize/4
	
	itemmax=filesize/16
	dim sdata,filesize
	dim itemd,512,100
	dim itemidonoff,512

	yousoone=16
	
	if strsize!-1 {

	bload folder+"itemdat.dat",sdata

;	moji09="０１２３４５６７８９"
;	mojistr=strmid(moji09,mojiint,mbyte);instr(moji09,0,moji32)/mbyte

	for itemn,0,itemmax,1
/*
		ttttt=sdata(0+itemn*9)
		nm1=varstr(mbyte,ttttt)
		ttttt=sdata(1+itemn*9)
		nm2=varstr(mbyte,ttttt)
		itemnm(itemn,0)=nm1+nm2
		
		ttttt=sdata(2+itemn*9)
		nm1=varstre(ttttt)
		ttttt=sdata(3+itemn*9)
		nm2=varstre(ttttt)
		itemnm(itemn,1)=nm1+nm2
*/	
		setgint=sdata(0+itemn*yousoone)
		gosub *vartostr
		nm1=getg
		setgint=sdata(1+itemn*yousoone)
		gosub *vartostr
		nm2=getg
		setgint=sdata(2+itemn*yousoone)
		gosub *vartostr
		nm3=getg
		itemnm(itemn,0)=nm1+nm2+nm3

		setgint=sdata(3+itemn*yousoone)
		gosub *vartostre
		nm1=getg
		setgint=sdata(4+itemn*yousoone)
		gosub *vartostre
		nm2=getg
		setgint=sdata(5+itemn*yousoone)
		gosub *vartostre
		nm3=getg
		itemnm(itemn,1)=nm1+nm2+nm3

		count=6
		nnn=0

		
		for you,0,92,1
			ttttt=sdata(itemn*yousoone+count)
			itemd(itemn,you)=bbget(ttttt,nnn,itemketa(you))
			nnn=nnn+itemketa(you)
			if you<91 {
				if nnn+itemketa(you+1)>32:count++:nnn=0
			}
			
		next
	next
	
	;IDを確認・セットする
	gosub *itemidset
	
	gosub *itemnmset
	
	motoitemsel=-1
	motoitemnmjp=nostr
	itemnmjp=itemnm(itemsel,0)
	itemnmen=itemnm(itemsel,1)

	}

return

*esavem
	
	dim sdata,23*monmax
	
	for monn,0,monmax,1
	
		;sdata(0+monn*19)=strvar(strmid(monnm(monn,0),0,8))
		;sdata(1+monn*19)=strvar(strmid(monnm(monn,0),8,8))
		;sdata(2+monn*19)=strvare(strmid(monnm(monn,1),0,6))
		;sdata(3+monn*19)=strvare(strmid(monnm(monn,1),6,6))

		setgstr=strmid(monnm(monn,0),0,mbyte*4)
		gosub *strtovar
		sdata(0+monn*23)=getgint
		setgstr=strmid(monnm(monn,0),mbyte*4,mbyte*4)
		gosub *strtovar
		sdata(1+monn*23)=getgint
		setgstr=strmid(monnm(monn,0),mbyte*4*2,mbyte*4)
		gosub *strtovar
		sdata(2+monn*23)=getgint

		setgstr=strmid(monnm(monn,1),0,mbyte*6)
		gosub *strtovare
		sdata(3+monn*23)=getgint
		setgstr=strmid(monnm(monn,1),mbyte*6,mbyte*6)
		gosub *strtovare
		sdata(4+monn*23)=getgint
		setgstr=strmid(monnm(monn,1),mbyte*6*2,mbyte*6)
		gosub *strtovare
		sdata(5+monn*23)=getgint

		count=6
		nnn=0
		n=0
		for you,0,60,1
			n=bbins(mond(monn,you),monketa(you),n,nnn)
			nnn=nnn+monketa(you)
			if you<59 {
				if nnn+monketa(you+1)>32 {
					sdata(count+monn*23)=n
					count++
					nnn=0
					n=0
				}
			}
			if you=59:sdata(count+monn*23)=n
			
		next

		for rgb,0,3
			for nxy,0,8
				nnn=sdata(monn*23+20+rgb)
				sdata(monn*23+20+rgb)=bbins(monrgb(monn,nxy,rgb),3,nnn,nxy*3)
			next
		next

	next

	bsave folder+"mondat.dat",sdata
		
	gosub *monnmset

/*
	dim sdata,monmax*3

	for monn,0,monmax,1
		for rgb,0,3
			for nxy,0,8
				nnn=sdata(monn*rgb)
				sdata(monn*rgb)=bbins(monrgb(monn,nxy,rgb),3,nnn,nxy*3)
				;monrgb(monn,nxy,rgb)
			next
		next
	next

	bsave"gdata/moncodat.dat",sdata
*/
return

*eloadm
	
	exist folder+"mondat.dat"	
	filesize=strsize/4
	
	monmax=filesize/23
	dim sdata,filesize
	dim mond,256,60
	dim monidonoff,256
		
		
		
	if strsize!-1 {

	yousoone=23

	bload folder+"mondat.dat",sdata

	qwe=sdata(0)
	
	for monn,0,monmax,1
	
		setgint=sdata(0+monn*yousoone)
		gosub *vartostr
		nm1=getg
		setgint=sdata(1+monn*yousoone)
		gosub *vartostr
		nm2=getg
		setgint=sdata(2+monn*yousoone)
		gosub *vartostr
		nm3=getg
		monnm(monn,0)=nm1+nm2+nm3

		setgint=sdata(3+monn*yousoone)
		gosub *vartostre
		nm1=getg
		setgint=sdata(4+monn*yousoone)
		gosub *vartostre
		nm2=getg
		setgint=sdata(5+monn*yousoone)
		gosub *vartostre
		nm3=getg
		monnm(monn,1)=nm1+nm2+nm3

		count=6
		nnn=0
		for you,0,60,1
			ttttt=sdata(monn*yousoone+count)
			mond(monn,you)=bbget(ttttt,nnn,monketa(you))
			nnn=nnn+monketa(you)
			if you<59 {
				if nnn+monketa(you+1)>32:count++:nnn=0
			}
			
		next

		for rgb,0,3
			for nxy,0,8
				ttttt=sdata(monn*yousoone+20+rgb)
				nxy3=nxy*3
				monrgb(monn,nxy,rgb)=bbget(ttttt,nxy3,3)
			next
		next

	next

	gosub *monidset
	gosub *monnmset

	motomonsel=-1
	motomonnmjp=nostr
	monnmjp=monnm(monsel,0)
	monnmen=monnm(monsel,1)

	}

return

*esavechrd

	dialog "SAVEしますか？",3

	if stat=6 {
	
		dim sdata,32*3*10;7	
		for n1,0,32,1
			;for n2,0,7,1
			for n2,0,10,1
				sdata(n1*30+n2*3+0)=chrd(n1,0,n2)
				sdata(n1*30+n2*3+2)=chrd(n1,4,n2)
				n3=0
				n3=bbins(chrd(n1,1,n2),16,n3,0)
				n3=bbins(chrd(n1,2,n2),8,n3,16)
				n3=bbins(chrd(n1,3,n2),8,n3,24)
				sdata(n1*30+n2*3+1)=n3
			next
		next
	
		bsave folder+"chrupd.dat",sdata

	}
	
return

*eloadchrd


	;dialog "LOADしますか？",3

	;if stat=6 {
	

		dim sdata,32*3*10;7
		dim chrd,32,5,10;7;レベルアップデータ
		
/*		
		chrd,*,0,* =調整値(32bit)
		chrd,*,1,* =角度　高いほど早くＵＰ(16bit)
		chrd,*,2,* =ＵＰ率　低いほど早くＵＰ(8bit)
		chrd,*,3,* =MAXLV このLVで成長曲線が止まる(8bit)
		chrd,*,4,* =MAXLV以降のUP率 EX以外は100で1LV1UP(32bit)
*/
		exist folder+"chrupd.dat"
		
		if strsize!-1 {

		
			bload folder+"chrupd.dat",sdata
	
			for n1,0,32,1
				for n2,0,10,1
					chrd(n1,0,n2)=sdata(n1*30+n2*3+0)
					n3=sdata(n1*30+n2*3+1)
					chrd(n1,4,n2)=sdata(n1*30+n2*3+2)
					chrd(n1,1,n2)=bbget(n3,0,16)
					chrd(n1,2,n2)=bbget(n3,16,8)
					chrd(n1,3,n2)=bbget(n3,24,8)
				next
			next

		}

return

