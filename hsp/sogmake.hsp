	evehassei(4)=bbget(evepropaty(eveno,2),12,1);ボタン表示をオンのままにする
	evehassei(5)=bbget(evepropaty(eveno,2),4,8);ボタンで発生の場合の表示テキストNo.
	evechrno=bbget(evepropaty(eveno,2),13,9);表示キャラNo.
	evechrmuki=bbget(evepropaty(eveno,2),22,4);表示キャラ向き
	evechridou=bbget(evepropaty(eveno,2),26,4);表示キャラいどうそくど
	evechrashi=bbget(evepropaty(eveno,2),30,1);表示キャラ足踏み
	evechrmukuka=bbget(evepropaty(eveno,2),31,1);表示キャラ向くかどうか
*/
	
	
	for n,evemax-1,-1,-1
		if eved(n,0,0)!0:evdmax=n+1:n=-1:_break
	next

