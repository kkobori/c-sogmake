;evinpを更新したら以下を実行する--------------------------

for n,0,32
	pevinpline=strlen(evinp(n))/10
	for chkro,0,pevinpline
		setstr=nostr
		if strmid(evinp(n),0+chkro*10,1)="i":setstr="0"
		if strmid(evinp(n),0+chkro*10,1)="c":setstr="1"
		if strmid(evinp(n),0+chkro*10,1)="m":setstr="2"
		if strmid(evinp(n),0+chkro*10,1)="b":setstr="3"
		if strmid(evinp(n),0+chkro*10,1)="e":setstr="4"
		if strmid(evinp(n),0+chkro*10,1)="w":setstr="5"
		if strmid(evinp(n),0+chkro*10,1)="v":setstr="6"
		if strmid(evinp(n),0+chkro*10,1)="x":setstr="7"
		if strmid(evinp(n),0+chkro*10,1)="p":setstr="8"
		if strmid(evinp(n),0+chkro*10,1)="u":setstr="9"
		if setstr!nostr {
			settt1=nostr
			settt3=nostr
			settt2=setstr+strmid(evinp(n),chkro*10+1,9)
			if chkro>0:settt1=strmid(evinp(n),0,chkro*10)
			if chkro<(pevinpline-1):settt3=strmid(evinp(n),0+chkro*10+10,(pevinpline-chkro)*10)
			evinp(n)=settt1+settt2+settt3
		}
	next
	;evinp(n)=lll
	notesel evinpset
	noteadd evinp(n),n,1
next

