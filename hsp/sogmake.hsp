				;リスト選択
				if ebtnpos(nnnn,3)=2 {
					clrobj
					mode2100=nnnn+10
					mode=2400
					selstrset=selstrie(nnnn)
					if selstrset=bgmnmset:seselbno=1
					notesel selstrset
					selmax=notemax
					returnmode=2000+ebtnpos(nnnn,4)*100
					canmode=2000+ebtnpos(nnnn,4)*100
					listreturnid=0
					listseln=itemd(itemsel,nnnn)
					;覚える技の場合は特殊なセット
					if itemd(itemsel,3)=54 and nnnn=1 {
						listseln=spsortid2(itemd(itemsel,nnnn))
					}
					tmx=-1
					tmy=-1
				}

			}
			if (mode2100=0) and (ebtnpos(nnnn,0)<rmx) and (ebtnpos(nnnn,1)<rmy) and (ebtnpos(nnnn,2)>rmx) and ((ebtnpos(nnnn,1)+30)>rmy) {
				;ox
				if ebtnpos(nnnn,3)=3 {
					itemd(itemsel,nnnn)=1-itemd(itemsel,nnnn)
				}
			}
		next

		color 0,0,0
		if mode2100=0 {
			for nnnn,0,100

				if (iepage=ebtnpos(nnnn,4)) {
					pos ebtnpos(nnnn,0),ebtnpos(nnnn,1)-20
					if nnnn<58 or nnnn>89:mes eiteminfostr(nnnn)
					if nnnn>57 and nnnn<90:mes strmid(eiteminfostr(nnnn),0,mbyte*4)

					;数値表示用処理
					if ebtnpos(nnnn,3)=1 {
						pos ebtnpos(nnnn,0)+16,ebtnpos(nnnn,1)
						mes itemd(itemsel,nnnn)
					}

					;リスト選択用表示処理
					if ebtnpos(nnnn,3)=2 {
						notesel selstrie(nnnn)
						noteget selstrieput,itemd(itemsel,nnnn)
						;覚える技の場合は特殊なセット
						if itemd(itemsel,3)=54 and nnnn=1 {
							noteget selstrieput,spsortid2(itemd(itemsel,nnnn))
						}
						pos ebtnpos(nnnn,0)+16,ebtnpos(nnnn,1)
