				;	datasuu=messet(pmesindex,0)
				;	for nnn,0,datasuu,1
				;		strdat=messet(pmesindex,nnn+1)
				;		;tttttt=varstr(mbyte,ttttt)
				;		gosub *varstrgo
				;		pevemes(pevemescnt)=pevemes(pevemescnt)+getg
				;	next
				;}
				for nn,0,8,1
					messet(mesindex,nn)=0
				next
				messettxt(mesindex)=nostr	

/*
				font nostr,18,1
				objsize 620,28,60		
				pos x,y
				;mesbox evemes(evemescnt),620,28,1,28+n4*10
				strrep evemes(evemescnt),"＃Ｒ","\n"
				mesbox evemes(evemescnt),620,84,1,88+n4*10
				;mesobjid(evemescnt)=stat
*/


				sdim strputp,30,10,300
				dim strputint,10,300
				dim strgyoumax,10
				for gyou,0,3
					for nnmm,0,90
						strputint(gyou,nnmm)=999
					next
				next

				gyoumax=0
				strpx=0
				strpxup=0

				notesel keystriii
				for nnmm,0,90
					strputp(gyoumax,strpx)=strmid(evemes(evemescnt),nnmm*mbyte,mbyte)
					;if strputp(gyoumax,strpx)=nostr {
						;strgyoumax(gyoumax)=strpx
					;	cslpos=strpx
					;	nnmm=91
					;} else {
					for aaa,0,36
						noteget bbb,aaa+1
						for ccc,0,15
							ddd=strmid(bbb,ccc*mbyte,mbyte)
							if ddd=strputp(gyoumax,strpx) {
								strputint(gyoumax,strpx)=aaa*15+ccc
								if strputint(gyoumax,strpx)=457 and kaigyocheckon=1:strpxup=1
								if (strputint(gyoumax,strpx)!457) and (kaigyocheckon=1):kaigyocheckon=0
								if strputint(gyoumax,strpx)=360 :kaigyocheckon=1
									
								ccc=20
								aaa=40
							}
						next
					next
					if (aaa=36) and (ccc=15) {
						;strputint(gyoumax,nnmm)=9999
						kaigyocheckon=0
						nnmm=91
						cslpos=strpx
						if (strgyoumax(0)=0) and (strgyoumax(1)=0) and (strgyoumax(2)=0):evemes(pp)=nostr:_break
					}
