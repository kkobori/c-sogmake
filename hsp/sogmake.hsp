*vartostre
;#defcfunc varstre var p17,var p18

	;gs7=p17
	;mbyte7=p18

	jj5="　ＡＢＣＤＥＦＧＨＩＪＫＬＭＮＯＰＱＲＳＴＵＶＷＸＹＺ"
		
	getg=nostr
	
	for mojisuu,0,6,1
		xxxx=mojisuu*5
		aaa=bbget(setgint,xxxx,5)
		xxxx=aaa*mbyte
		if aaa!31:getg=getg+strmid(jj5,xxxx,mbyte)			
	next

return

*monstermapset

	dim mapmonset,(255+4)+16,(255+1)+16,2;x,y,陸か海か
	;dim monsetmapdat,256,4
	;dim monsetnodat,256,7
	;dim monsetrikukaidat,256;陸か海か
	;monsetmax


	for monsetnn,0,monsetmax
		monsetx1=monsetmapdat(monsetnn,0)
		monsetx2=monsetmapdat(monsetnn,2)
		monsety1=monsetmapdat(monsetnn,1)
		monsety2=monsetmapdat(monsetnn,3)
		for monsety,monsety1,monsety2+1
			for monsetx,monsetx1,monsetx2+1
				mapmonset(monsetx,monsety,monsetrikukaidat(monsetnn))=monsetnn+1
			next
		next
	next
	

return

*stup
	stn=(lv+chrd(job,1,stno))*(lv+chrd(job,1,stno))*2

	if lv>chrd(job,3,stno) {
		;stn=powf((chrd(job,3,stno)+chrd(job,1,stno)),2)*2
		stn=(chrd(job,3,stno)+chrd(job,1,stno))*(chrd(job,3,stno)+chrd(job,1,stno))*2
	}

	stn=int(stn/(chrd(job,2,stno)+1)+chrd(job,0,stno))

	if lv>chrd(job,3,stno) {
		stn=stn+(int(chrd(job,4,stno)*(lv-chrd(job,3,stno)))/100)
	}	
return

*lvupex

	exn=powf((lv*100+(chrd(job,1,9)))/100,4)

	if lv>chrd(job,3,9) {
		exn=powf((chrd(job,3,9)*100+chrd(job,1,9))/100,4)
	}

	exn=int((exn*2-7)/(chrd(job,2,9)+1)+chrd(job,0,9))

	if lv>chrd(job,3,9) {
		exn=exn+(int(chrd(job,4,9)*(lv-chrd(job,3,9))))
	}

	;if lv=99 :exn=1000000

	if lv=0 :exn=0
	
	exn=int(exn)

return

*bgmsevolset

	if bgmvolsetmode>0 {
		if bgmvolsetmode<3:bgmvolsetmode=0:voludcountn=20
		if bgmvolsetmode=3:bgmvol=bgmvol+voludcountn:if bgmvol>0:bgmvol=0:bgmvolsetmode=0
		if bgmvolsetmode=4:bgmvol=bgmvol-voludcountn:if bgmvol<-1000:bgmvol=-1000:bgmvolsetmode=0
		if bgmvolsetmode=5:bgmvol=bgmvol+voludcountn:if bgmvol>volhalf:bgmvol=volhalf:bgmvolsetmode=0
		if bgmvolsetmode=6:bgmvol=bgmvol-voludcountn:if bgmvol<-1000:bgmvol=-1000:bgmvolsetmode=0
		if bgmvolsetmode=7:bgmvol=bgmvol+voludcountn:if bgmvol>0:bgmvol=0:bgmvolsetmode=0
		if bgmvolsetmode=8:bgmvol=bgmvol-voludcountn:if bgmvol<volhalf:bgmvol=volhalf:bgmvolsetmode=0
		;if volsetmode=9:bgmvolsetmode=8:bgmvol=0
		nnnvol=((bgmvol+1000)*bgmvolsys)/10
		mmvol 1,nnnvol-1000;sevolset

