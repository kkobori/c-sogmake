	dim smapset,((mapmaxx+4)/4*(mapmaxy+1))+20

;smapset(2)=ループするか 0-255=ループしない。端のチップNo. 256=ループする。
;smapset(3)=BGMNo.
;smapset(4)=端のチップを４つ並べた値
;smapset(5)=ループしない場合　端でワープする先 fr
;smapset(6)=ループしない場合　端でワープする先 ix
;smapset(7)=ループしない場合　端でワープする先 iy
;smapset(8)=自動開始イベントの有無
;smapset(9)=自動開始イベント有の場合のイベントNo.
;smapset(10)=ループしない場合　端でワープする先での向き

	if fr=0:maploopsetima=0

	smapset(0)=mapmaxx
	smapset(1)=mapmaxy
	if maploopsetima=1 {
		smapset(2)=hajichipima
		smapset(4)=0
		for nn,0,4
			smapset(4)=bbins(hajichipima,8,smapset(4),nn*8)
		next
	} else {
		smapset(2)=256
		smapset(4)=0
	}
	smapset(3)=bgmsetima
	smapset(5)=warpfrima
	smapset(6)=warpixima
	smapset(7)=warpiyima
	smapset(8)=eveautoonoffset
	if eveautoonno>1023:eveautoonno=1023
	smapset(9)=eveautoonno
	smapset(10)=warpmukiima
	
	for y,0,mapmaxy+1
		for x,0,(mapmaxx+4)/4
			smapset(x+y*((mapmaxx+4)/4)+20)=mapset(x,y)
		next
	next

	bsave folder+"mapdat/mapdat"+str(fr)+".dat",smapset



	n3=0
	dim sdata,evdmax*evelimax*6+1+evdmax*3

	sdata(n3)=evdmax
	n3++
	
	for n1,0,evdmax,1
		sdata(n3)=eveloc(n1)		
		n3++
		sdata(n3)=evepropaty(n1,0)
		n3++
		sdata(n3)=evepropaty(n1,1)
		n3++
		sdata(n3)=evepropaty(n1,2)
		n3++
		for n2,0,bbget(eveloc(n1),24,8),1
			n4=bbget(eved(n1,n2,0),5,3)
			for n5,0,n4,1
				sdata(n3)=eved(n1,n2,n5)
				n3++
			next
		next
	next

	bsave folder+"mapdat/evedat"+str(fr)+".dat",sdata,n3*4


				

	notesel txtbsave
	for nnn,0,mesmax+1
		noteadd messettxt(nnn),nnn,1
	next
	notesave folder+"txtdat/txtdatb.txt"

	n3=0
	dim sdata,mesmax*8+1

	sdata(n3)=mesmax
	n3++
	
	for n1,0,mesmax+1,1
		sdata(n3)=messet(n1,0)
		n3++
		for n2,0,messet(n1,0),1
			sdata(n3)=messet(n1,n2+1)
			n3++
		next
	next
	
	bsave folder+"txtdat.dat",sdata,n3*4

	mapcslxy(fr,0)=ix
	mapcslxy(fr,1)=iy
	bsave folder+"mapcslxy.dat",mapcslxy
	bsave folder+"editmapno.dat",fr

	mapsavecheck=0

	;sttfr=4
	sttpos=0
	sttpos=bbins(sttfr,8,sttpos,0)
	sttpos=bbins(sttix,8,sttpos,8)
	sttpos=bbins(sttiy,8,sttpos,16)
	bsave folder+"sttpos.dat",sttpos




	if monsetmax>0 {


	;invar=p0;挿入する数値
	;keta=p1;bitで見てセットする数値の桁
	;motovar=p2;変換前数値
	;ichi=p3;bitで見て挿入インデックス

		dim sdata,monsetmax*4
		
		;bload folder+"mapdat/msetd"+str(fr)+".dat",sdata

		for nnnn,0,monsetmax
			for nnnnnn,0,4
				nnnn3=nnnn*4
				nnnnnn8=nnnnnn*8
				sdata(nnnn3)=bbins(monsetmapdat(nnnn,nnnnnn),8,sdata(nnnn3),nnnnnn8)
			next
			nnnn3=nnnn*4+1
			sdata(nnnn3)=bbins(monsetrikukaidat(nnnn),2,sdata(nnnn3),0)
			sdata(nnnn3)=bbins(monper(nnnn),6,sdata(nnnn3),2)
			for nnnnnn,0,3
				nnnn3=nnnn*4+1
				nnnnnn8=nnnnnn*8+8
				sdata(nnnn3)=bbins(monsetnodat(nnnn,nnnnnn),8,sdata(nnnn3),nnnnnn8)
			next
			for nnnnnn,0,4
				nnnn3=nnnn*4+2
				nnnnnn8=nnnnnn*8
				nnnnnn3=nnnnnn+3
				sdata(nnnn3)=bbins(monsetnodat(nnnn,nnnnnn3),8,sdata(nnnn3),nnnnnn8)
			next
			for nnnnnn,0,7
				nnnn3=nnnn*4+3
				nnnnnn8=nnnnnn*3
				sdata(nnnn3)=bbins(monsyutumax(nnnn,nnnnnn),3,sdata(nnnn3),nnnnnn8)
			next
		next

		bsave folder+"mapdat/msetd"+str(fr)+".dat",sdata

	} else {
		exist folder+"mapdat/msetd"+str(fr)+".dat"	
