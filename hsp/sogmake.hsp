*evedcopybtn

	evecopy2on=1
	dim evedcopy2,evelimax,6
	dim evedcopypp,13
	
	for nnnnn,0,evelimax
		evedno=bbget(eved(eveno,nnnnn,0),0,5)
		if (evedno!2) and (evedno!6) {
			for nnnnnnnn,0,6
				evedcopy2(nnnnn,nnnnnnnn)=eved(eveno,nnnnn,nnnnnnnn)
			next
		} else {
			;eved(eveno,nnnnn,0)=bbins(1,5,eved(eveno,nnnnn,0),0)
			for nnnnnnnn,0,6
				evedcopy2(nnnnn,nnnnnnnn)=0;eved(eveno,nnnnn,nnnnnnnn)
			next
		}
	next

	for nnmm,0,5
		evedcopypp(nnmm)=evehassei(nnmm)
	next
	evedcopypp(5)=evechrno
	evedcopypp(6)=eveundertop
	evedcopypp(7)=evechrmuki
	evedcopypp(8)=evechridou
	evedcopypp(9)=evechrashi
	evedcopypp(10)=evechrmukuka
	evedcopypp(11)=evehassei(5)
	evedcopypp(12)=evesymbol

return

*evedputbtn
	
	if evecopy2on=1 {
		dialog"イベントデータを上書きしますか？",2
		if stat=6 {
			sub=seleveline
			for nnnnn,0,evelimax
				evedno=bbget(eved(eveno,nnnnn,0),0,5)
				if (evedno!2) and (evedno!6) {
					for nnnnnnnn,0,6
						eved(eveno,nnnnn,nnnnnnnn)=evedcopy2(nnnnn,nnnnnnnn)
					next
				}
			next
			seleveline=sub
		}
		
		dialog"イベントプロパティを上書きしますか？",2
		if stat=6 {
			for nnmm,0,5
				evehassei(nnmm)=evedcopypp(nnmm)
			next
			evechrno=evedcopypp(5)
			eveundertop=evedcopypp(6)
			evechrmuki=evedcopypp(7)
			evechridou=evedcopypp(8)
			evechrashi=evedcopypp(9)
			evechrmukuka=evedcopypp(10)
			evehassei(5)=evedcopypp(11)
			evesymbol=evedcopypp(12)
		}

	}
return

