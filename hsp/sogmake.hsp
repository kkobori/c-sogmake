	}
	if bno=1:eveline--:if eveline<0:eveline=(evelimax-8)
	if bno=2:eveline++:if eveline>(evelimax-8):eveline=0
	if bno=3 {
		eveline=eveline+8
		if eveline>(evelimax-1):eveline=0
		if eveline>(evelimax-8):eveline=(evelimax-8)
	}
		
return

*evlineput
	
	if mode=1010 {
		for n,0,8,1
			if mouleft=1 and mx>64 and mx<420 and my>16+n*40 and my<16+n*40+40 {
				btnseleveline=n
			}
		next
	}
	
	seleveline=eveline+btnseleveline
	
	color 0,0,0
	boxf 4,16+btnseleveline*40,420,16+btnseleveline*40+39
	color 255,255,255
	boxf 4+1,16+btnseleveline*40+1,420-1,16+btnseleveline*40+39-1
	color 0,0,0
	
	pos 0,0:mes "eveno:"+eveno
	pos 128,0:mes bbget(eved(eveno,seleveline,0),5,3)
	ttttt=bbget(eved(eveno,seleveline,0),9,16)
	pos 192,0:mes ttttt
	ttttt=bbget(eved(eveno,seleveline,1),0,16)
	pos 256,0:mes ttttt
	ttttt=bbget(eved(eveno,seleveline,1),16,16)
	pos 320,0:mes ttttt
/*
				n1=eved(eveno,seleveline,0);int(peld(n,3)))
				;n2=int(peld(n,4))
				;n3=int(peld(n,5))
				pmesindex=bbget(n1,9,16)
				if pmesindex!0 {
					datasuu=messet(pmesindex,0)
					for nnn,0,datasuu,1
						pevemes(pevemescnt)=pevemes(pevemescnt)+varstr(messet(pmesindex,nnn+1))
					next
				}
	pos 256,0:mes pmesindex
	pos 312,0:mes datasuu
*/
	for n,0,8,1
		pos 8,16+n*40+12
		mes str(n+eveline)
	next


	for nnr,0,8,1

				;if nnr=1:stop

		pevedno=bbget(eved(eveno,nnr+eveline,0),0,5)


		q=evnm(bbget(pevedno,0,5))
		
		pevinpline=strlen(evinp(pevedno))/10

		sdim peld,2,100,7
		sdim pevemes,60,20
		pevemescnt=0
		pinfoline=0
	
		;q=q+" "+str(eved(eveno,nn+eveline,0))

		
		for nr,0,pevinpline,1



			peld(nr,0)=strmid(evinp(pevedno),0+nr*10,1);種類
			peld(nr,1)=strmid(evinp(pevedno),1+nr*10,1);位置ｘ
			peld(nr,2)=strmid(evinp(pevedno),2+nr*10,1);位置ｙ
			peld(nr,3)=strmid(evinp(pevedno),3+nr*10,1);変数何番目か
			peld(nr,4)=strmid(evinp(pevedno),4+nr*10,2);bitインデックス
			peld(nr,5)=strmid(evinp(pevedno),6+nr*10,2);bit桁
			peld(nr,6)=strmid(evinp(pevedno),8+nr*10,2);各パラメータ


			if peld(nr,0)="0" or peld(nr,0)="7" or peld(nr,0)="8" or peld(nr,0)="9" {
			;if peld(nr,0)="i" {
				a=bbget(eved(eveno,nnr+eveline,int(peld(nr,3))),int(peld(nr,4)),int(peld(nr,5)))
				q=q+" "+evinfo(pevedno,nr+pinfoline)+" "+a
			}
			if peld(nr,0)="1" {
			;if peld(nr,0)="c" {
				a=bbget(eved(eveno,nnr+eveline,int(peld(nr,3))),int(peld(nr,4)),int(peld(nr,5)))
				notesel evecomstr(int(peld(nr,6)))
				;アイテムの場合は特殊なセットのしかた
				if int(peld(nr,6))=3 {
					a=itemsortid2(a)
				}
				;敵の場合は特殊なセットのしかた
				if int(peld(nr,6))=5 {
					a=monsortid2(a)
				}
				;なし+アイテムの場合は特殊なセットのしかた
				if int(peld(nr,6))=14 {
					if a>0 {
						a=itemsortid2(a-1)+1
					}
				}
				noteget note,a
				q=q+" "+evinfo(pevedno,nr+pinfoline)+" "+note
			}

			if peld(nr,0)="2" {
			;if peld(nr,0)="m" {
				n1=eved(eveno,nnr+eveline,int(peld(nr,3)))
				n2=int(peld(nr,4))
				n3=int(peld(nr,5))
				pmesindex=bbget(n1,n2,n3)
				if pmesindex!0 {
					;datasuu=messet(pmesindex,0)
					datasuu=strlen(messettxt(pmesindex))/mbyte
					pevemes(pevemescnt)=messettxt(pmesindex)
					;for nnn,0,datasuu,1
					;	strdat=messet(pmesindex,nnn+1)
					;	gosub *varstrgo
					;	pevemes(pevemescnt)=pevemes(pevemescnt)+getg
					;next
				}
				q=q+" "+pevemes(pevemescnt)
				pevemescnt++
			}


;<1=bl1割り当てるbit桁l2ボタン数(1-32)lインフォの開始要素数(0-99)l飛ぶ行2,2>			
			if peld(nr,0)="3" {
			;if peld(nr,0)="b" {
				dim pbeld,36
				;pbeld(0)=int(strmid(evinp(pevedno),1,1))
				;pbeld(1)=int(strmid(evinp(pevedno),2,2))
				pbeld(2)=int(strmid(evinp(pevedno),4,2))
				for nnn,0,32
					pbeld(nnn+3)=int(strmid(evinp(pevedno),6+nnn*2,2))
				next
				
				a=int(strmid(evinp(pevedno),1,1))
				aa=bbget(eved(eveno,nnr+eveline,0),8,a)
				nr=pbeld(aa+3)+6
				pinfoline=pbeld(2)-7
				;pinfoline=5
				;nr=9
			}
			if peld(nr,0)="4" {
			;if peld(nr,0)="e" {
				pevinpline=nr+1
				_break
			}
				;if nnr=0:stop
			if peld(nr,0)="5" {
				a=bbget(eved(eveno,nnr+eveline,int(peld(nr,3))),int(peld(nr,4)),int(peld(nr,5)))
				bbbb=bbget(a,0,8)
				cccc=bbget(a,8,8)
				dddd=bbget(a,16,8)
				notesel mapname
				noteget eeee,bbbb
				q=q+" "+eeee+" X,"+str(cccc)+" Y,"+str(dddd);" "+evinfo(pevedno,nr+pinfoline)+" "+bbbb
			}
			if peld(nr,0)="6" {
				a=bbget(eved(eveno,nnr+eveline,int(peld(nr,3))),int(peld(nr,4)),int(peld(nr,5)))
				bbbb=bbget(a,0,8)
				cccc=bbget(a,8,8)
				q=q+" X,"+str(bbbb)+" Y,"+str(cccc);" "+evinfo(pevedno,nr+pinfoline)+" "+bbbb
			}


		next

;stop
		font nostr,14,1
		pos 64,16+nnr*40+12
		mes q
		;color 255,255,255
		;boxf 421,16+nnr*40,480,16+nnr*40+39
	
		
	next

		color 255,255,255
		boxf 421,0,480,800


return

