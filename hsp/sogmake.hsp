font nostr,20,1

moux=mousex
mouy=mousey
motomoux=mousex
motomouy=mousey

*stragetest

gosub *sogiiiini	
	
gosub *btntitle



*emain


dim kaigan,5,5
dim setcc,9

hokann=1
witup=60
motoselpage=0

while dan=1
	
	;mx=-1
	;my=-1

	gosub *ontouch
	
	wittime=30

	
	redraw 0

		;mx=mousex
		;my=mousey
		;motomouleft=mouleft
		;getkey mouleft,1

	;celbitmap 1,henkan,0

		
/*	} else {
		mx=-1
		my=-1
		motomx=-1
		motomy=-1
*/	;}

	gmode 2
	
	if mode!100 {
		color 255,255,255
		boxf
		color 255,255,255
	}

	;pos 0,0:mes mode

	if mode!motomode {
		if motomode=0 {
			if inpspmax<spmax {
				dialog "総数が減ります",3
				n=stat
				if n=6:spmax=inpspmax
				if n=7:inpspmax=spmax
			} else {
				if inpspmax>500:inpspmax=500
				spmax=inpspmax
			}
			if inpitemmax<itemmax {
				dialog "総数が減ります",3
				n=stat
				if n=6:itemmax=inpitemmax
				if n=7:inpitemmax=itemmax
			} else {
				if inpitemmax>500:inpitemmax=500
				itemmax=inpitemmax
			}
			if inpmonmax<monmax {
				dialog "総数が減ります",3
				n=stat
				if n=6:monmax=inpmonmax
				if n=7:inpmonmax=monmax
			} else {
				if inpmonmax>254:inpmonmax=254
				monmax=inpmonmax
			}
		}
		clrobj
		motomode=mode
		;gosub *takaramapset
		rmx=-1
		rmy=-1
		if mode=0:gosub *btntitle:mode4100=0
		if mode=100:gosub *sogiiidanmakeini;*sogiiiini;gosub *btnmapedit
		if mode=105:gosub *btnmapmodesel
		if mode=110:gosub *mappropatyset
		if mode=120:gosub *mapputdmodebtn:monsyutsuno=0:monsyutsupage=0:font nostr,9,1
		if mode=125:gosub *listselmodebtn:selpage=(listseln/64):motolistseln=listseln
		if mode=140:gosub *mapputdmodebtn
		if mode=190 {
			gosub *listselmodebtn
			mode1020set=0
			selpage=(listseln/64)
			motolistseln=listseln
		}
		;if mode=200:gosub *btntakaraset:gosub *takaramapset:takaraselno=-1
		;if mode=300:gosub *btnsp
		;if mode=400:gosub *btnmon
		;if mode=500:gosub *btnchr
		if mode=6000:gosub *btnini
		if mode=7000:gosub *mongpload
		if mode=1000:gosub *btnev00
		if mode=1010 {
			mode1020set=1
			gosub *btnev01
			gosub *mongpload
		}
		if mode=1020:gosub *btnev02
		if mode=1030:mode1020set=1:gosub *btnev03
		if mode=1040 {
			font nostr,16,1
			
			msetdselnnn=nostr
			msetdsel=nostr
			notesel evecomstr(56)
			
			nnn=bbget(msetd(fr,0),0,8)
			if nnn>0:nnn=monsortid2(nnn-1)+1
			noteget msetdselnnn,nnn
			msetdsel=msetdselnnn
			
			nnn=bbget(msetd(fr,0),8,8)
			if nnn>0:nnn=monsortid2(nnn-1)+1
			noteget msetdselnnn,nnn
			msetdsel=msetdsel+"\n"+msetdselnnn
			
			nnn=bbget(msetd(fr,0),16,8)
			if nnn>0:nnn=monsortid2(nnn-1)+1
			noteget msetdselnnn,nnn
			msetdsel=msetdsel+"\n"+msetdselnnn
			
			nnn=bbget(msetd(fr,0),24,8)
			if nnn>0:nnn=monsortid2(nnn-1)+1
			noteget msetdselnnn,nnn
			msetdsel=msetdsel+"\n"+msetdselnnn
			
			nnn=bbget(msetd(fr,1),0,8)
			if nnn>0:nnn=monsortid2(nnn-1)+1
			noteget msetdselnnn,nnn
			msetdsel=msetdsel+"\n"+msetdselnnn
			
			nnn=bbget(msetd(fr,1),8,8)
			if nnn>0:nnn=monsortid2(nnn-1)+1
			noteget msetdselnnn,nnn
			msetdsel=msetdsel+"\n"+msetdselnnn

			nnn=bbget(msetd(fr,1),16,8)
			if nnn>0:nnn=monsortid2(nnn-1)+1
			noteget msetdselnnn,nnn
			msetdsel=msetdsel+"\n"+msetdselnnn
			
			nnn=bbget(msetd(fr,1),24,8)
			if nnn>0:nnn=monsortid2(nnn-1)+1
			noteget msetdselnnn,nnn
			msetdsel=msetdsel+"\n"+msetdselnnn
			
			notesel msetdsel
			selmax=8
			returnmode=1045
			canmode=100
			gosub *msetdmodebtn
			tmx=-1
			tmy=-1
		}
		if mode=1045 {
			font nostr,16,1
						
			notesel evecomstr(56)
			
			msetdselno=listseln
			listseln=bbget(msetd(fr,msetdselno/4),(msetdselno\4)*8,8)
			if listseln>0 {
				listseln=monsortid2(listseln-1)+1
			}
			selmax=monmax+1
			returnmode=1040
			canmode=1040
			gosub *listselmodebtn
			selpage=(listseln/64)
			motolistseln=listseln
			tmx=-1
			tmy=-1
		}
		if mode=2000 {
			font nostr,16,1
			selmax=itemmax
			notesel itemnmedit
			if returnmode!0:selpage=motoselpage
			if returnmode=5:selpage=itemsel/64
			returnmode=0
			canmode=0
			listreturnid=0
			;listseln=itemsel
			listseln=listselnid;itemsortid(listselnid)
			tmx=-1
			tmy=-1
			iepage=0
			mode2000=0
		}
		if mode=2100 or mode=2200 or mode=2300 {
			font nostr,16,1
			gosub *btnitem
			inameima=itemnm(itemsel,0)
			inameimae=itemnm(itemsel,1)
		}
		if mode=2400 {
			motoselpage=selpage
			gosub *listselmodebtn
			selpage=(listseln/64)
			motolistseln=listseln
		}
		if mode=3000 {
			font nostr,16,1
			selmax=spmax
			notesel spnmedit
			if returnmode!0:selpage=motoselpage
			if returnmode=5:selpage=spsel/64
			returnmode=0
			canmode=0
			listreturnid=0
			listseln=spsel
			tmx=-1
			tmy=-1
			sepage=0
			mode3000=0
		}
		if mode=3100 or mode=3200 or mode=3300 {
			font nostr,16,1
			gosub *btnsp
			snameima=spnm(spsel,0)
			snameimae=spnm(spsel,1)
		}
		if mode=3400 {
			motoselpage=selpage
			gosub *listselmodebtn
			selpage=(listseln/64)
			motolistseln=listseln
		}
		if mode=4000 {
			font nostr,16,1
			selmax=monmax
			notesel monnmedit
			if returnmode!0:selpage=motoselpage
			if returnmode=5:selpage=monsel/64
			returnmode=0
			canmode=0
			listreturnid=0
			listseln=monsel
			tmx=-1
			tmy=-1
			mepage=0
			mode4000=0
		}
		if mode=4100 or mode=4200 or mode=4300 {
			font nostr,16,1
			gosub *btnmon
			mnameima=monnm(monsel,0)
			mnameimae=monnm(monsel,1)
			gosub *mongpload

		}
		if mode=4400 {
			motoselpage=selpage
			gosub *listselmodebtn
			selpage=(listseln/64)
			motolistseln=listseln
		}
		if mode=5000 {
			font nostr,16,1
			gosub *btnchredit
		}
		if mode=5400 {
			gosub *listselmodebtn
			selpage=(listseln/64)
			motolistseln=listseln
		}
		if mode=7000 {
			gosub *btnmongputedit
		}
	}
	

*mode125__190_1040_1045_2000_2400_3000_3400_4400_5400
	;リスト選択モード
	if mode=125 or mode=190 or (mode=1040 and mode1040=0) or mode=1045 or ((mode=2000) and (mode2000=0)) or mode=2400 or ((mode=3000) and (mode3000=0)) or mode=3400 or ((mode=4000) and (mode4000=0)) or mode=4400 or mode=5400 {
		ppnmax=selmax
		if selmax>64 {
			if selpage<selpagemax {
				ppnmax=64
			} else {
				ppnmax=((selmax-1)\64)+1
			}
			selpagemax=(selmax-1)/64
		} else {
			selpage=0
			selpagemax=0
		}
		for ppn,0,ppnmax
			ppx=ppn/22
			ppy=ppn\22
			ppxpx=ppx*160
			if selmax<45:ppxpx=ppx*160+80
			if selmax<23:ppxpx=160
			if selmax>21 {
				ppypy=ppy*34
			} else {
				ppypy=ppy*34+(21-selmax)*16
			}
			color 0,0,0
			boxf ppxpx,ppypy,ppxpx+159,ppypy+33
			color 255,255,255
			selline=(((listseln/64)=selpage) and (ppn=(listseln\64)))*3
			boxf ppxpx+2+selline,ppypy+2+selline,ppxpx+159-2-selline,ppypy+33-2-selline
			noteget selstr,(ppy\22)+ppx*22+selpage*64
			color 0,0,0				
			pos ppxpx+4,ppypy+4
			mes selstr
			if rmx>ppxpx and rmy>ppypy and rmx<ppxpx+159 and rmy<ppypy+33 {
				listseln=ppn+selpage*64
				if ((mode=190) or (mode=2400) or (mode=3400)) and (seselbno=1) {
					if (listseln>50) {
						setcbno=listseln
						gosub *seplay
					}
				}
			}
		next

		if selpagemax>0 {
			for ppn,64,66
				ppx=ppn/22
				ppy=ppn\22
				ppxpx=ppx*160
				ppypy=ppy*34
				color 0,0,0
				boxf ppxpx,ppypy,ppxpx+159,ppypy+33
				color 255,255,255
				boxf ppxpx+2,ppypy+2,ppxpx+159-2,ppypy+33-2
				noteget selstr,(ppy\22)+ppx*22+selpage*64
				color 0,0,0				
				pos ppxpx+4,ppypy+4
				if ppn=64:mes "←"
				if ppn=65:mes "→"
				if rmx>ppxpx and rmy>ppypy and rmx<ppxpx+159 and rmy<ppypy+33 {
					if ppn=64:selpage--:if selpage<0:selpage=selpagemax
					if ppn=65:selpage++:if selpage>selpagemax:selpage=0
				}
			next

			pos 0+(mode!190)*380,770
			mes "page "+str(selpage+1)+" / "+str(selpagemax+1)
			
		}
	}

	
	if mode=0 {
		;pos 432,134:mes "総データ数"
		;b=varbit(qwe,32)
		/*
		b=qwe
		pos 0,0
		mes b
		;c=bitvar(b)
		pos 0,16
		mes c
		a=bbins(172,8,45,7)
		pos 0,32
		mes a
		z=bbget(a,7,8)
		pos 0,48
		mes z
		z=bbget(a,0,6)
		pos 0,64
		mes z
*/
	
/*
pevemescnt=0

ooooo=7
for nnnnn,ooooo,51+ooooo
	;sdim pevemes,60,20
	q=nostr
					datasuu=messet(nnnnn,0)
					for nnn,0,datasuu
							gggg=messet(nnnnn,nnn+1)
							q=q+varstr(gggg)
						next
					pos 0,(nnnnn-ooooo)*16:mes str(nnnnn)+" "+str(datasuu)+q
next
*/
	}

*mode_100_101_102_103_104_106
	
	if mode=100 or mode=101 or mode=102 or mode=103 or mode=104 or mode=106 {

		if (fr!motofr) {
			mapcslxy(motofr,0)=ix
			mapcslxy(motofr,1)=iy
			if mapsavecheck=1 {
				dialog "変更があります。SAVEしますか？",3
				if stat=6 {
					setfr=fr
					fr=motofr
					gosub *dansave
					fr=setfr
				}
			}
			gosub *danload
			mapputmode=0
			
		}

		gosub *mode_100_main
;bbget(evepropaty(even,3),9,8)
		if mode100=2 or mode100=4 {
			if varkeyend=10 {
				varputcsl=0
				varputget=inputvarn
				while varputget>0
					varputcsl++
					varputget=varputget/10
				wend
				inputvarketa=0
				varputget=inputvarmax
				while varputget>0
					inputvarketa++
					varputget=varputget/10
				wend
			}
			gosub *varkeyput
			if varkeyend=1 {
				;itemd(itemsel,inputmode)=inputvarn
				
				if mode100=2 {
					if inputvarn>31:inputvarn=31
					takaradata(takarano,6+inputmode)=inputvarn
				}
				if mode100=4 {
					if inputvarn>255:inputvarn=255
					evepropaty(even,3)=bbins(inputvarn,8,evepropaty(even,3),9);,9,8)
					;takaradata(takarano,6+inputmode)=inputvarn
				}
				mode100=0
				motomode=101
			}
			if varkeyend=2 {
				mode100=0
				motomode=101
				;gosub *btnitem
			}
		}

		if mode100=3 {
			if varkeyend=10 {
				varputcsl=0
				varputget=inputvarn
				while varputget>0
					varputcsl++
					varputget=varputget/10
				wend
				inputvarketa=0
				varputget=inputvarmax
				while varputget>0
					inputvarketa++
					varputget=varputget/10
				wend
			}
			gosub *varkeyput
			if varkeyend=1 {
				mode100=0
				motomode=101
				;itemd(itemsel,inputmode)=inputvarn
				
				if inputvarn>1023:inputvarn=1023
				
				doordata(drswno,1)=bbins(inputvarn,10,doordata(drswno,1),0)
				;takaradata(takarano,6+inputmode)=inputvarn
			}
			if varkeyend=2 {
				mode100=0
				motomode=101
				;gosub *btnitem
			}
		}


		ptncnt++
		if ptncnt>60:ptncnt=0

		motofr=fr
		motomapnameima=mapnameima
		motomapmaxx=mapmaxx
		motomapmaxy=mapmaxy


	}

*mode_110
	
	;マッププロパティ
	if mode=110 {
		font nostr,18,1
		pos 116,160
		chipno=hajichipima+64*3
		if fr!0:celput 1,chipno,1.0,1.0,0

		dim ebtnpos,11,4
		ebtnpos(0,0)=100:ebtnpos(0,1)=10:ebtnpos(0,2)=480:ebtnpos(0,3)=40
		ebtnpos(1,0)=100:ebtnpos(1,1)=40:ebtnpos(1,2)=200:ebtnpos(1,3)=70
		ebtnpos(2,0)=300:ebtnpos(2,1)=40:ebtnpos(2,2)=400:ebtnpos(2,3)=70
		ebtnpos(3,0)=120:ebtnpos(3,1)=70:ebtnpos(3,2)=280:ebtnpos(3,3)=100
		ebtnpos(4,0)=100:ebtnpos(4,1)=230:ebtnpos(4,2)=480:ebtnpos(4,3)=260
		ebtnpos(5,0)=100:ebtnpos(5,1)=260:ebtnpos(5,2)=200:ebtnpos(5,3)=290
		ebtnpos(6,0)=300:ebtnpos(6,1)=260:ebtnpos(6,2)=400:ebtnpos(6,3)=290
		ebtnpos(7,0)=190:ebtnpos(7,1)=290:ebtnpos(7,2)=350:ebtnpos(7,3)=320
		ebtnpos(8,0)=190:ebtnpos(8,1)=380:ebtnpos(8,2)=350:ebtnpos(8,3)=410
		ebtnpos(9,0)=250:ebtnpos(9,1)=320:ebtnpos(9,2)=350:ebtnpos(9,3)=350
		ebtnpos(10,0)=250:ebtnpos(10,1)=350:ebtnpos(10,2)=350:ebtnpos(10,3)=380

		notesel mapname
		noteget warpsakimapnm,warpfrima
		notesel maploopset
		noteget maploopsetstr,maploopsetima
		notesel evecomstr(40)
		noteget warpmukistr,warpmukiima
		notesel eveautoonoffnm
		noteget eveautoonoffsetstr,eveautoonoffset
		notesel bgmnmset
		noteget bgmsetimastr,bgmsetima
		;combox bgmsetima,180,bgmnmset

		font nostr,20,1

		;color 0,0,0
		if fr!0 {
			if (mode110=0) and (100<rmx) and (144<rmy) and (132>rmx) and (176>rmy) {
				mode110=1
				ccelx=hajichipima\8
				ccely=(hajichipima\64)/8
				chippage=hajichipima/64
			}
			for nnnn,0,8
				color 0,0,0
				boxf ebtnpos(nnnn,0),ebtnpos(nnnn,1),ebtnpos(nnnn,2),ebtnpos(nnnn,3)
				color 255,255,255
				boxf ebtnpos(nnnn,0)+2,ebtnpos(nnnn,1)+2,ebtnpos(nnnn,2)-2,ebtnpos(nnnn,3)-2
				if (mode110=0) and (ebtnpos(nnnn,0)<rmx) and (ebtnpos(nnnn,1)<rmy) and (ebtnpos(nnnn,2)>rmx) and (ebtnpos(nnnn,3)>rmy) {
					if nnnn=0 {
						mode110=3
						gyoumax=0
						strgyoumax(0)=0
						cslpos=0
						strputpx=ebtnpos(nnnn,0)
						strputpy=ebtnpos(nnnn,1)
						gyouputima=0
						sdim strputp,30,10,300
						dim strputint,10,300
						notesel keystriii
						for nnmm,0,30
							strputp(0,nnmm)=strmid(mapnameima,nnmm*mbyte,mbyte)
							for aaa,0,36
								noteget bbb,aaa+1
								for ccc,0,15
									ddd=strmid(bbb,ccc*mbyte,mbyte)
									if ddd=strputp(0,nnmm) {
										strputint(0,nnmm)=aaa*15+ccc
										ccc=20
										aaa=40
									}
								next
							next
							if (aaa=36) and (ccc=15):strputint(0,nnmm)=9999
							if strputp(0,nnmm)=nostr:cslpos=nnmm:strgyoumax(0)=nnmm:_break
						next
							
					}
					if nnnn=1 {
						inputvarn=mapmaxx
						inputvarpx=ebtnpos(nnnn,0)+16
						inputvarpy=ebtnpos(nnnn,1)
						inputvarmax=255
						inputmode=1
						varkeyend=10
						mode110=2
					}
					if nnnn=2 {
						inputvarn=mapmaxy
						inputvarpx=ebtnpos(nnnn,0)+16
						inputvarpy=ebtnpos(nnnn,1)
						inputvarmax=255
						inputmode=2
						varkeyend=10
						mode110=2
					}
					if nnnn=3 {
						selmax=2
						notesel maploopset
						returnmode=mode
						canmode=mode
						listreturnid=1
						listseln=maploopsetima
						mode=190
						tmx=-1
						tmy=-1
					}
					if nnnn=4 {
						selmax=256
						notesel mapname
						returnmode=mode
						canmode=mode
						listreturnid=0
						listseln=warpfrima
						mode=190
						tmx=-1
						tmy=-1
					}
					if nnnn=5 {
						inputvarn=warpixima
						inputvarpx=ebtnpos(nnnn,0)+16
						inputvarpy=ebtnpos(nnnn,1)
						inputvarmax=255
						inputmode=5
						varkeyend=10
						mode110=2
					}
					if nnnn=6 {
						inputvarn=warpiyima
						inputvarpx=ebtnpos(nnnn,0)+16
						inputvarpy=ebtnpos(nnnn,1)
						inputvarmax=255
						inputmode=6
						varkeyend=10
						mode110=2
					}
					if nnnn=7 {
						selmax=5
						notesel evecomstr(40)
						returnmode=mode
						canmode=mode
						listreturnid=2
						listseln=warpmukiima
						mode=190
						tmx=-1
						tmy=-1
					}
				}
			next
		}
		for nnnn,8,11
			color 0,0,0
			boxf ebtnpos(nnnn,0),ebtnpos(nnnn,1),ebtnpos(nnnn,2),ebtnpos(nnnn,3)
			color 255,255,255
			boxf ebtnpos(nnnn,0)+2,ebtnpos(nnnn,1)+2,ebtnpos(nnnn,2)-2,ebtnpos(nnnn,3)-2
				if (mode110=0) and (ebtnpos(nnnn,0)<rmx) and (ebtnpos(nnnn,1)<rmy) and (ebtnpos(nnnn,2)>rmx) and (ebtnpos(nnnn,3)>rmy) {
					if nnnn=8 {
						notesel bgmnmset
						seselbno=1
						selmax=notemax
						returnmode=mode
						canmode=mode
						listreturnid=3
						listseln=bgmsetima
						mode=190
						tmx=-1
						tmy=-1
					}
					if nnnn=9 {
						selmax=2
						notesel eveautoonoffnm
						returnmode=mode
						canmode=mode
						listreturnid=4
						listseln=eveautoonoffset
						mode=190
						tmx=-1
						tmy=-1
					}
					if nnnn=10 {
						eveselsetno=eveautoonno
						returnmode=mode
						mode=155
						evemode=3
						;inputvarn=eveautoonno
						;inputvarpx=ebtnpos(nnnn,0)+16
						;inputvarpy=ebtnpos(nnnn,1)
						;inputvarmax=255
						;inputmode=10
						;varkeyend=10
						;mode110=2
					}
				}
		next
		color 0,0,0
		if fr!0 {
			pos 10,10:mes"マップ名"
			if mode110=0:pos ebtnpos(0,0)+16,ebtnpos(0,1):mes mapnameima
			pos 10,40:mes"Ｘサイズ"
			if (mode110!2) or (inputmode!1):pos ebtnpos(1,0)+16,ebtnpos(1,1):mes mapmaxx
			pos 210,40:mes"Ｙサイズ"
			if (mode110!2) or (inputmode!2):pos ebtnpos(2,0)+16,ebtnpos(2,1):mes mapmaxy
			pos 10,70:mes"端のループ"
			pos ebtnpos(3,0)+16,ebtnpos(3,1):mes maploopsetstr
			pos 10,110:mes"ループしない場合の端のマップチップ"
			pos 10,150:mes"No. "+str(hajichipima)
			pos 10,200:mes"ループしない場合の端のワープ先"
			;pos 10,255:mes"端のワープ先"
			pos 10,230:mes"MAP"
			pos ebtnpos(4,0)+16,ebtnpos(4,1):mes warpsakimapnm
			pos 80,260:mes"X"
			if (mode110!2) or (inputmode!5):pos ebtnpos(5,0)+16,ebtnpos(5,1):mes warpixima
			pos 280,260:mes"Y"
			if (mode110!2) or (inputmode!6):pos ebtnpos(6,0)+16,ebtnpos(6,1):mes warpiyima
			pos 10,290:mes"ワープ後の向き  "
			pos ebtnpos(7,0)+16,ebtnpos(7,1):mes warpmukistr
			color 0,0,0
			boxf 350,195,430,225
			color 255,255,255
			boxf 350+2,195+2,430-2,225-2
			color 0,0,0
			pos 380,195
			mes "→"
			if (mode110=0) and (350<rmx) and (195<rmy) and (430>rmx) and (225>rmy) {
				selmax=256
				notesel mapname
				returnmode=150
				canmode=mode
				listreturnid=0
				listseln=warpfrima
				mode=190
				mapselsetx=warpixima
				mapselsety=warpiyima
				mapselsetfr=warpfrima
				tmx=-1
				tmy=-1

			}
		}
		pos 10,380:mes"マップＢＧＭ"
		pos ebtnpos(8,0)+16,ebtnpos(8,1):mes bgmsetimastr
		pos 10,320:mes"自動開始イベント"
		pos ebtnpos(9,0)+16,ebtnpos(9,1):mes eveautoonoffsetstr
		pos 10,350:mes"有りの場合のイベントNo."
		if (mode110!2) or (inputmode!10):pos ebtnpos(10,0)+16,ebtnpos(10,1):mes eveautoonno

		if mode110=1 {
			mcorch=0
			gosub *mcputsel
			if mcselx!-1 {
				hajichipima=mcselx+mcsely*8+chippage*64
				mode110=0
			}
		}
		if mode110=2 {
			if varkeyend=10 {
				varputcsl=0
				varputget=inputvarn
				while varputget>0
					varputcsl++
					varputget=varputget/10
				wend
				inputvarketa=0
				varputget=inputvarmax
				while varputget>0
					inputvarketa++
					varputget=varputget/10
				wend
			}
			gosub *varkeyput
			if varkeyend=1 {
				mode110=0
				if inputmode=1 {
					mapmaxx=inputvarn
					if mapmaxx<12:mapmaxx=12
					mapmaxx=((mapmaxx+1)/4)*4+(((mapmaxx+1)\4)!0)*4-1
				}
				if inputmode=2 {
					mapmaxy=inputvarn
					if mapmaxy<12:mapmaxy=12
					mapmaxy=((mapmaxy+1)/4)*4+(((mapmaxy+1)\4)!0)*4-1
				}

			}
			if varkeyend=2 {
				mode110=0
			}
		}
		if mode110=3 {
			gosub *strkeyput
			if varkeyend=2 {
				mode110=0
				mapnameima=nostr
				for gyouput,0,gyoumax+1
					for nnmm,0,strgyoumax(gyouput)+1
						;pos strputpx+nnmm*16,strputpy+gyouput*20
						mapnameima=mapnameima+strputp(gyouput,nnmm)
						if rmx>strputpx+nnmm*16 and rmy>strputpy+gyouput*20 and rmx<strputpx+nnmm*16+16 and rmy<strputpy+gyouput*20+16 {
							cslpos=nnmm
							gyouputima=gyouput
						}
					next
				next
			}
		}
		ptncnt++
		if ptncnt>20:ptncnt=0		
	}

*mode_120
	if mode=120 {
		
		;gosub *eputmap

		font nostr,16,1
		
		dim ebtnpos,32,6
		sdim ebtnstr,20,32

		if (mode120>8) and (mode120<16) {
			;itemd(itemsel,mode120-10)=listseln
			monsyutsuno=mode120monsyutsuno
			monsyutsupage=mode120monsyutsupage

			monsetnodat(monsyutsuno+monsyutsupage,mode120-9)=listseln
			mode120=0
		}

/*
		monsetmax=strsize/12
		monsyutsuno=0:monsyutsupage=0
		dim sdata,filesize
		dim mapmonset,(255+4)/4+4,(255+1)+16,2;x,y,陸か海か
		dim monsetmapdat,monsetmax,4
		dim monsetnodat,monsetmax,7
		dim monsetrikukaidat,monsetmax;陸か海か
*/
		
		ebtnpos(0,0)=290:ebtnpos(0,1)=450:ebtnpos(0,2)=60:ebtnpos(0,3)=30:ebtnpos(0,4)=1:ebtnstr(0)="↑↑"
		ebtnpos(1,0)=290:ebtnpos(1,1)=490:ebtnpos(1,2)=60:ebtnpos(1,3)=30:ebtnpos(1,4)=1:ebtnstr(1)=" ↑"
		ebtnpos(2,0)=290:ebtnpos(2,1)=530:ebtnpos(2,2)=60:ebtnpos(2,3)=30:ebtnpos(2,4)=1:ebtnstr(2)=" ↓"
		ebtnpos(3,0)=290:ebtnpos(3,1)=570:ebtnpos(3,2)=60:ebtnpos(3,3)=30:ebtnpos(3,4)=1:ebtnstr(3)="↓↓"
		ebtnpos(4,0)=10:ebtnpos(4,1)=610:ebtnpos(4,2)=60:ebtnpos(4,3)=30:ebtnpos(4,4)=2
		ebtnpos(5,0)=80:ebtnpos(5,1)=610:ebtnpos(5,2)=60:ebtnpos(5,3)=30:ebtnpos(5,4)=2
		ebtnpos(6,0)=150:ebtnpos(6,1)=610:ebtnpos(6,2)=60:ebtnpos(6,3)=30:ebtnpos(6,4)=2
		ebtnpos(7,0)=220:ebtnpos(7,1)=610:ebtnpos(7,2)=60:ebtnpos(7,3)=30:ebtnpos(7,4)=2
		ebtnpos(8,0)=210:ebtnpos(8,1)=755:ebtnpos(8,2)=70:ebtnpos(8,3)=30:ebtnpos(8,4)=2
		ebtnpos(16,0)=290:ebtnpos(16,1)=610:ebtnpos(16,2)=50:ebtnpos(16,3)=30:ebtnpos(16,4)=3
		ebtnpos(23,0)=380:ebtnpos(23,1)=610:ebtnpos(23,2)=70:ebtnpos(23,3)=30:ebtnpos(23,4)=2
		;ebtnpos(24,0)=350:ebtnpos(24,1)=610:ebtnpos(24,2)=30:ebtnpos(24,3)=30:ebtnpos(24,4)=2
		for nnnn,9,16
			nnnnx=((nnnn-9)/4)*140+10
			nnnny=((nnnn-9)\4)*35+650
			ebtnpos(nnnn,0)=nnnnx:ebtnpos(nnnn,1)=nnnny:ebtnpos(nnnn,2)=100:ebtnpos(nnnn,3)=30:ebtnpos(nnnn,4)=3
			ebtnpos(nnnn+15,0)=nnnnx+105:ebtnpos(nnnn+15,1)=nnnny:ebtnpos(nnnn+15,2)=25:ebtnpos(nnnn+15,3)=30:ebtnpos(nnnn+15,4)=2
		next
		for nnnn,17,23
			nnnnx=5
			nnnny=450+(nnnn-17)*24
			ebtnpos(nnnn,0)=nnnnx:ebtnpos(nnnn,1)=nnnny:ebtnpos(nnnn,2)=275:ebtnpos(nnnn,3)=24:ebtnpos(nnnn,4)=4
			
		next

		;枠描画とタッチ時の処理
				
		for nnnn,0,32

			if nnnn<17 or nnnn>22 {
				color 0,0,0
				boxf ebtnpos(nnnn,0),ebtnpos(nnnn,1),ebtnpos(nnnn,0)+ebtnpos(nnnn,2),ebtnpos(nnnn,1)+ebtnpos(nnnn,3)
				color 255,255,255
				boxf ebtnpos(nnnn,0)+2,ebtnpos(nnnn,1)+2,ebtnpos(nnnn,0)+ebtnpos(nnnn,2)-2,ebtnpos(nnnn,1)+ebtnpos(nnnn,3)-2
				pos ebtnpos(nnnn,0),ebtnpos(nnnn,1)
				color 0,0,0
				mes ebtnstr(nnnn)
			}

			if (mode120=0) and (rmx>ebtnpos(nnnn,0)) and (rmy>ebtnpos(nnnn,1)) and (rmx<(ebtnpos(nnnn,0)+ebtnpos(nnnn,2))) and (rmy<(ebtnpos(nnnn,1)+ebtnpos(nnnn,3))) {
				if nnnn=0 {
					if monsyutsupage>0 {
						monsyutsupage--
					}
				}
				if nnnn=3 {
					if (monsyutsupage)<(monsetmax-6) {
						monsyutsupage++
					}
				}
		;dim monsetmapdat,monsetmax,4
		;dim monsetnodat,monsetmax,7
		;dim monsetrikukaidat,monsetmax;陸か海か
				if (nnnn=1) and (monsetmax>0) and ((monsyutsupage!0) or (monsyutsuno!0)) {
					for nnnnnn,0,4
						subdat=monsetmapdat(monsyutsuno+monsyutsupage,nnnnnn)
						monsetmapdat(monsyutsuno+monsyutsupage,nnnnnn)=monsetmapdat(monsyutsuno+monsyutsupage-1,nnnnnn)
						monsetmapdat(monsyutsuno+monsyutsupage-1,nnnnnn)=subdat
					next
					for nnnnnn,0,7
						subdat=monsetnodat(monsyutsuno+monsyutsupage,nnnnnn)
						monsetnodat(monsyutsuno+monsyutsupage,nnnnnn)=monsetnodat(monsyutsuno+monsyutsupage-1,nnnnnn)
						monsetnodat(monsyutsuno+monsyutsupage-1,nnnnnn)=subdat
					next
					subdat=monsetrikukaidat(monsyutsuno+monsyutsupage)
					monsetrikukaidat(monsyutsuno+monsyutsupage)=monsetrikukaidat(monsyutsuno+monsyutsupage-1)
					monsetrikukaidat(monsyutsuno+monsyutsupage-1)=subdat
					subdat=monper(monsyutsuno+monsyutsupage)
					monper(monsyutsuno+monsyutsupage)=monper(monsyutsuno+monsyutsupage-1)
					monper(monsyutsuno+monsyutsupage-1)=subdat
					if monsyutsuno!0 {
						monsyutsuno--
					} else {
						monsyutsupage--
					}
					gosub *monstermapset
				}
				if (nnnn=2) and (monsetmax>0) and ((monsyutsupage<(monsetmax-6)) or (monsyutsuno<(monsetmax-monsyutsupage-1))) {
					for nnnnnn,0,4
						subdat=monsetmapdat(monsyutsuno+monsyutsupage,nnnnnn)
						monsetmapdat(monsyutsuno+monsyutsupage,nnnnnn)=monsetmapdat(monsyutsuno+monsyutsupage+1,nnnnnn)
						monsetmapdat(monsyutsuno+monsyutsupage+1,nnnnnn)=subdat
					next
					for nnnnnn,0,7
						subdat=monsetnodat(monsyutsuno+monsyutsupage,nnnnnn)
						monsetnodat(monsyutsuno+monsyutsupage,nnnnnn)=monsetnodat(monsyutsuno+monsyutsupage+1,nnnnnn)
						monsetnodat(monsyutsuno+monsyutsupage+1,nnnnnn)=subdat
					next
					subdat=monsetrikukaidat(monsyutsuno+monsyutsupage)
					monsetrikukaidat(monsyutsuno+monsyutsupage)=monsetrikukaidat(monsyutsuno+monsyutsupage+1)
					monsetrikukaidat(monsyutsuno+monsyutsupage+1)=subdat
					subdat=monper(monsyutsuno+monsyutsupage)
					monper(monsyutsuno+monsyutsupage)=monper(monsyutsuno+monsyutsupage+1)
					monper(monsyutsuno+monsyutsupage+1)=subdat
					if (monsyutsuno!5) {
						monsyutsuno++
					} else {
						monsyutsupage++
					}
					gosub *monstermapset
				}
				if nnnn=8 {
					inputvarn=monsetmax
					inputvarpx=ebtnpos(nnnn,0)+16
					inputvarpy=ebtnpos(nnnn,1)
					inputvarmax=250
					mode120=nnnn
					varkeyend=10
					inputmode=10
				}
				;モンスター選択
				if (monsetmax>0) and (nnnn>8) and (nnnn<16) {
					clrobj
					mode120=nnnn
					mode=125
					selstrset="なし\n"+monnmedit
					notesel selstrset
					selmax=notemax
					returnmode=120
					canmode=120
					listreturnid=0
					listseln=monsetnodat(monsyutsuno+monsyutsupage,nnnn-9)
					mode120monsyutsuno=monsyutsuno
					mode120monsyutsupage=monsyutsupage
					tmx=-1
					tmy=-1
				}

				if (nnnn>16) and (nnnn<23) {
					monsyutsuno=nnnn-17
					if monsyutsuno>(monsetmax-1):monsyutsuno=monsetmax-1
				}
				if monsetmax>0 {
					if (nnnn>3) and (nnnn<8) {
						inputvarn=monsetmapdat(monsyutsuno+monsyutsupage,nnnn-4)
						inputvarpx=ebtnpos(nnnn,0)+8
						inputvarpy=ebtnpos(nnnn,1)
						inputvarmax=255
						mode120=nnnn
						varkeyend=10
						inputmode=10
					}
				}
				if monsetmax>0 {
					if nnnn=23 {
						inputvarn=monper(monsyutsuno+monsyutsupage)
						inputvarpx=ebtnpos(nnnn,0)+8
						inputvarpy=ebtnpos(nnnn,1)
						inputvarmax=63
						mode120=nnnn
						varkeyend=10
						inputmode=10
					}
					if nnnn>23 and nnnn<31 {
						inputvarn=monsyutumax(monsyutsuno+monsyutsupage,nnnn-24)
						inputvarpx=ebtnpos(nnnn,0)+8
						inputvarpy=ebtnpos(nnnn,1)
						inputvarmax=6
						mode120=nnnn
						varkeyend=10
						inputmode=10
					}
				}
				if nnnn=16 {;陸か海か
					monsetrikukaidat(monsyutsuno+monsyutsupage)=1-monsetrikukaidat(monsyutsuno+monsyutsupage)
					gosub *monstermapset
				}

			}

		next

		;表示
		pos ebtnpos(8,0)-30,ebtnpos(8,1)+2
		mes "max"
		pos ebtnpos(8,0)+16,ebtnpos(8,1)+2
		mes monsetmax

		if monsetmax>0 {
			
			nnnnx=5
			nnnny=450+monsyutsuno*24
			color 0,0,0
			boxf nnnnx,nnnny,nnnnx+275,nnnny+24
			color 255,255,255
			boxf nnnnx+2,nnnny+2,nnnnx+275-2,nnnny+24-2
			color 0,0,0

			selstrset="なし\n"+monnmedit
			notesel selstrset

			hyoujimax=monsetmax
			if hyoujimax>6:hyoujimax=6
			for nnnn,0,hyoujimax
				noteget selmstr,monsetnodat(nnnn+monsyutsupage,0)
				pos 10,450+nnnn*24
				mes str(nnnn+1+monsyutsupage)
				rikukaistr="陸,"
				if monsetrikukaidat(nnnn+monsyutsupage)=1:rikukaistr="海,"
				pos 40,450+nnnn*24
				mes rikukaistr+str(monsetmapdat(nnnn+monsyutsupage,0))+","+str(monsetmapdat(nnnn+monsyutsupage,1))+","+str(monsetmapdat(nnnn+monsyutsupage,2))+","+str(monsetmapdat(nnnn+monsyutsupage,3))+","+str(monper(nnnn+monsyutsupage))+"%,"+selmstr
			next

			for nnnn,4,8
				pos ebtnpos(nnnn,0)+8,ebtnpos(nnnn,1)+2
				mes str(monsetmapdat(monsyutsuno+monsyutsupage,nnnn-4))
			
			next

			rikukaistr="陸"
			if monsetrikukaidat(monsyutsuno+monsyutsupage)=1:rikukaistr="海"
			pos ebtnpos(16,0)+8,ebtnpos(16,1)+2
			mes rikukaistr

			selstrset="なし\n"+monnmedit
			notesel selstrset

			font nostr,12,1

			for nnnn,9,16
				noteget selmstr,monsetnodat(monsyutsuno+monsyutsupage,nnnn-9)
				pos ebtnpos(nnnn,0)+8,ebtnpos(nnnn,1)+2
				mes selmstr				
			next

			font nostr,16,1

			pos ebtnpos(23,0)-28,ebtnpos(23,1)+2
			mes"出%"
			pos ebtnpos(23,0)+8,ebtnpos(23,1)+2
			mes monper(monsyutsuno+monsyutsupage)

			for nnnn,24,31
				pos ebtnpos(nnnn,0)+8,ebtnpos(nnnn,1)+2
				mes monsyutumax(monsyutsuno+monsyutsupage,nnnn-24)
			next
		}

		

		;数値入力完了時の処理
		if (mode120=8) or ((mode120>3) and (mode120<8)) or (mode120=23) or ((mode120>23) and (mode120<31)) {
			if inputmode=10 {
				varputcsl=0
				varputget=inputvarn
				while varputget>0
					varputcsl++
					varputget=varputget/10
				wend
				inputvarketa=0
				varputget=inputvarmax
				while varputget>0
					inputvarketa++
					varputget=varputget/10
				wend
			}
			gosub *varkeyput
			if varkeyend=1 {
				if mode120=8 {
					if monsetmax>inputvarn {
						dialog "総数が減ります",3
						n=stat
						if n=6 {
							monsetmax=inputvarn
							if monsyutsuno>(monsetmax-1):monsyutsuno=monsetmax-1:if monsyutsuno<0:monsyutsuno=0
							monsyutsupage=0
						}
						if n=7 {
							inputvarn=monsetmax
						}
					} else {
						if inputvarn>250:inputvarn=250
						monsetmax=inputvarn
					}
					if monsetmax=0:monsetmax=0
					selmax=monsetmax
				}
				if (mode120>3) and (mode120<8) {
					if inputvarn>255:inputvarn=255
					monsetmapdat(monsyutsuno+monsyutsupage,mode120-4)=inputvarn
					gosub *monstermapset
				}
				if (mode120=23) {
					if inputvarn>63:inputvarn=63
					monper(monsyutsuno+monsyutsupage)=inputvarn
				}
				if (mode120>23) and (mode120<31) {
					if inputvarn>6:inputvarn=6
					monsyutumax(monsyutsuno+monsyutsupage,mode120-24)=inputvarn
				}
				returnmode=0
				canmode=0
				tmx=-1
				tmy=-1
				mode120=0
			}
			if varkeyend=2 {
				mode120=0
			}
		}
	}
	
	;MAP選択
	if mode=130 {
		selmax=256
		notesel mapname
		returnmode=mode
		canmode=mode
		mode=190
		
		for ppn,0,66
			ppx=ppn/22
			ppy=ppn\22
			color 0,0,0
			boxf ppx*160,ppy*34,ppx*160+159,ppy*34+33
			color 255,255,255
			boxf ppx*160+2,ppy*34+2,ppx*160+159-2,ppy*34+33-2
			notesel mapname
			noteget mapnameima,(ppy\22)+ppx*22
			color 0,0,0				
			pos ppx*160+4,ppy*34+4
			if ppn<64:mes mapnameima
			if ppn=64:mes "←"
			if ppn=65:mes "→"
			if rmx>ppx*160 and rmy>ppy*34 and rmx<ppx*160+159 and rmy<ppy*34+33 {
				if ppn<64 {
					color 0,0,0
					boxf ppx*160,ppy*34,ppx*160+159,ppy*34+33
					fr=ppn
					gosub *danload
					mode=100
				}
			}
		next
	}
	;イベント編集モード
	if mode=140 {

		color 0,0,0
		boxf 290,440,370,470
		color 255,255,255
		boxf 290+2,440+2,370-2,470-2
		color 0,0,0
		pos 296,444
		if eveputonoff=0:mes "EVEPoff"
		if eveputonoff=1:mes "EVEPon"
		if rmx>290 and rmy>440 and rmx<370 and rmy<470 :eveputonoff=1-eveputonoff
		
		;gosub *eputmap

		color 0,0,0
		pos 0,540
		mes evdmax

	}


*mode_150
	
	;マップ地点選択モード・・・地点選択
	if mode=150 {
		
		gosub *putbtn
		
		;上
		if (btnpushon(0)=1 or btn(0)=1) and cmx!-1 {
			iy++
			dpfr=2		;高低
			dpy=0		;奥行
			dpx=2	;左右
			gosub *nsweget
			gosub *mappidset
		}
		;下
		if (btnpushon(2)=1 or btn(2)=1) and cmx!-1 {
			iy--
			dpfr=2		;高低
			dpy=0		;奥行
			dpx=2	;左右
			gosub *nsweget
			gosub *mappidset
		}
		;右
		if (btnpushon(1)=1 or btn(1)=1) and cmx!-1 {
			ix++
			dpfr=2		;高低
			dpy=0		;奥行
			dpx=2	;左右
			gosub *nsweget
			gosub *mappidset
		}
		;左
		if (btnpushon(3)=1 or btn(3)=1) and cmx!-1 {
			ix--
			dpfr=2		;高低
			dpy=0		;奥行
			dpx=2	;左右
			gosub *nsweget
			gosub *mappidset
		}
		;下のフロア
		if (btnpushon(4)=1 or btn(4)=1) and cmx!-1 {
			fr++
			dpfr=2		;高低
			dpy=0		;奥行
			dpx=2	;左右
			gosub *nsweget
			gosub *mappidset
		}
		;上のフロア
		if (btnpushon(5)=1 or btn(5)=1) and cmx!-1 {
			fr--
			dpfr=2		;高低
			dpy=0		;奥行
			dpx=2	;左右
			gosub *nsweget
			gosub *mappidset
		}
		
		
		gosub *putmap

		;決定
		
		color 0,0,0
		boxf 128,750,128+96,790
		color 255,255,255
		boxf 128+2,750+2,128+96-2,790-2
		color 0,0,0
		pos 128+16,760
		mes "OK"
		
		if rmx>128 and rmy>750 and rmx<128+96 and rmy<790 {
			
			;ix=beforeix
			;iy=beforeiy
			;fr=beforefr
			;motofr=fr
;-dmindanf
;-dmindanx
;-dmindany
			mapd(beforefr+1-dmindanf,beforeix-dmindanx,beforeiy-dmindany,2)=0
			
			mode=canmode
			
			if canmode=1010 {
				motofr=fr
				canmode=0
				evemode=1
				mapputmode=0
				evesetx=ix-8
				evesety=iy-8
				eveno=motoeveno

			}
		}
		
		
		;キャンセル
		
		color 0,0,0
		boxf 16,750,16+96,790
		color 255,255,255
		boxf 16+2,750+2,16+96-2,790-2
		color 0,0,0
		pos 16+16,760
		mes "cansel"
		
		if rmx>16 and rmy>750 and rmx<16+96 and rmy<790 {
			
			ix=beforeix
			iy=beforeiy
			fr=beforefr
			motofr=fr
			mode=canmode
			if canmode=110 {
				gosub *danload
				evemode=0
				warpixima=mapselsetx
				warpiyima=mapselsety
				warpfrima=mapselsetfr
			}
			if canmode=600 {
				sttix=mapselsetx
				sttiy=mapselsety
				sttfr=mapselsetfr
				loadoff=1
			}
			if canmode=1010 {
				canmode=0
				evemode=1
				mapputmode=0
				evesetx=mapselsetx-8
				evesety=mapselsety-8
				;evesetx=ix-8
				;evesety=iy-8
				eveno=motoeveno

			}
			if canmode=1020 and listreturnid=1 {
				gosub *danload
				eveinpset(eveinpsetno)=bbins(mapselsetfr,8,eveinpset(eveinpsetno),0)
				eveinpset(eveinpsetno)=bbins(mapselsetx,8,eveinpset(eveinpsetno),8)
				eveinpset(eveinpsetno)=bbins(mapselsety,8,eveinpset(eveinpsetno),16)
				canmode=0
				evemode=1
				mapputmode=0
			}
			if canmode=1020 and listreturnid=6 {
				;gosub *danload
				eveinpset(eveinpsetno)=bbins(mapselsetx,8,eveinpset(eveinpsetno),0)
				eveinpset(eveinpsetno)=bbins(mapselsety,8,eveinpset(eveinpsetno),8)
				canmode=0
				evemode=1
				mapputmode=0
				mode1020set=0
			}
			if canmode=6000 {
				sttfr=mapselsetfr
				sttix=mapselsetx
				sttiy=mapselsety
				canmode=0
				sttpos=0
				sttpos=bbins(sttfr,8,sttpos,0)
				sttpos=bbins(sttix,8,sttpos,8)
				sttpos=bbins(sttiy,8,sttpos,16)
				bsave folder+"sttpos.dat",sttpos
			}
		}
		
	}
	
	;特定のイベント選択モード・・・イベント選択
	if mode=155 {
		;gosub *eputmap
		color 0,0,0
		boxf 16,750,16+96,790
		color 255,255,255
		boxf 16+2,750+2,16+96-2,790-2
		
		if rmx>16 and rmy>750 and rmx<16+96 and rmy<790 {
			evemode=0
			if returnmode=110 {
				eveautoonno=eveselsetno
			}

			if returnmode=1020 {
				eveinpset(eveinpsetno)=bbins(eveselsetno,10,eveinpset(eveinpsetno),0)
				;eveinpsetno=n
				;eveselnoput=eveselsetno
				;returnmode=mode
				evemode=1
				eveno=returneveno
				mode1020set=0
			}
			mode=returnmode
		}
	}

*mode_180

	;キャラクター選択モード
	if mode=180 {
		for chrno,0,255
		
			chrputx=((chrno+1)\15)*32
			chrputy=((chrno+1)/15)*32
			pos chrputx+16,chrputy+16
			chrputno=(chrno/64)*512+(chrno\64)+putmuki*128+64*3+64*4
			celput 1,chrputno,1.0,1.0,0
			;chipno=((evechrno/64)*512+(evechrno\64))+evechrmuki*128+64*3+64*4
			if rmx>chrputx and rmy>chrputy and rmx<chrputx+32 and rmy<chrputy+32 {
				chrselno=chrno
			}
		next
		if tmx>0 and tmy>0 and tmx<32 and tmy<32 {
			chrselno=255
		}
		chrselnopx=((chrselno+1)\15)*32
		chrselnopy=((chrselno+1)/15)*32
		gmode 2
		if (chrselno!255) {
			pos chrselnopx,chrselnopy
		} else {
			pos 0,0			
		}
		gzoom 32,32,2,0,0,16,16

		color 0,0,0
		boxf 360,760,480,800
		color 255,255,255
		boxf 360+1,760+1,480-1,800-1
		if rmx>360 and rmy>760 and rmx<480 and rmy<800 {
			if mode1010!0 {
				mode=1010
				mode1010=0
				evechrno=chrselno
			}
			if mode1020!0 {
				eveinpset(eveinpsetno)=bbins(chrselno,8,eveinpset(eveinpsetno),0)
				mode=1020
				mode1020=0
				mode1020set=0
				;evechrno=chrselno
			}
		}

	}

*mode_185

	;マップチップ選択モード
	if mode=185 {
		for mchipno,0,256
		
			mchipputx=(mchipno\15)*32
			mchipputy=(mchipno/15)*32
			pos mchipputx+16,mchipputy+16
			mchipputno=(mchipno/64)*64+(mchipno\64)+64*3
			celput 1,mchipputno,1.0,1.0,0
			;chipno=((evechrno/64)*512+(evechrno\64))+evechrmuki*128+64*3+64*4
			if rmx>mchipputx and rmy>mchipputy and rmx<mchipputx+32 and rmy<mchipputy+32 {
				mchipselno=mchipno
			}
		next
		mchipselnopx=(mchipselno\15)*32
		mchipselnopy=(mchipselno/15)*32
		gmode 2
		pos mchipselnopx,mchipselnopy
		gzoom 32,32,2,0,0,16,16

		color 0,0,0
		boxf 360,760,480,800
		color 255,255,255
		boxf 360+1,760+1,480-1,800-1
		if rmx>360 and rmy>760 and rmx<480 and rmy<800 {
			if mode1020!0 {
				eveinpset(eveinpsetno)=bbins(mchipselno,8,eveinpset(eveinpsetno),0)
				mode=1020
				mode1020=0
				mode1020set=0
				;evechrno=chrselno
			}
		}

	}


*mode_200
	
	if mode=200 {
		;dim takaradata,256,10;宝 0=出現率 1=mapno. 2=x位置 3=y位置 4=グラフィック 5=アイテムレベル

		;gosub *eputmap

		if takaraselno>-1 {

			if mode200=0 {
				
				tbtnxpos1=10
				tbtnxpos2=100
				tbtnypos=560

				color 0,0,0
				boxf tbtnxpos1,tbtnypos,tbtnxpos2,tbtnypos+30
				color 255,255,255
				boxf tbtnxpos1+2,tbtnypos+2,tbtnxpos2-2,tbtnypos+30-2
				color 0,0,0
				pos tbtnxpos1,tbtnypos-20
				mes"出現率(1-255)"
				;pos tbtnxpos1+8,tbtnypos+4
				;mes takaradata(takaraselno,0)
			}

			if (mode200=0) and (rmx>tbtnxpos1) and (rmy>tbtnypos) and (rmx<tbtnxpos2) and (rmy<tbtnypos+30) {
				mode200=2
				inputvarpx=tbtnxpos1+8
				inputvarpy=tbtnypos
				inputvarmax=255
				varkeyend=10
				inputmode=10
			}

			for tlvnn,0,4

				if mode200=0 {

					tbtnxpos1=150
					tbtnxpos2=240
					tbtnypos=560

					color 0,0,0
					boxf tbtnxpos1,tbtnypos+tlvnn*60,tbtnxpos2,tbtnypos+30+tlvnn*60
					color 255,255,255
					boxf tbtnxpos1+2,tbtnypos+2+tlvnn*60,tbtnxpos2-2,tbtnypos+30-2+tlvnn*60
					color 0,0,0
					pos tbtnxpos1,tbtnypos-20+tlvnn*60
					if tlvnn=0:mes"アイテムレベル"
					if tlvnn=1:mes"0-31 アイテム"
					if tlvnn=2:mes"32-63 金"
					if tlvnn=3:mes"金(値-31)^2*20"
					;pos tbtnxpos1+8,tbtnypos+4+tlvnn*60
					;mes takaradata(takaraselno,5+tlvnn)
				}

				if (mode200=0) and (rmx>tbtnxpos1) and (rmy>tbtnypos+tlvnn*60) and (rmx<tbtnxpos2) and (rmy<tbtnypos+30+tlvnn*60) {
					mode200=3+tlvnn
					inputvarpx=tbtnxpos1+8
					inputvarpy=tbtnypos+tlvnn*60
					inputvarmax=63
					varkeyend=10
					inputmode=10
				}

			next

			if mode200=0 {

				posx=10
				posy=480
				;takaraputchrgno=takaradata(takaraselno,4);表示宝グラフィックNo.
				;takaraputchrgmuki=0;表示宝グラフィック向き
				pos posx+32,posy+16
				chipno=((takaraputchrgno/64)*512+(takaraputchrgno\64))+takaraputchrgmuki*128+64*3+64*4
				if ((takaraputchrgno!256) and (takaranoput!999)):celput 1,chipno,1.0,1.0,0
			}

			if (mode200=0) and (26<rmx) and (480<rmy) and (58>rmx) and (512>rmy) {
				mode200=1
				;ccelx=takaradata(takaraselno,4)\8
				;ccely=(takaradata(takaraselno,4)\64)/8
				;chippage=takaradata(takaraselno,4)/64
			}

			if mode200=1 {
				mcorch=1
				gosub *mcputsel
				if mcselx!-1 {
					;takaradata(takaraselno,4)=mcselx+mcsely*8+chippage*64
					mode200=0
				}
			}

			;数値入力完了時の処理
			if (mode200=2) or (mode200>2) {
				if inputmode=10 {
					varputcsl=0
					varputget=inputvarn
					while varputget>0
						varputcsl++
						varputget=varputget/10
					wend
					inputvarketa=0
					varputget=inputvarmax
					while varputget>0
						inputvarketa++
						varputget=varputget/10
					wend
				}
				gosub *varkeyput
				if varkeyend=1 {
					/*
					if (mode200=2) {
						if inputvarn>255:inputvarn=255
						takaradata(takaraselno,0)=inputvarn
						;宝出現率ゼロを入力した場合は消去する
						if takaradata(takaraselno,0)=0 {
							;takaramapon(takaradata(takaraselno,2),takaradata(takaraselno,3))=0
							takaradata(takaraselno,0)=0
							takaradata(takaraselno,1)=0
							takaradata(takaraselno,2)=0
							takaradata(takaraselno,3)=0
							takaradata(takaraselno,4)=0
							takaradata(takaraselno,5)=0
							gosub *takaramapset
							takaraselno=-1
						}
					}
					if (mode200>2) {
						if inputvarn>63:inputvarn=63
						takaradata(takaraselno,5+(mode200-3))=inputvarn
					}
					*/
					returnmode=0
					canmode=0
					tmx=-1
					tmy=-1
					mode200=0
				}
				if varkeyend=2 {
					mode200=0
				}
			}

		}


	}
/*
	if mode=200 {
	
		gosub *putitemeditscreen

		if itemsel=-1:itemsel=motoitemsel:objprm 0,itemsel
	
		if itemnmjp!motoitemnmjp {
			itemnm(itemsel,0)=itemnmjp
			gosub *itemnmset
			objprm 0,itemnmedit
			motoitemnmjp=itemnmjp
		}
		if itemnmen!motoitemnmen {
			itemnm(itemsel,1)=itemnmen
			motoitemnmen=itemnmen
		}
	
		if itemsel!motoitemsel {
			objprm 1,itemnm(itemsel,0)
			itemnmjp=itemnm(itemsel,0)
			motoitemnmjp=itemnmjp
			objprm 2,itemnm(itemsel,1)
			itemnmen=itemnm(itemsel,1)
			motoitemnmen=itemnmen
			for n,0,42,1
				objprm 3+n,itemd(itemsel,n)
			next	
			objprm 0,itemsel
			motoitemsel=itemsel
		}
		
		for n,0,42,1
			if itemep(n)!motoitemep(n) {
				itemd(itemsel,n)=itemep(n)
				motoitemep(n)=itemep(n)
			}
		next

	}
*/
	if mode=300 {
		
		gosub *putspeditscreen
	
		if spsel=-1:spsel=motospsel:objprm 0,spsel
	
		if spnmjp!motospnmjp {
			spnm(spsel,0)=spnmjp
			gosub *spnmset
			objprm 0,spnmedit
			motospnmjp=spnmjp
		}
		if spnmen!motospnmen {
			spnm(spsel,1)=spnmen
			motospnmen=spnmen
		}
	
		if spsel!motospsel {
			objprm 1,spnm(spsel,0)
			spnmjp=spnm(spsel,0)
			motospnmjp=spnmjp
			objprm 2,spnm(spsel,1)
			spnmen=spnm(spsel,1)
			motospnmen=spnmen
			for n,0,37,1
				objprm 3+n,spd(spsel,n)
			next	
			objprm 0,spsel
			motospsel=spsel
		}
		
		for n,0,37,1
			if spep(n)!motospep(n) {
				spd(spsel,n)=spep(n)
				motospep(n)=spep(n)
			}
		next

	}

	if mode=400 {

		gosub *putmoneditscreen
		
		if monsel=-1:monsel=motomonsel:objprm 0,monsel
	
		if monnmjp!motomonnmjp {
			monnm(monsel,0)=monnmjp
			gosub *monnmset
			objprm 0,monnmedit
			for nxy,0,3,1
				objprm 7+nxy,"なし\n"+monnmedit
			next
			objprm 11,"なし\n"+monnmedit
			motomonnmjp=monnmjp
		}
		if monnmen!motomonnmen {
			monnm(monsel,1)=monnmen
			motomonnmen=monnmen
		}
	
		if monsel!motomonsel {
			gosub *mongpload
			objprm 1,monnm(monsel,0)
			monnmjp=monnm(monsel,0)
			motomonnmjp=monnmjp
			objprm 2,monnm(monsel,1)
			monnmen=monnm(monsel,1)
			motomonnmen=monnmen
			monep(0)=mond(monsel,0)
			for n,1,58,1
				objprm 2+n,mond(monsel,n)
			next	
			objprm 0,monsel
			for n,58,82,1
				nxy=(n-58)/3
				rgb=((n-58)\3)
				objprm n+2,monrgb(monsel,nxy,rgb)
			next
			motomonsel=monsel
		}
		
		for n,0,58,1
			if monep(n)!motomonep(n) {
				mond(monsel,n)=monep(n)
				motomonep(n)=monep(n)
			}
		next
		for rgbno,0,8
			for rgb,0,3
				if monco(rgbno,rgb)!motomonco(rgbno,rgb) {
					monrgb(monsel,rgbno,rgb)=monco(rgbno,rgb)
					motomonco(rgbno,rgb)=monco(rgbno,rgb)
				}
			next
		next
	}
	
	if mode=500 {
		
		gosub *putchreditscreen
	
		if chrsel!motochrsel {
			job=chrsel
			motochrsel=chrsel
			for n,0,5,1
				objprm n+2,chrd(job,n,stno)
			next
		}
		if stsel!motostsel {
			stno=stsel
			motostsel=stsel
			for n,0,5,1
				objprm n+2,chrd(job,n,stno)
			next
		}
		for n,0,5,1
			if chrep(n)!motochrep(n) {
				chrd(job,n,stno)=chrep(n)
				motochrep(n)=chrep(n)
			}
		next
		
	}


	if mode=1000 {
		gosub *puteveditscr00
	}

*mode_1010
	
	if mode=1010 {
		gosub *puteveditscr01
		
		;symbol
		evesymbolstr="シンボルなし\nEVE\nワナ\n宝\n人\n店\n治療所\n広告\n！\n？\n\n\n\n\n"
		notesel evesymbolstr
		
		if (mode1010=0) and rmx>90 and rmy>466 and rmx<170 and rmy<(466+39) {
			selmax=notemax
			returnmode=mode
			canmode=mode
			listreturnid=0
			listseln=evesymbol
			mode=190
			mode1010=3
			tmx=-1
			tmy=-1
		}
		
		
		color 0,0,0
		pos 98,474
		noteget exesymbolset,evesymbol
		mes exesymbolset
		

		for nnmm,0,5
			color 0,0,0
			boxf 16,466+nnmm*40,80,466+nnmm*40+39
			color 255,255,255
			boxf 16+2,466+nnmm*40+2,80-2,466+nnmm*40+39-2
			if (mode1010=0) and rmx>16 and rmy>(466+nnmm*40) and rmx<80 and rmy<(466+nnmm*40+39) {
			;if rmx>16 and rmy>(466+nnmm*40) and rmx<80 and rmy<(466+nnmm*40+39) {
				notesel evepstr(nnmm)
				selmax=notemax
				returnmode=mode
				canmode=mode
				listreturnid=nnmm
				if nnmm=0:listseln=eveundertop
				if nnmm=1:listseln=evechrmuki
				if nnmm=2:listseln=evechridou
				if nnmm=3:listseln=evechrashi
				if nnmm=4:listseln=evechrmukuka
				mode=190
				mode1010=1
				tmx=-1
				tmy=-1

			}
			
		next
		
		

		if mode1010=0 {

			color 0,0,0

			notesel evepstr(0)
			noteget evechrput,eveundertop
			pos 16,472
			mes evechrput

			notesel evepstr(1)
			noteget evechrput,evechrmuki
			pos 16,512
			mes evechrput

			notesel evepstr(2)
			noteget evechrput,evechridou
			pos 16,552
			mes evechrput

			notesel evepstr(3)
			noteget evechrput,evechrashi
			pos 16,592
			mes evechrput

			notesel evepstr(4)
			noteget evechrput,evechrmukuka
			pos 16,632
			mes evechrput
			
		}

		for nnmm,0,5
			if rmx>(16+(nnmm/2)*70+(nnmm\2)*70) and rmy>(672-(nnmm\2)*40) and rmx<(16+(nnmm/2)*70+(nnmm\2)*70+69) and rmy<(672-(nnmm\2)*40+39) {
				evehassei(nnmm)=1-evehassei(nnmm)
			}
			if evehassei(nnmm)=1 {
				color 0,0,0
				boxf 16+(nnmm/2)*70+(nnmm\2)*70,672-(nnmm\2)*40,16+(nnmm/2)*70+(nnmm\2)*70+70,672-(nnmm\2)*40+36
				color 255,255,255
				boxf 16+(nnmm/2)*70+(nnmm\2)*70+2,672-(nnmm\2)*40+2,16+(nnmm/2)*70+(nnmm\2)*70+70-2,672-(nnmm\2)*40+36-2
			}
		next
		
		;東西南北
		for nnmm,0,4
		if rmx>88+((nnmm\2)*60) and rmy>546+((nnmm/2)*40) and rmx<88+((nnmm\2)*60)+59 and rmy<(546+((nnmm/2)*40)+39) {
				evehassei(nnmm+6)=1-evehassei(nnmm+6)
			}
			if evehassei(nnmm+6)=0 {
				color 0,0,0
				boxf 88+((nnmm\2)*60),546+((nnmm/2)*40),88+((nnmm\2)*60)+59,546+((nnmm/2)*40)+36
				color 255,255,255
				boxf 88+((nnmm\2)*60)+2,546+((nnmm/2)*40)+2,88-2+((nnmm\2)*60)+59,546+((nnmm/2)*40)+36-2
			}
		next

		;スイッチで開始する場合のテキスト
		if evehassei(2)=1 and mode!190 {
			color 0,0,0
			boxf 16,715,200,715+39
			color 255,255,255
			boxf 16+2,715+2,200-2,715+39-2
			notesel evestartstr
			noteget evestarttextget,evehassei(5)
			color 0,0,0
			pos 24,720
			mes evestarttextget
			if rmx>16 and rmy>715 and rmx<200 and rmy<715+39 {
				selmax=notemax
				returnmode=mode
				canmode=mode
				mode=190
				mode1010=2
				tmx=-1
				tmy=-1
				listseln=evehassei(5)

			}
		}

		color 0,0,0
			
		pos 16,672
		mes "乗る";,evehassei(0)

		pos 86,632
		mes "触る";,evehassei(1)

		pos 86,672
		mes "ボタン";,evehassei(2)

		pos 156,632
		mes "押動";,evehassei(3)

		pos 156,672
		mes "BTNON";,evehassei(4)

		pos 90,550
		mes "北";,evehassei(0)

		pos 90+60,550
		mes "南";,evehassei(1)

		pos 90,550+40
		mes "東";,evehassei(2)

		pos 90+60,550+40
		mes "西";,evehassei(3)

		/*
		if mode1010=0 and rmx>(72-16-8) and rmy>(376-16-8) and rmx<(72+32-16+8) and rmy<(376+32-16+8) {
			mode1010=2
			mode=180
			putmuki=evechrmuki
			chrselno=evechrno
			tmx=-1
			tmy=-1
		}
		*/

	}

*mode_1020
	
	if mode=1020 {
		if evedno=27 {
			if eveinpset(0)=0:eld(1,0)="8"
			if eveinpset(0)=1:eld(1,0)="9"
		}
		if mode1020=0:gosub *puteveditscr02
		if (mode1020=0) or (mbyte=3) {
		for n,eldstartline,evinpline,1
	
			;if eld(n,0)="i" or eld(n,0)="c" {
			;if eld(n,0)="0" or eld(n,0)="1" {
			;	n1=eved(eveno,seleveline,int(eld(n,3)))
			;	n2=int(eld(n,4))
			;	n3=int(eld(n,5))
			;	eveinpset(n)=bbget(n1,n2,n3)
			;}	
	
			x=16+int(eld(n,1))*80
			y=388+int(eld(n,2))*32
	
			evinfoset(n,0)=1
			evinfoset(n,1)=evedno
			evinfoset(n,2)=x
			evinfoset(n,3)=y-28
	
			;if eld(n,0)="i" {
			if eld(n,0)="0" {
				color 0,0,0
				boxf x,y,x+72,y+24
				color 255,255,255
				boxf x+2,y+2,x+72-2,y+24-2
				color 0,0,0
				pos x+16,y
				if mode1020=0:mes eveinpset(n)
				if (mode1020=0) and (x<rmx) and (y<rmy) and (x+72>rmx) and (y+24>rmy) {
					inputvarn=eveinpset(n)
					inputvarpx=x+16
					inputvarpy=y
					inputvarmax=int(powf(2,int(eld(n,5))))-1
					inputmode=n
					varkeyend=10
					mode1020=2
				}
			}
			;if eld(n,0)="c" {
			if eld(n,0)="1" {
				color 0,0,0
				boxf x,y,x+192,y+24
				color 255,255,255
				boxf x+2,y+2,x+192-2,y+24-2
				if mode1020!1 {
					notesel evecomstr(int(eld(n,6)))
					noteget evecomstrput,eveinpset(n)
					;アイテムの場合は特殊なセットのしかた
					if int(eld(n,6))=3 {
						nnn=itemsortid2(eveinpset(n))
						noteget evecomstrput,nnn
					}						
					;敵の場合は特殊なセットのしかた
					if int(eld(n,6))=5 {
						nnn=monsortid2(eveinpset(n))
						noteget evecomstrput,nnn
					}						
					;なし＋アイテムの場合は特殊なセットのしかた
					if int(eld(n,6))=14 {
						nnn=0
						if eveinpset(n)>0 {
							nnn=itemsortid2(eveinpset(n)-1)+1
						}
						noteget evecomstrput,nnn
					}						
					color 0,0,0
					pos x,y
					mes evecomstrput
				}
				if (mode1020=0) and (x<rmx) and (y<rmy) and (x+192>rmx) and (y+24>rmy) {
				;combox eveinpset(n),192,evecomstr(int(eld(n,6)))
					;--evecomstr(3)=itemnmedit
					;--evecomstr(4)=spnmedit
					;--evecomstr(5)=monnmedit
					notesel evecomstr(int(eld(n,6)))
					seselbno=(int(eld(n,6))=48)
					selmax=notemax
					returnmode=mode
					canmode=mode
