			next
			monsetrikukaidat(nnnn)=bbget(sdata(nnnn*4+1),0,2)
			monper(nnnn)=bbget(sdata(nnnn*4+1),2,6)
			for nnnnnn,0,3
				monsetnodat(nnnn,nnnnnn)=bbget(sdata(nnnn*4+1),nnnnnn*8+8,8)
			next
