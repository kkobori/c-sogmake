				n1=eved(eveno,seleveline,int(eld(n,3)))
				n2=int(eld(n,4))
				n3=int(eld(n,5))
				n4=int(eld(n,6))
				mesindex=bbget(n1,n2,n3)
				if mesindex!0 {
					;datasuu=messet(mesindex,0)
					datasuu=strlen(messettxt(mesindex))/mbyte
					evemes(evemescnt)=messettxt(mesindex)
					;for nn,0,datasuu,1
