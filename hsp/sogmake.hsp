					;ox表示処理
					if ebtnpos(nnnn,3)=3 {
						pos ebtnpos(nnnn,0)+16,ebtnpos(nnnn,1)
						if itemd(itemsel,nnnn)=1:mes"o":else:mes"x"

					}
				}
				if (iepage=ebtnpos(nnnn,4)) {
					pos ebtnpos(99,0)+16,ebtnpos(99,1):mes inameimae
				}
				pos ebtnpos(98,0)+16,ebtnpos(98,1):mes inameima
			next
		}
			
		if mode2100=2 {
			if varkeyend=10 {
				varputcsl=0
				varputget=inputvarn
				while varputget>0
					varputcsl++
					varputget=varputget/10
				wend
				inputvarketa=0
				varputget=inputvarmax
				while varputget>0
					inputvarketa++
					varputget=varputget/10
				wend
			}
			gosub *varkeyput
			if varkeyend=1 {
				mode2100=0
				itemd(itemsel,inputmode)=inputvarn
				gosub *btnitem

			}
			if varkeyend=2 {
				mode2100=0
				gosub *btnitem
			}
			;並び順を変えた場合
			if inputmode=90 {
				gosub *itemidset
				itemsel=itemsortid(listselnid)
				inameima=itemnm(itemsel,0)
				inameimae=itemnm(itemsel,1)
			}
		}

		if (mode2100=101) or (mode2100=102) {
			gosub *strkeyput
			if varkeyend=2 {
				if mode2100=101:inameima=nostr
				if mode2100=102:inameimae=nostr
				for gyouput,0,gyoumax+1
					for nnmm,0,strgyoumax(gyouput)+1
						;pos strputpx+nnmm*16,strputpy+gyouput*20
						if mode2100=101:inameima=inameima+strputp(gyouput,nnmm)
						if mode2100=102:inameimae=inameimae+strputp(gyouput,nnmm)
						if rmx>strputpx+nnmm*16 and rmy>strputpy+gyouput*20 and rmx<strputpx+nnmm*16+16 and rmy<strputpy+gyouput*20+16 {
							cslpos=nnmm
							gyouputima=gyouput
						}
					next
				next
				if mode2100=101 {
					notesel itemnmedit
					noteadd inameima,itemsel,1
					itemnm(itemsel,0)=inameima
				}
				if mode2100=102 {
					notesel itemnmedite
					noteadd inameimae,itemsel,1
					itemnm(itemsel,1)=inameimae
				}
				mode2100=0
				gosub *btnitem
			}
		}

	}

	if mode>2999 and mode<3399 {
