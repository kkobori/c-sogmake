	nnnn=eved(eveno,seleveline,0)
	nnn=0
	if n!bbget(nnnn,8,n1) and motoevedno!0:dialog "上書きしますか？",2:nnn=stat
	if nnn=6 :mode=1040
	if nnn=7 :mode=1010
	if mode=1020:eved(eveno,seleveline,0)=nn
	if mode=1040 {
