return
*/
*btntakaraset

	objsize 80,30,30
	font nostr,20,1

	pos 390,480
	if mapsavecheck=0:button gosub "SAVE",*mapsavedialog
	if mapsavecheck=1:button gosub "*SAVE",*dansave
	pos 390,530
	button gosub "LOAD",*danload
	pos 390,580
	button gosub "TITLE",*titleb

	objsize 80,30,30

	pos 290,480
	button gosub "MODE",*mapmodechenge

return

*simcopy

;spcopyset=0;1=コピーデータ有
;moncopyset=0;1=コピーデータ有
;itemcopyset=0;1=コピーデータ有

	if (mode=2100 or mode=2200) {
		dim itemdcopy,90
		for copyn,0,100
			itemdcopy(copyn)=itemd(itemsel,copyn)
		next
		itemnmcopy0=itemnm(itemsel,0)
		itemnmcopy1=itemnm(itemsel,1)
		itemcopyset=1
	}
	if (mode=3100 or mode=3200) {
		dim spdcopy,77
		for copyn,0,100
			spdcopy(copyn)=spd(spsel,copyn)
		next
		spnmcopy0=spnm(spsel,0)
		spnmcopy1=spnm(spsel,1)
		spcopyset=1
	}
	if (mode=4100 or mode=4200) {
		dim mondcopy,58
		dim monrgbcopy,8,3
		for copyn,0,100
			mondcopy(copyn)=mond(monsel,copyn)
		next
		monnmcopy0=monnm(monsel,0)
		monnmcopy1=monnm(monsel,1)
		moncopyset=1
		for rgb,0,3
			for nxy,0,8
				monrgbcopy(nxy,rgb)=monrgb(monsel,nxy,rgb)
			next
		next
	}

return

*simpaste

	if (mode=2100 or mode=2200) and itemcopyset=1 {
		dialog "データを置き換えます",3
		n=stat
		if n=6 {
			for copyn,0,90
				itemd(itemsel,copyn)=itemdcopy(copyn)
			next
			itemnm(itemsel,0)=itemnmcopy0
			itemnm(itemsel,1)=itemnmcopy1
			inameima=itemnmcopy0
			inameimae=itemnmcopy1
			gosub *itemnmset
		}
	}
	if (mode=3100 or mode=3200) and spcopyset=1 {
		dialog "データを置き換えます",3
		n=stat
		if n=6 {
			for copyn,0,77
				spd(spsel,copyn)=spdcopy(copyn)
			next
			spnm(spsel,0)=spnmcopy0
			spnm(spsel,1)=spnmcopy1
			snameima=spnmcopy0
			snameimae=spnmcopy1
			gosub *spnmset
		}
	}
	if (mode=4100 or mode=4200) and moncopyset=1 {
		dialog "データを置き換えます",3
		n=stat
		if n=6 {
			for copyn,0,58
				mond(monsel,copyn)=mondcopy(copyn)
			next
			monnm(monsel,0)=monnmcopy0
			monnm(monsel,1)=monnmcopy1
			mnameima=monnmcopy0
			mnameimae=monnmcopy1
			gosub *monnmset
			for rgb,0,3
				for nxy,0,8
					monrgb(monsel,nxy,rgb)=monrgbcopy(nxy,rgb)
				next
			next
			gosub *mongpload
		}
	}

return

*btitle
	bno=stat
	mode=(bno+1)*1000
	if mode=6000:loadoff=0
	if mode=1000:mode=100;:gosub *eloadtxt
/*
	moux=mousex
	mouy=mousey
	motomoux=moux
	motomouy=mouy
	motomx=-1
	motomy=-1
	mx=-1
	my=-1
*/
	inmapput=5

return

*btnini

	if loadoff=0 {
		exist folder+"sttpos.dat"
		if strsize!-1 {
			bload folder+"sttpos.dat",sttpos
			sttfr=bbget(sttpos,0,8)
			sttix=bbget(sttpos,8,8)
			sttiy=bbget(sttpos,16,8)
		}
	}

return

*mcputsel
	mcselx=-1
	mcsely=-1
	for chippn,0,64
		posx=(chippn\8)*32+16
		posy=(chippn/8)*32+512
		pos posx+16,posy+16
		celput 1,chippn+chippage*(64+448*mcorch)+192+256*mcorch,1.0,1.0,0
		if mouleft=1 and mx>posx and my>posy and mx<posx+32 and my<posy+32 {
			mcselx=(chippn\8)
			mcsely=(chippn/8)
		}
	next

	;;alStretchImageToScreen 0,0,0,0,16,16,488+ccelx*32,16+ccely*32,32,32
	pos 16+ccelx*32,512+ccely*32
	gzoom 32,32,2,0,0,16,16

	font nostr,20,1
	
	color 0,0,0
	pos 112,470
	mes "Page "+str(chippage+1)

	color 0,0,0
	boxf 16,470,66,500
	boxf 224,470,274,500
	color 255,255,255
	boxf 16+2,470+2,66-2,500-2
	boxf 224+2,470+2,274-2,500-2

	color 0,0,0
	pos 31,470:mes "←"
	pos 240,470:mes "→"
	if tmx>16 and tmy>470 and tmx<66 and tmy<500 {
		chippage--
		if chippage=-1:chippage=3
	}
	if tmx>224 and tmy>470 and tmx<274 and tmy<500 {
		chippage++
		if chippage=4:chippage=0
	}
	;objsize 50,30,200
	;pos 16,470
	;button gosub "←",*mcpagechengel
	;pos 224,470
	;button gosub "→",*mcpagechenger

return

*tenkeywakuput

	color 0,0,0
	boxf 32,512,32+320,512+256

	for tenkeyputn,0,12
		tenkeyx=(tenkeyputn\3)
		tenkeyy=(tenkeyputn/3)
		tenkeyputx=tenkeyx*64+96
		tenkeyputy=tenkeyy*64+512
		color 255,255,255
		boxf tenkeyputx+2,tenkeyputy+2,tenkeyputx+64-2,tenkeyputy+64-2
	next

	for tenkeyputn,0,8
		tenkeyx=(tenkeyputn/4)
		tenkeyy=(tenkeyputn\4)
		tenkeyputx=tenkeyx*256+32
		tenkeyputy=tenkeyy*64+512
		color 255,255,255
		boxf tenkeyputx+2,tenkeyputy+2,tenkeyputx+64-2,tenkeyputy+64-2
	next

return

*strkeyput
	font nostr,20,1
	varkeyend=0
	tenkeystrend=0;これが１だと文字入力時に指を離した瞬間。隣のキーを誤作動するのを防止させる。

	;keystri="7\n8\n9\n4\n5\n6\n1\n2\n3\n　\n0\n　"
	;keystrii="　\n←\n　\n　\nＢＳ\n→\nＣＡＮ\nＯＫ"
	gosub *tenkeywakuput

	for tenkeyputn,0,3
		tenkeyputx=352
		tenkeyputy=tenkeyputn*64+512
		color 0,0,0
		boxf tenkeyputx,tenkeyputy,tenkeyputx+64,tenkeyputy+64
		color 255,255,255
		boxf tenkeyputx+2,tenkeyputy+2,tenkeyputx+64-2,tenkeyputy+64-2
		pos tenkeyputx+12,tenkeyputy+22
		color 0,0,0		
		if tenkeyputn=0:mes "SEL"
		if tenkeyputn=1:mes "COP"
		if tenkeyputn=2:mes "PST"
		if (smx=0) and (tenkeyputx<tmx) and (tenkeyputy<tmy) and ((tenkeyputx+64)>tmx) and ((tenkeyputy+64)>tmy) {
			if tenkeyputn=0 {
				if strselmode=0 {
					dim strseln,10,3000
					dim selstrputp,3000
					dim selstrputint,3000
					selstartcslpos=cslpos
					selstartgyou=gyouputima
				}
				strselmode=1-strselmode
			}
			if tenkeyputn=1 {
				for gyouput,0,10
					for nnmm,0,300
						copystr(gyouput,nnmm)=strputp(gyouput,nnmm)
					next
				next
				for nnmm,0,10
					copystrgyoumax(nnmm)=strgyoumax(nnmm)
				next
				copygyoumax=gyoumax
					;for gyouput,0,gyoumax+1
					;for nnmm,0,strgyoumax(gyouput)+1

			}
			if tenkeyputn=2 {
				for gyouput,0,10
					for nnmm,0,300
						copystrmoto(gyouput,nnmm)=strputp(gyouput,nnmm)
						strputp(gyouput,nnmm)=copystr(gyouput,nnmm)
					next
				next
				for nnmm,0,10
					copystrgyoumaxmoto(nnmm)=strgyoumax(nnmm)
					strgyoumax(nnmm)=copystrgyoumax(nnmm)
				next
				copygyoumaxmoto=gyoumax
				gyoumax=copygyoumax

			}
		}
	next

	
	for tenkeyputn,0,12
		tenkeyx=(tenkeyputn\3)
		tenkeyy=(tenkeyputn/3)
		tenkeyputx=tenkeyx*64+96
		tenkeyputy=tenkeyy*64+512
		notesel keystriii
		if (smx=0) and ((tenkeyputn<9) or (tenkeyputn>9)) and (tenkeyputx<tmx) and (tenkeyputy<tmy) and ((tenkeyputx+64)>tmx) and ((tenkeyputy+64)>tmy) {
			smx=tmx:smy=tmy:smxyn=tenkeyputn
		} else {
			touch12345(tenkeyputn)=0
		}
		if (smx=0) and (tenkeyputn=9) and (cslpos>0) and (tenkeyputx<tmx) and (tenkeyputy<tmy) and ((tenkeyputx+64)>tmx) and ((tenkeyputy+64)>tmy) {
			aaaa=strputint(gyouputima,cslpos-1)
			yyyy=aaaa/15
			xxxx=(aaaa\15)+5
			if xxxx>14:xxxx=xxxx-15
			noteget bbbb,yyyy+1
			cccc=strmid(bbbb,xxxx*mbyte,mbyte)
			if cccc="％" {
				xxxx=xxxx\5
				cccc=strmid(bbbb,xxxx*mbyte,mbyte)			
			}
			if cccc!"％" {
				strputint(gyouputima,cslpos-1)=yyyy*15+xxxx
				strputp(gyouputima,cslpos-1)=cccc
			}
			
		}
		if (smx!0) and ((tenkeyputn<9) or (tenkeyputn>9)) {
			if (smy-32)<my and (smy+32)>my and (smx-32)<mx and (smx+32)>mx :touch12345(smxyn)=0:ttt=0
				
			if (smy-32)<my and (smy+32)>my and (smx-8)>mx :touch12345(smxyn)=1:ttt=1
			if (smx-32)<mx and (smx+32)>mx and (smy-8)>my :touch12345(smxyn)=2:ttt=2
			if (smy-32)<my and (smy+32)>my and (smx+8)<mx :touch12345(smxyn)=3:ttt=3
			if (smx-32)<mx and (smx+32)>mx and (smy+8)<my :touch12345(smxyn)=4:ttt=4

			if rmx!-1 {
				tenkeystrend=1
				noteget keystrput1,smxyn+1+strpage*12
				keystrget=strmid(keystrput1,ttt*mbyte,mbyte)
				for nnmm,strgyoumax(gyouputima),cslpos,-1
					strputp(gyouputima,nnmm)=strputp(gyouputima,nnmm-1)
					strputint(gyouputima,nnmm)=strputint(gyouputima,nnmm-1)
				next
				strputp(gyouputima,cslpos)=keystrget
				nnmm=cslpos
				gosub *strputintset
				cslpos++
				strgyoumax(gyouputima)++
				touch12345(smxyn)=0
				smxyn=0
				smx=0
				smy=0
				ttt=0
			}
		}
		color 0,0,0
		noteget keystrput1,tenkeyputn+1+strpage*12
		pos tenkeyputx+22,tenkeyputy+22
		keystrput2=strmid(keystrput1,touch12345(tenkeyputn)*mbyte,mbyte)
		mes keystrput2
	next



	for tenkeyputn,0,8
		tenkeyx=(tenkeyputn/4)
		tenkeyy=(tenkeyputn\4)
		tenkeyputx=tenkeyx*256+32
		tenkeyputy=tenkeyy*64+512
		color 0,0,0
		notesel keystriiii
		noteget keystrput,tenkeyputn+1
		pos tenkeyputx+2,tenkeyputy+22
		mes keystrput
		;color 255,255,255
		;boxf tenkeyputx+2,tenkeyputy+2,tenkeyputx+64-2,tenkeyputy+64-2
		if (tenkeystrend=0) and (tenkeyputx<rmx) and (tenkeyputy<rmy) and ((tenkeyputx+64)>rmx) and ((tenkeyputy+64)>rmy) {
			if tenkeyputn=1 {
				if cslpos>0 {
					cslpos--
					if strselmode=1:strseln(gyouputima,cslpos)=1
				} else {
					if cslpos=0 and gyouputima>0 {
						gyouputima--
						cslpos=strgyoumax(gyouputima)
					}
				}
			}
			if tenkeyputn=5 {
				if cslpos<strgyoumax(gyouputima) {
					cslpos++
				} else {
					if cslpos>=strgyoumax(gyouputima) and gyouputima<gyoumax {
						cslpos=0
						gyouputima++
					}
				}
			}
			if tenkeyputn=6 {;改行
				;clscnt=0
				for returngyou,gyoumax,gyouputima,-1
					if returngyou<9 {
						for nnmm,0,strgyoumax(returngyou)
							strputp(returngyou+1,nnmm)=strputp(returngyou,nnmm)
							strputint(returngyou+1,nnmm)=strputint(returngyou,nnmm)
							strputp(returngyou,nnmm)=nostr
							strputint(returngyou,nnmm)=999
						next
						strgyoumax(returngyou+1)=strgyoumax(returngyou)
						strgyoumax(returngyou)=0
					}
				next
				copyxcnt=0
				for nnmm,cslpos,strgyoumax(gyouputima)+1
					strputp(returngyou+1,copyxcnt)=strputp(returngyou,nnmm)
					strputint(returngyou+1,copyxcnt)=strputint(returngyou,nnmm)
					strputp(returngyou,nnmm)=nostr
					strputint(returngyou,nnmm)=0
					copyxcnt++
				next
				strgyoumax(gyouputima)=cslpos
				strgyoumax(gyouputima+1)=copyxcnt-1
				cslpos=0
				gyouputima++
				if gyoumax<10:gyoumax++
			}
			if tenkeyputn=7 {
				varkeyend=2				
			}
			if tenkeyputn=4 {;BS
				if strgyoumax(gyouputima)>0 and cslpos>0 {
					for nnmm,cslpos-1,strgyoumax(gyouputima)
						strputp(gyouputima,nnmm)=strputp(gyouputima,nnmm+1)
						strputint(gyouputima,nnmm)=strputint(gyouputima,nnmm+1)
					next
					strgyoumax(gyouputima)--:cslpos--
				} else {
					if strgyoumax(gyouputima)=0 and cslpos=0 and gyoumax>0 {
						for backgyou,gyouputima,gyoumax
							for backstr,0,strgyoumax(backgyou+1)
								strputp(backgyou,strgyoumax(backgyou)+backstr)=strputp(backgyou+1,backstr)
								strputint(backgyou,strgyoumax(backgyou)+backstr)=strputint(backgyou+1,backstr)
								strputp(backgyou+1,backstr)=nostr
								strputint(backgyou+1,backstr)=999		
							next
							strgyoumax(backgyou)=strgyoumax(backgyou+1)
							strgyoumax(backgyou+1)=0
						next
						gyoumax--
						if gyouputima>0:gyouputima--
						cslpos=strgyoumax(gyouputima)
					}
					if strgyoumax(gyouputima)>0 and cslpos=0 and gyouputima>0 and gyoumax>0 {
						for backgyou,gyouputima-1,gyoumax
							for backstr,0,strgyoumax(backgyou+1)
								strputp(backgyou,strgyoumax(backgyou)+backstr)=strputp(backgyou+1,backstr)
								strputint(backgyou,strgyoumax(backgyou)+backstr)=strputint(backgyou+1,backstr)
								strputp(backgyou+1,backstr)=nostr
								strputint(backgyou+1,backstr)=999		
							next
							strgyoumax(backgyou)=strgyoumax(backgyou)+strgyoumax(backgyou+1)
							strgyoumax(backgyou+1)=0
						next
						gyoumax--
						if gyouputima>0:gyouputima--
						cslpos=strgyoumax(gyouputima)
					}
				}
			}
			if tenkeyputn=3 {
				strpage++
				if strpage>2:strpage=0
			}
			if tenkeyputn=0 {
				if gyouputima=0 :cslpos=0
				if gyouputima>0 {
					gyouputima--
					if cslpos>strgyoumax(gyouputima):cslpos=strgyoumax(gyouputima)
				}
			}
			if tenkeyputn=2 {
				if gyouputima>2 :cslpos=strgyoumax(gyouputima)
				if gyouputima<2 {
					if mode1020=3:gyouputima++
					if cslpos>strgyoumax(gyouputima):cslpos=strgyoumax(gyouputima)
					if gyoumax<gyouputima:gyoumax=gyouputima
				}
			}
		}
	next



	font nostr,16,1
;strgyoumax(gyouputima)
	color 255,255,255
	boxf inputvarpx+3,inputvarpy+3,inputvarpx+inputvarketa*20,inputvarpy+20
	color 0,0,0
	if (cmx>strputpx) and (cmy>strputpy) and (cmy<512) {
		gyouputima=(cmy-strputpy)/20
		if gyouputima>gyoumax:gyouputima=gyoumax
		cslpos=strgyoumax(gyouputima)
	}
	for gyouput,0,gyoumax+1
		for nnmm,0,strgyoumax(gyouput)+1
			pos strputpx+nnmm*16,strputpy+gyouput*20
			mes strputp(gyouput,nnmm)
			if strselmode=1 {
				if strseln(gyouput,nnmm)=1 {
					pos strputpx+nnmm*16,strputpy+gyouput*20
					mes "＿"
				}
			}
			if cmx>strputpx+nnmm*16 and cmy>strputpy+gyouput*20 and cmx<strputpx+nnmm*16+16 and cmy<strputpy+gyouput*20+16 {
				cslpos=nnmm
				gyouputima=gyouput
			}
		;pos 0+nnmm*50,420
		;mes strputint(0,nnmm)
		next
	next

	
	pos 0,strputpy-40
	mes strgyoumax(gyouputima)
	mes cslpos
	pos strputpx+cslpos*16,strputpy+gyouputima*20
	if ptncnt>10 :mes "|"

	tenkeystrend=0

return 

*strputintset

	for aaa,0,36
		noteget bbb,aaa+1
		for ccc,0,15
			ddd=strmid(bbb,ccc*mbyte,mbyte)
			if ddd=strputp(gyouputima,nnmm) {
				strputint(gyouputima,nnmm)=aaa*15+ccc
				ccc=20
				aaa=40
			}
		next
	next
	if (aaa=36) and (ccc=15):strputint(gyouputima,nnmm)=9999

return

*varkeyput
	font nostr,20,1
	varkeyend=0
	gosub *tenkeywakuput
	imaketaget=inputvarn
	if imaketaget<0:imaketaget=-imaketaget
	imaketa=0
	while imaketaget>0:imaketa++:imaketaget=imaketaget/10:wend
	for tenkeyputn,0,12
		tenkeyx=(tenkeyputn\3)
		tenkeyy=(tenkeyputn/3)
		tenkeyputx=tenkeyx*64+96
		tenkeyputy=tenkeyy*64+512
		color 0,0,0
		notesel keystri
		noteget keystrput,tenkeyputn+1
		pos tenkeyputx+22,tenkeyputy+22
		mes keystrput
		if (tenkeyputx<tmx) and (tenkeyputy<tmy) and ((tenkeyputx+64)>tmx) and ((tenkeyputy+64)>tmy) {
			if ((tenkeyputn<9) or (tenkeyputn=10)) and (imaketa<inputvarketa) {
				varlrstr=str(inputvarn)
				varl=strmid(varlrstr,0,varputcsl)
				varr=strmid(varlrstr,varputcsl,imaketa-varputcsl)
				inputvarn=int(varl+keystrput+varr)
				varputcsl++
			}
		}
	next

	for tenkeyputn,0,8
		tenkeyx=(tenkeyputn/4)
		tenkeyy=(tenkeyputn\4)
		tenkeyputx=tenkeyx*256+32
		tenkeyputy=tenkeyy*64+512
		color 0,0,0
		notesel keystrii
		noteget keystrput,tenkeyputn
		pos tenkeyputx+2,tenkeyputy+22
		mes keystrput
		;color 255,255,255
		;boxf tenkeyputx+2,tenkeyputy+2,tenkeyputx+64-2,tenkeyputy+64-2
		if (tenkeyputx<tmx) and (tenkeyputy<tmy) and ((tenkeyputx+64)>tmx) and ((tenkeyputy+64)>tmy) {
			if tenkeyputn=0 {
				if inputvarn>0:varputcsl++
				if inputvarn<0:varputcsl--
				inputvarn=-inputvarn
			}
			if tenkeyputn=1 {
				varputcsl--
				if varputcsl<0:varputcsl=0
			}
			if tenkeyputn=5 {
				varputcsl++
				if varputcsl>(imaketa):varputcsl=imaketa
			}
			if tenkeyputn=4 {
				if (inputvarn>0) and (varputcsl>0) {
					varputcsl--
					varlrstr=str(inputvarn)
					varl=strmid(varlrstr,0,varputcsl)
					varr=strmid(varlrstr,varputcsl+1,imaketa-varputcsl-1)
					inputvarn=int(varl+varr)
				}
				if (inputvarn<0) and (varputcsl>0) {
					varputcsl--
					varlrstr=str(inputvarn)
					varl=strmid(varlrstr,0,varputcsl)
					varr=strmid(varlrstr,varputcsl+1,imaketa-varputcsl-1)
					inputvarn=int(varl+varr)
				}
			}
		}
		if (tenkeyputx<rmx) and (tenkeyputy<rmy) and ((tenkeyputx+64)>rmx) and ((tenkeyputy+64)>rmy) {
			if tenkeyputn=6 {
				varkeyend=2
			}
			if tenkeyputn=7 {
				varkeyend=1
				if inputvarmax<inputvarn:inputvarn=inputvarmax
				if -inputvarmax>inputvarn:inputvarn=-inputvarmax
			}

		}
	next

	color 255,255,255
	boxf inputvarpx+3,inputvarpy+3,inputvarpx+inputvarketa*20,inputvarpy+20
	color 0,0,0
	pos inputvarpx,inputvarpy
	mes inputvarn
	pos inputvarpx+varputcsl*10,inputvarpy
	if ptncnt>10:mes "|"

return 

