;読込
	
for no,0,32
	for hi,0,100
		filenm1=str(no)
		if no<10:filenm1="0"+filenm1
		filenm2=str(hi)
		if hi<10:filenm2="0"+filenm2
		exist folder+"editerstr/txd"+filenm1+filenm2+".txt"
		if strsize!-1 {
			notesel txd
			noteload folder+"editerstr/txd"+filenm1+filenm2+".txt"
			evinfo(no,hi)=txd
		}

	next
next

