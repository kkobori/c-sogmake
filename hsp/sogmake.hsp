		if fxyfxy=2 and henkouset=0:mapd(getdpfr-dmindanf,getmaedpx-dmindanx,getmaedpy-dmindany,maeget)=3:henkouset=1
		if fxyfxy=3 and henkouset=0:mapd(getdpfr-dmindanf,getmaedpx-dmindanx,getmaedpy-dmindany,maeget)=4:henkouset=1
