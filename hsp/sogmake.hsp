*mesdelete
	
	evedno=bbget(eved(eveno,seleveline,0),0,5)
	evinpline=strlen(evinp(evedno))/10
	sdim eld,2,evinpline,7
	for n,eldstartline,evinpline,1
		eld(n,0)=strmid(evinp(evedno),0+n*10,1);種類
		eld(n,1)=strmid(evinp(evedno),1+n*10,1);位置ｘ
		eld(n,2)=strmid(evinp(evedno),2+n*10,1);位置ｙ
		eld(n,3)=strmid(evinp(evedno),3+n*10,1);変数何番目か
		eld(n,4)=strmid(evinp(evedno),4+n*10,2);bitインデックス
		eld(n,5)=strmid(evinp(evedno),6+n*10,2);bit桁
		eld(n,6)=strmid(evinp(evedno),8+n*10,2);各パラメータ
	next
	
	for n,eldstartline,evinpline,1
	
		if eld(n,0)="2" and eld(n,1)="0" {
			n0=int(eld(n,3))
			;		6		0			8
			n1=eved(eveno,seleveline,n0)
			n2=int(eld(n,4))
			n3=int(eld(n,5))
			mesindex=bbget(n1,n2,n3)
			for nn,0,8,1
				messet(mesindex,nn)=0
			next
			messettxt(mesindex)=nostr
		}
	next
				
	max=0
	for n,65535,0,-1
		if messettxt(n)!nostr:max=n:n=-1
	next
	mesmax=max
	
return

