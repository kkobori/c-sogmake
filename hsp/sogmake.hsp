			;if eld(n,0)="e" {
			if eld(n,0)="4" {
				evinpline=n+1
				_break
			}
			if eld(n,0)="5" {
				mapnoput=bbget(eveinpset(n),0,8)
				xput=bbget(eveinpset(n),8,8)
				yput=bbget(eveinpset(n),16,8)
				color 0,0,0
				pos x+16+100,y
				notesel mapname
				noteget mapnmput,mapnoput
				mes mapnmput+" X:"+str(xput)+" Y:"+str(yput)
				color 0,0,0
				boxf x,y,x+80,y+30
				color 255,255,255
				boxf x+2,y+2,x+80-2,y+30-2
				color 0,0,0
				pos x+30,y
				mes "→"
				if (mode1020=0) and (x<rmx) and (y<rmy) and (x+80>rmx) and (y+30>rmy) {
					selmax=256
					notesel mapname
					returnmode=150
					canmode=mode
					listreturnid=1
					listseln=mapnoput
					mode=190
					mapselsetx=xput
					mapselsety=yput
					mapselsetfr=mapnoput
					tmx=-1
					tmy=-1
					eveinpsetno=n
					_break

				}
			}
			if eld(n,0)="6" {
				xput=bbget(eveinpset(n),0,8)
				yput=bbget(eveinpset(n),8,8)
				color 0,0,0
				pos x+16+100,y
				mes " X:"+str(xput)+" Y:"+str(yput)
				color 0,0,0
				boxf x,y,x+80,y+30
				color 255,255,255
				boxf x+2,y+2,x+80-2,y+30-2
				color 0,0,0
				pos x+30,y
				mes "→"
				if (mode1020=0) and (x<rmx) and (y<rmy) and (x+80>rmx) and (y+30>rmy) {
					evemode=2
					beforeix=ix
					beforeiy=iy
					beforefr=fr
					motofr=fr
					canmode=mode
					listreturnid=6
					;listseln=fr
					mode=150
					returnmode=0

					mapselsetx=xput
					mapselsety=yput
					mapselsetfr=fr
					tmx=-1
					tmy=-1
					eveinpsetno=n
					_break

				}
			}
			if eld(n,0)="7" {
				eveselnoput=bbget(eveinpset(n),0,10)
				color 0,0,0
				pos x+16+100,y
				mes "EVEN0:"+str(eveselnoput)
				color 0,0,0
				boxf x,y,x+80,y+30
				color 255,255,255
				boxf x+2,y+2,x+80-2,y+30-2
				color 0,0,0
				pos x+30,y
				mes "→"
				if (mode1020=0) and (x<rmx) and (y<rmy) and (x+80>rmx) and (y+30>rmy) {
					eveinpsetno=n
					eveselsetno=eveselnoput
					returnmode=mode
					mode=155
					evemode=3
					returneveno=eveno
					_break
				}
			}

			if eld(n,0)="8" {
				eveselnoput=bbget(eveinpset(n),0,8)
				pos x+16+100,y+16
				;mes "CHIPN0:"+str(eveselnoput)
				chrputno=(eveselnoput/64)*64+(eveselnoput\64)+64*3
				celput 1,chrputno,1.0,1.0,0
				color 0,0,0
				boxf x,y,x+80,y+30
				color 255,255,255
				boxf x+2,y+2,x+80-2,y+30-2
				color 0,0,0
				pos x+30,y
				mes "→"
				if (mode1020=0) and (x<rmx) and (y<rmy) and (x+80>rmx) and (y+30>rmy) {
					mchipselno=eveselnoput
					eveinpsetno=n
					mode1020=5
					mode=185
				}
			}
			
			if eld(n,0)="9" {
				eveselnoput=bbget(eveinpset(n),0,8)
				pos x+16+100,y+16
				;mes "CHIPN0:"+str(eveselnoput)
				chrputno=(eveselnoput/64)*512+(eveselnoput\64)+64*3+64*4
				celput 1,chrputno,1.0,1.0,0
				color 0,0,0
				boxf x,y,x+80,y+30
				color 255,255,255
				boxf x+2,y+2,x+80-2,y+30-2
				color 0,0,0
				pos x+30,y
				mes "→"
				if (mode1020=0) and (x<rmx) and (y<rmy) and (x+80>rmx) and (y+30>rmy) {
					chrselno=eveselnoput
					eveinpsetno=n
					mode1020=4
					mode=180
				}
			}

		next
				
		}
		
		color 0,0,0
		line 32,512,32+320,512
		
		if mode1020=2 {
			if varkeyend=10 {
				varputcsl=0
				varputget=inputvarn
				while varputget>0
					varputcsl++
					varputget=varputget/10
				wend
				inputvarketa=0
				varputget=inputvarmax
				while varputget>0
					inputvarketa++
					varputget=varputget/10
				wend
			}
			gosub *varkeyput
			if varkeyend=1 {
				mode1020=0
				eveinpset(inputmode)=inputvarn
			}
			if varkeyend=2 {
				mode1020=0
			}
		}
		if mode1020=3 {
			gosub *strkeyput
			if varkeyend=2 {
				mode1020=0
			}
		}
		
		ptncnt++
		if ptncnt>20:ptncnt=0		
	}

	if mode=1030 {
		gosub *evlineput
	}

	
				
;フロアデータ
;敵の出現パターン
;罠の種類(アイテムレベル5bit*3)
;つうはん(アイテムレベル5bit*3)
*mode_1040
	if mode=1040 {
		
		dim ebtnpos,15,5
		
		;敵の最大出現数
		for nn,0,8
			ebtnpos(nn,0)=350:ebtnpos(nn,1)=210+nn*34:ebtnpos(nn,2)=400:ebtnpos(nn,3)=1
		next
		;敵の出現カウンター
		ebtnpos(8,0)=240:ebtnpos(8,1)=120:ebtnpos(8,2)=320:ebtnpos(8,3)=1

		;罠レベル
		for nn,0,3
			ebtnpos(9+nn,0)=160+nn*60:ebtnpos(9+nn,1)=520:ebtnpos(9+nn,2)=160+50+nn*60:ebtnpos(9+nn,3)=1
		next
		;通販レベル
		for nn,0,3
			ebtnpos(12+nn,0)=160+nn*60:ebtnpos(12+nn,1)=580:ebtnpos(12+nn,2)=160+50+nn*60:ebtnpos(12+nn,3)=1
		next
		
		if mode1040=2 {
			if varkeyend=10 {
				varputcsl=0
				varputget=inputvarn
				while varputget>0
					varputcsl++
					varputget=varputget/10
				wend
				inputvarketa=0
				varputget=inputvarmax
				while varputget>0
					inputvarketa++
					varputget=varputget/10
				wend
			}
			gosub *varkeyput
			if varkeyend=1 {
				mode1040=0
				motomode=1041
				;itemd(itemsel,inputmode)=inputvarn
				
				if inputmode<9 {
					keta=3+(inputmode=8)*5
					if inputmode<8 {
						if inputvarn>6:inputvarn=6
						if inputvarn<1:inputvarn=1
					}
					msetd(fr,2)=bbins(inputvarn,keta,msetd(fr,2),inputmode*3)
				}

				if inputmode>8 {
					keta=5
					if inputvarn>31:inputvarn=31
					if inputvarn<0:inputvarn=0
					msetd(fr,3)=bbins(inputvarn,keta,msetd(fr,3),(inputmode-9)*5)
				}

			}
			if varkeyend=2 {
				mode1040=0
				motomode=1041
				;gosub *btnitem
			}
		}
		
		for nnnn,0,15
			if mode1040=0 and iepage=ebtnpos(nnnn,4) and (ebtnpos(nnnn,3)!9) {
				color 0,0,0
				boxf ebtnpos(nnnn,0),ebtnpos(nnnn,1),ebtnpos(nnnn,2),ebtnpos(nnnn,1)+30
				color 255,255,255
				boxf ebtnpos(nnnn,0)+2,ebtnpos(nnnn,1)+2,ebtnpos(nnnn,2)-2,ebtnpos(nnnn,1)+30-2
			}
			if (mode1040=0) and (iepage=ebtnpos(nnnn,4)) and (ebtnpos(nnnn,0)<rmx) and (ebtnpos(nnnn,1)<rmy) and (ebtnpos(nnnn,2)>rmx) and ((ebtnpos(nnnn,1)+30)>rmy) {
				;数値入力
				if ebtnpos(nnnn,3)=1 {
					clrobj
					
					if nnnn<8:inputvarn=bbget(msetd(fr,2),nnnn*3,3)
					if nnnn=8:inputvarn=bbget(msetd(fr,2),nnnn*3,8)
					if nnnn>8:inputvarn=bbget(msetd(fr,3),(nnnn-9)*5,5)
					inputvarpx=ebtnpos(nnnn,0)+16
					inputvarpy=ebtnpos(nnnn,1)
					inputvarmax=255
					;for ketamax,0,itemketa(nnnn)-1
					;	inputvarmax=inputvarmax*2
					;next
					;inputvarmax=inputvarmax-1
					inputmode=nnnn
					varkeyend=10
					mode1040=2
				}
			}
			tmx=-1
			tmy=-1
		
			if mode1040=0 {
				color 0,0,0
				pos ebtnpos(nnnn,0)+8,ebtnpos(nnnn,1)+4
				if nnnn<8:ddnn=bbget(msetd(fr,2),nnnn*3,3)
				if nnnn=8:ddnn=bbget(msetd(fr,2),nnnn*3,8)
				if nnnn>8:ddnn=bbget(msetd(fr,3),(nnnn-9)*5,5)
				mes ddnn
				color 255,255,255
			}
/*		
			if mode1040=2 and nnnn=inputmode {
				color 0,0,0
				pos ebtnpos(nnnn,0)+8,ebtnpos(nnnn,1)+4
				;ddnn=bbget(msetd(fr,2),nnnn*3,3)
				;if nnnn=8:ddnn=bbget(msetd(fr,2),nnnn*3,8)
				;mes inputvarn
				color 255,255,255
			}
*/
		next
		
		if mode1040=0 {
			color 0,0,0
			pos ebtnpos(9,0)-120,ebtnpos(9,1)+4
			mes "罠レベル"
			pos ebtnpos(12,0)-120,ebtnpos(12,1)+4
			mes "通販レベル"
			color 255,255,255
		}

	}


*mode_2000
				
	if mode>1999 and mode<2399 {
		if mode=2000 {
			;itemsel=listseln
			itemsel=itemsortid(listseln)
			listselnid=listseln
			notesel itemnmedite
			noteget inameimae,itemsortid(listseln)
			notesel itemnmedit
			noteget inameima,itemsortid(listseln)
		}

		for ppn,0,3
			ppxpx=ppn*32
			ppypy=760
			color 0,0,0
			boxf ppxpx,ppypy,ppxpx+32,ppypy+32
			color 255,255,255
			selline=(ppn=iepage)*3
			boxf ppxpx+2+selline,ppypy+2+selline,ppxpx+32-2-selline,ppypy+32-2-selline
			color 0,0,0				
			pos ppxpx+8,ppypy+4
			mes str(ppn)
			if rmx>ppxpx and rmy>ppypy and rmx<ppxpx+32 and rmy<ppypy+32 {
				iepage=ppn
				if ppn=0:mode=2000
				if ppn=1:mode=2100
				if ppn=2:mode=2200
				returnmode=5
				;if ppn=3:mode=2300
			}
		next
	}

	if mode=2000 {
		dim ebtnpos,100,5

		;ebtnpos(**,3)=0-文字入力 1=数値入力 2=リスト選択 3=チェックボックス
		ebtnpos(0,0)=280:ebtnpos(0,1)=760:ebtnpos(0,2)=370:ebtnpos(0,3)=1:ebtnpos(0,4)=0
		ebtnpos(1,0)=110:ebtnpos(1,1)=760:ebtnpos(1,2)=160:ebtnpos(1,3)=1:ebtnpos(1,4)=0
		ebtnpos(2,0)=170:ebtnpos(2,1)=760:ebtnpos(2,2)=220:ebtnpos(2,3)=1:ebtnpos(2,4)=0

		for nnnn,1,3
			color 0,0,0
			boxf ebtnpos(nnnn,0),ebtnpos(nnnn,1),ebtnpos(nnnn,2),ebtnpos(nnnn,1)+32
			color 255,255,255
			boxf ebtnpos(nnnn,0)+2,ebtnpos(nnnn,1)+2,ebtnpos(nnnn,2)-2,ebtnpos(nnnn,1)+32-2
			color 0,0,0
			pos ebtnpos(nnnn,0)+16,ebtnpos(nnnn,1)+4
			if nnnn=1:mes "↑"
			if nnnn=2:mes "↓"
			if (mode2000=0) and (ebtnpos(nnnn,0)<rmx) and (ebtnpos(nnnn,1)<rmy) and (ebtnpos(nnnn,2)>rmx) and ((ebtnpos(nnnn,1)+32)>rmy) {
				;itemmax
				;itemsel
				;selpage
				;itemnm(itemn,0-1)
				;itemd(itemn,0-49)
				if (nnnn=1) and (listselnid>0) {
					;並び順の値を入れ替える
					subdat=itemd(itemsortid(listselnid),90)
					itemd(itemsortid(listselnid),90)=itemd(itemsortid(listselnid-1),90)
					itemd(itemsortid(listselnid-1),90)=subdat
					;カーソルを一つ下げる
					listseln--
					listselnid=listseln
					selpage=listseln/64
					;各情報をセットする
					gosub *itemidset
				}
				if nnnn=2 and (listselnid<(itemmax-1)) {
					;並び順の値を入れ替える
					subdat=itemd(itemsortid(listselnid),90)
					itemd(itemsortid(listselnid),90)=itemd(itemsortid(listselnid+1),90)
					itemd(itemsortid(listselnid+1),90)=subdat
					;カーソルを一つ上げる
					listseln++
					listselnid=listseln
					selpage=listseln/64
					;各情報をセットする
					gosub *itemidset
				}
			}
		next

		nnnn=0
		color 0,0,0
		boxf ebtnpos(nnnn,0),ebtnpos(nnnn,1),ebtnpos(nnnn,2),ebtnpos(nnnn,1)+30
		color 255,255,255
		boxf ebtnpos(nnnn,0)+2,ebtnpos(nnnn,1)+2,ebtnpos(nnnn,2)-2,ebtnpos(nnnn,1)+30-2

		color 0,0,0
		pos ebtnpos(nnnn,0)+16,ebtnpos(nnnn,1)
		mes itemmax

		pos ebtnpos(nnnn,0)-50,ebtnpos(nnnn,1)
		mes"総数"

		if (mode2000=0) and (ebtnpos(nnnn,0)<rmx) and (ebtnpos(nnnn,1)<rmy) and (ebtnpos(nnnn,2)>rmx) and ((ebtnpos(nnnn,1)+30)>rmy) {
			inputvarn=itemmax
			inputvarpx=ebtnpos(nnnn,0)+16
			inputvarpy=ebtnpos(nnnn,1)
			inputvarmax=500
			mode2000=1
			varkeyend=10
			inputmode=10
		}
		
		if mode2000=1 {
			if inputmode=10 {
				varputcsl=0
				varputget=inputvarn
				while varputget>0
					varputcsl++
					varputget=varputget/10
				wend
				inputvarketa=0
				varputget=inputvarmax
				while varputget>0
					inputvarketa++
					varputget=varputget/10
				wend
			}
			gosub *varkeyput
			if varkeyend=1 {
				mode2000=0
				if itemmax>inputvarn {
					dialog "総数が減ります",3
					n=stat
					if n=6:itemmax=inputvarn
					if n=7:inputvarn=itemmax
				} else {
					if inputvarn>500:inputvarn=500
					itemmax=inputvarn
				}
				if itemmax=0:itemmax=1
				selmax=itemmax
				notesel itemnmedit
				returnmode=0
				canmode=0
				listreturnid=0
				listseln=itemsel
				tmx=-1
				tmy=-1
				iepage=0
				mode2000=0
				gosub *itemidset
			}
			if varkeyend=2 {
				mode2000=0
			}
		}

	}

*mode_2100
	if mode=2100 or mode=2200 {

		sdim selstrie,50,100
		selstrie(1)=spnmedit
		selstrie(2)="力\n敏捷\n技術\nカルマ\n知恵\n\nMAXHP\nMAXMP"
		selstrie(3)=spkoukanmset
		selstrie(6)=spkoukanmset
		selstrie(8)="単体\n全体\n本人"
		selstrie(9)="いつも\n移動中\n戦闘中\nｘ"
		selstrie(10)="使用者の\n受者の"
		selstrie(11)="攻撃力\n防御力\n力\n早さ\n器用さ\nカルマ\n魔力\nMAXHP\nMAXMP\nHP\nMP"
