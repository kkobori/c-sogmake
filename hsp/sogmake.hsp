		for nnnnnn,0,6,1
			eved(eveno,seleveline,nnnnnn)=0
		next
		eved(eveno,seleveline,0)=bbins(evedno,5,eved(eveno,seleveline,0),0)
		;eved(eveno,seleveline,0)=bbins(n,n1,eved(eveno,seleveline,0),5)
