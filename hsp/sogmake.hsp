return

*returnb02

	if mode1020=0 {

		mapsavecheck=1
		mode=1010
		evemescnt=0
		for n,0,evinpline,1
			;if eld(n,0)="i" or eld(n,0)="c" {
			if eld(n,0)="0" or eld(n,0)="1" or eld(n,0)="5" or eld(n,0)="6" or eld(n,0)="7" or eld(n,0)="8" or eld(n,0)="9" {
				n1=int(eld(n,5))
				n2=eved(eveno,seleveline,int(eld(n,3)))
				n3=int(eld(n,4))
				nn=bbins(eveinpset(n),n1,n2,n3)
				eved(eveno,seleveline,int(eld(n,3)))=nn
			}
			;if eld(n,0)="m" {
			if eld(n,0)="2" {
				evemes(pp)=nostr
				pp=evemescnt
				for gyouput,0,gyoumax+1
					for nnmm,0,strgyoumax(gyouput)+1
						;pos x+nnmm*16,y+gyouput*20
						;mes strputp(gyouput,nnmm)
						evemes(pp)=evemes(pp)+strputp(gyouput,nnmm)
					next
					if gyouput<gyoumax {
						if strgyoumax(gyouput+1)>0 {
							evemes(pp)=evemes(pp)+"＃Ｒ"
						}
					}
				next
				if (strgyoumax(0)=0) and (strgyoumax(1)=0) and (strgyoumax(2)=0):evemes(pp)=nostr
				if evemes(pp)!nostr {
					
					;strrep evemes(pp),"\n","＃Ｒ"

					n1=int(eld(n,5))
					n2=eved(eveno,seleveline,int(eld(n,3)))
					n3=int(eld(n,4))
				
					;インデックスNo.を決める
					nnn=0
					if mesmax>0 {
						nnn=0
						for mesindex,1,mesmax+1,1
							if messettxt(mesindex)=nostr:nnn=mesindex:_break
							;if messet(mesindex,0)=0:nnn=mesindex:_break
						next
					} else {
						nnn=0
					}

					
					
					if nnn=0:mesmax++:nnn=mesmax
					setd=bbins(nnn,n1,n2,n3)
					eved(eveno,seleveline,int(eld(n,3)))=setd
					mojisuu=strlen(evemes(pp))
					nnnnn=int(mojisuu/(mbyte*4))
					if (mojisuu\(mbyte*4))!0:nnnnn++
					messet(nnn,0)=nnnnn
					for nnnn,0,nnnnn,1
						;messet(nnn,nnnn+1)=strvar(strmid(evemes(pp),nnnn*(mbyte*4),(mbyte*4)))
						moji=strmid(evemes(pp),nnnn*(mbyte*4),(mbyte*4))
						gosub *strvargo
						messet(nnn,nnnn+1)=setg
					next
					messettxt(nnn)=evemes(pp)
				} else {
					n1=int(eld(n,5))
					n2=eved(eveno,seleveline,int(eld(n,3)))
					n3=int(eld(n,4))
					setd=bbins(0,n1,n2,n3)
					eved(eveno,seleveline,int(eld(n,3)))=setd
				}
				evemescnt++
			}
		next
	
		for nnn,0,evelimax,1
			n4=0
			for n,0,6,1
				if eved(eveno,nnn,n)!0:n4=n+1
			next
			nn=eved(eveno,nnn,0)
			eved(eveno,nnn,0)=bbins(n4,3,nn,5)
		next	

		max=0
		for n,65535,0,-1
			if messettxt(n)!nostr:max=n:n=-1
		next
		mesmax=max
	}

return

