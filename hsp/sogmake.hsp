*itemnmset

	for n,0,itemmax,1
		nnn=itemsortid(n)
		notesel itemnmedit
		noteadd itemnm(nnn,0),n,1
		notesel itemnmedite
		noteadd itemnm(nnn,1),n,1
		notesel itemnmeditplice
		noteadd str(itemd(nnn,41))+" "+itemnm(nnn,0)+" "+str(itemd(nnn,0)),n,1
	next

	evecomstr(3)=itemnmedit
	evecomstr(14)="なし\n"+itemnmedit
	evecomstr(57)="なし\n"+itemnmeditplice

return
		
*itemidset
	dim itemsortset,65536
	dim itemsortid,itemmax
	dim itemsortid2,itemmax;ID→並び順
	for n,0,itemmax,1
		;IDが０の場合はセットする
		if itemd(n,91)=0 {
			for idnnn,1,itemmax+1
				if itemidonoff(idnnn)=0:itemd(n,91)=idnnn:itemidonoff(idnnn)=1:idnnn=itemmax+10
			next
		}
		if itemd(n,91)!0:itemidonoff(itemd(n,91))=1
		;並び順が０の場合はセットする
		if itemd(n,90)=0:itemd(n,90)=itemd(n,91)*100
		itemsortset(itemd(n,90))=itemd(n,91)
	next
		
	itemsortcnt=0
	for n,0,65536
		if itemsortset(n)!0 {
			;並び順にIDをセットする
			itemsortid(itemsortcnt)=itemsortset(n)-1
			;IDに並び順をセットする
			itemsortid2(itemsortset(n)-1)=itemsortcnt
			itemsortcnt++
		}
	next
	
	gosub *itemnmset
		
return

*upi
	
	if itemsel>0 {
		dim subitemep,42
		for nnn,0,42
			subitemep(nnn)=itemd(itemsel,nnn)
		next
		for nnn,0,42
			itemd(itemsel,nnn)=itemd(itemsel-1,nnn)
		next
		for nnn,0,42
			itemd(itemsel-1,nnn)=subitemep(nnn)
		next
		for nnn,0,2,1
			subitenmn=itemnm(itemsel,nnn)
			itemnm(itemsel,nnn)=itemnm(itemsel-1,nnn)
			itemnm(itemsel-1,nnn)=subitenmn
		next
		itemsel--
		gosub *itemnmset
		objprm 0,itemnmedit
		motoitemnmjp=itemnmjp
		motoitemnmen=itemnmen

	}
	
return

*downi
	
	if itemsel<itemmax-1 {
		dim subitemep,42
		for nnn,0,42
			subitemep(nnn)=itemd(itemsel,nnn)
		next
		for nnn,0,42
			itemd(itemsel,nnn)=itemd(itemsel+1,nnn)
		next
		for nnn,0,42
			itemd(itemsel+1,nnn)=subitemep(nnn)
		next
		for nnn,0,2,1
			subitenmn=itemnm(itemsel,nnn)
			itemnm(itemsel,nnn)=itemnm(itemsel+1,nnn)
			itemnm(itemsel+1,nnn)=subitenmn
		next
		itemsel++
		gosub *itemnmset
		objprm 0,itemnmedit
		motoitemnmjp=itemnmjp
		motoitemnmen=itemnmen

	}

return

